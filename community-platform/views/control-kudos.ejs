<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Kudos • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control"><section class="topbar"><div><div class="crumb">Discord Control / Kudos & retention</div><h1>Kudos, recaps & progression</h1><p>Recognition is the one trader-adjacent feature: celebrate good calls without duplicating the EAFC.Live trading bot.</p></div></section><% if(saved){ %><div class="notice">Saved.</div><% } %>
<section class="grid two"><div class="panel"><div class="panel-head"><div><h2>7-day Kudos leaderboard</h2><p>Most recognised members this week.</p></div></div><% leaders.forEach((x,n)=>{ %><div class="kudos-rank"><b>#<%= n+1 %></b><span><strong><%= x.name %></strong><small>Recognition received</small></span><strong><%= x.value %></strong></div><% }) %></div><div class="panel"><div class="panel-head"><div><h2>30-day categories</h2><p>Which kinds of contributions are being recognised.</p></div></div><% categories.forEach(x=>{ %><div class="row"><span class="row-main"><strong><%= x.category %></strong></span><strong><%= x.value %></strong></div><% }) %></div></section>
<section class="grid two" style="margin-top:11px"><div class="panel"><div class="panel-head"><div><h2>Kudos milestones</h2><p>Badges, roles, XP and Live Coins at recognition milestones.</p></div></div><form method="post" action="/control/kudos/milestones" class="form-grid"><label>Kudos<input name="milestone" type="number" min="1" value="10"></label><label>Role<select name="roleId"><option value="">No role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>">@<%= r.name %></option><% }) %></select></label><label>XP<input name="xpReward" type="number" min="0" value="100"></label><label>Coins<input name="coinReward" type="number" min="0" value="100"></label><label class="wide">Badge key<input name="badgeKey" placeholder="kudos_10"></label><div class="wide"><button class="btn">Save milestone</button></div></form><div class="list" style="margin-top:8px"><% milestones.forEach(m=>{ %><div class="row"><span class="row-main"><strong><%= m.milestone %> kudos</strong><small><%= m.xp_reward %> XP • <%= m.coin_reward %> coins<%= m.role_id?' • role reward':'' %></small></span></div><% }) %></div></div>
<div class="panel"><div class="panel-head"><div><h2>Recognition roles</h2><p>Rotate visible recognition automatically.</p></div></div><form method="post" action="/control/kudos/recognition" class="form-grid"><label>Weekly recognition role<select name="weeklyRoleId"><option value="">None</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= recognition.weekly_role_id===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label><label>Season champion role<select name="seasonRoleId"><option value="">None</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= recognition.season_role_id===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label><div class="wide"><button class="btn">Save roles</button></div></form></div></section>
<section class="grid two" style="margin-top:11px"><div class="panel"><div class="panel-head"><div><h2>Weekly & monthly recaps</h2><p>Automatic community and personal summaries.</p></div></div><form method="post" action="/control/kudos/recaps" class="form-grid"><label><span>Weekly community recap</span><input type="checkbox" name="weeklyEnabled" <%= recaps.weekly_enabled?'checked':'' %>></label><label>Weekly channel<select name="weeklyChannelId"><option value="">None</option><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>" <%= recaps.weekly_channel_id===c.id?'selected':'' %>># <%= c.name %></option><% }) %></select></label><label>Day<select name="weeklyDay"><option value="0">Sunday</option><option value="1">Monday</option><option value="5">Friday</option></select></label><label>Hour (UTC)<input name="weeklyHour" type="number" min="0" max="23" value="<%= recaps.weekly_hour??19 %>"></label><label><span>Personal weekly DM</span><input type="checkbox" name="personalWeeklyEnabled" <%= recaps.personal_weekly_enabled?'checked':'' %>></label><label><span>Monthly server recap</span><input type="checkbox" name="monthlyEnabled" <%= recaps.monthly_enabled?'checked':'' %>></label><label class="wide">Monthly channel<select name="monthlyChannelId"><option value="">Use weekly channel</option><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>" <%= recaps.monthly_channel_id===c.id?'selected':'' %>># <%= c.name %></option><% }) %></select></label><div class="wide"><button class="btn">Save recap settings</button></div></form></div>
<div class="panel"><div class="panel-head"><div><h2>Level workflows</h2><p>Reward level milestones automatically.</p></div></div><form method="post" action="/control/kudos/level-workflow" class="form-grid"><label>Level<input name="level" type="number" min="1" value="5"></label><label>Role<select name="roleId"><option value="">No role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>">@<%= r.name %></option><% }) %></select></label><label>Coin reward<input name="coinReward" type="number" min="0" value="100"></label><label>Announcement channel<select name="channelId"><option value="">DM member</option><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>"># <%= c.name %></option><% }) %></select></label><label class="wide">Message<input name="message" value="🎉 {user} reached level {level}!"></label><div class="wide"><button class="btn">Save workflow</button></div></form><div class="list" style="margin-top:8px"><% workflows.forEach(w=>{ %><div class="row"><span class="row-main"><strong>Level <%= w.level %></strong><small><%= w.coin_reward %> coins<%= w.role_id?' • role':'' %></small></span></div><% }) %></div></div></section>
</main></body></html>