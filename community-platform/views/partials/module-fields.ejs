<% fields.forEach(field=>{ const value=current[field.key] ?? def.defaults[field.key]; %>
        <% if(field.type==='toggle'){ %>
          <label class="setting-card toggle-setting"><div><strong><%= field.label %></strong><small><%= field.help||'Turn this on to let the bot use this option.' %></small></div><input class="config-input" data-key="<%= field.key %>" data-type="boolean" type="checkbox" <%= value?'checked':'' %>></label>
        <% } else if(field.type==='number'){ %>
          <label class="setting-field"><span><%= field.label %></span><small><%= field.help||`Enter a value${field.min!==undefined?` from ${field.min}`:''}${field.max!==undefined?` to ${field.max}`:''}.` %></small><input class="config-input" data-key="<%= field.key %>" data-type="number" type="number" value="<%= value ?? 0 %>" <%= field.min!==undefined?`min="${field.min}"`:'' %> <%= field.max!==undefined?`max="${field.max}"`:'' %> <%= field.step!==undefined?`step="${field.step}"`:'' %>></label>
        <% } else if(field.type==='channel'){ %>
          <label class="setting-field"><span><%= field.label %></span><small><%= field.help||'Choose the Discord text channel where this feature should post.' %></small><select class="config-input" data-key="<%= field.key %>" data-type="string"><option value="">Choose a text channel</option><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>" <%= String(value||'')===c.id?'selected':'' %>># <%= c.name %></option><% }) %></select></label>
        <% } else if(field.type==='category'){ %>
          <label class="setting-field"><span><%= field.label %></span><small><%= field.help||'Choose where the bot should create private ticket channels.' %></small><select class="config-input" data-key="<%= field.key %>" data-type="string"><option value="">Choose a category</option><% channels.filter(c=>c.type===4).forEach(c=>{ %><option value="<%= c.id %>" <%= String(value||'')===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label>
        <% } else if(field.type==='role'){ %>
          <label class="setting-field"><span><%= field.label %></span><small><%= field.help||'Choose the Discord role this feature should use.' %></small><select class="config-input" data-key="<%= field.key %>" data-type="string"><option value="">Choose a role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= String(value||'')===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label>
        <% } else if(field.type==='roles'){ %>
          <label class="setting-field wide"><span><%= field.label %></span><small><%= field.help||'Select every Discord role that should be allowed to use this feature.' %></small><div class="check-picker config-input" data-key="<%= field.key %>" data-type="checkbox-array"><% roles.forEach(r=>{ %><label class="check-option"><input type="checkbox" value="<%= r.id %>" <%= Array.isArray(value)&&value.includes(r.id)?'checked':'' %>><span>@<%= r.name %></span></label><% }) %></div></label>
        <% } else if(field.type==='channels'){ %>
          <label class="setting-field wide"><span><%= field.label %></span><small><%= field.help||'Select the channels where this feature should not run.' %></small><div class="check-picker config-input" data-key="<%= field.key %>" data-type="checkbox-array"><% channels.filter(c=>c.type!==4).forEach(c=>{ %><label class="check-option"><input type="checkbox" value="<%= c.id %>" <%= Array.isArray(value)&&value.includes(c.id)?'checked':'' %>><span># <%= c.name %></span></label><% }) %></div></label>
        <% } else if(field.type==='select'){ %>
          <label class="setting-field"><span><%= field.label %></span><small><%= field.help||'Choose how the bot should handle this feature.' %></small><select class="config-input" data-key="<%= field.key %>" data-type="string"><% (field.options||[]).forEach(o=>{ %><option value="<%= o.value %>" <%= String(value)===o.value?'selected':'' %>><%= o.label %></option><% }) %></select></label>
        <% } else if(field.type==='textarea'){ %>
          <label class="setting-field wide"><span><%= field.label %></span><small><%= field.help||'Write the message members will see.' %></small><textarea class="config-input" data-key="<%= field.key %>" data-type="string" rows="4" placeholder="<%= field.placeholder||'' %>"><%= value||'' %></textarea></label>
        <% } else if(field.type==='list'){ %>
          <label class="setting-field wide"><span><%= field.label %></span><small>One per line.</small><textarea class="config-input" data-key="<%= field.key %>" data-type="array-lines" rows="5" placeholder="<%= field.placeholder||'One item per line' %>"><%= Array.isArray(value)?value.join('\n'):'' %></textarea></label>
        <% } else if(field.type==='ticketPanels'){ const panels=Array.isArray(value)?value:[]; %>
          <div class="setting-field wide"><div class="field-heading"><div><span><%= field.label %></span><% if(field.help){ %><small><%= field.help %></small><% } %></div><button type="button" class="ghost mini" id="add-ticket-panel">+ Add panel</button></div><div id="ticket-panels" class="repeater config-input" data-key="<%= field.key %>" data-type="ticket-panels"><% panels.forEach((p,idx)=>{ %><div class="repeater-row ticket-panel-row"><div class="row-head"><strong>Panel <span class="row-number"><%= idx+1 %></span></strong><button type="button" class="danger mini remove-row">Remove</button></div><label class="toggle-row"><div><strong>Enabled</strong><small>Publish this panel when saving.</small></div><input class="tp-enabled" type="checkbox" <%= p.enabled!==false?'checked':'' %>></label><div class="form-grid"><label>Panel ID<input class="tp-id" value="<%= p.id||'' %>" placeholder="applications"></label><label>Panel name<input class="tp-name" value="<%= p.name||'' %>" placeholder="Staff Applications"></label><label>Post panel into<select class="tp-channel"><option value="">Choose channel</option><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>" <%= String(p.panelChannelId||'')===c.id?'selected':'' %>># <%= c.name %></option><% }) %></select></label><label>Ticket category<select class="tp-category"><option value="">Choose category</option><% channels.filter(c=>c.type===4).forEach(c=>{ %><option value="<%= c.id %>" <%= String(p.categoryId||'')===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label></div><label><span>Dropdown options</span><small>One per line.</small><textarea class="tp-types" rows="4" placeholder="Support&#10;Question&#10;Other"><%= Array.isArray(p.types)?p.types.join('\n'):'' %></textarea></label><div><span>Ticket staff</span><div class="check-picker"><% roles.forEach(r=>{ %><label class="check-option"><input class="tp-staff" type="checkbox" value="<%= r.id %>" <%= Array.isArray(p.staffRoleIds)&&p.staffRoleIds.includes(r.id)?'checked':'' %>><span>@<%= r.name %></span></label><% }) %></div></div></div><% }) %></div></div>
        <% } else if(field.type==='roleGroups'){ const groups=Array.isArray(value)?value:[]; %>
          <div class="setting-field wide"><div class="field-heading"><div><span><%= field.label %></span><% if(field.help){ %><small><%= field.help %></small><% } %></div><button type="button" class="ghost mini" id="add-role-group">+ Add a role group</button></div><div class="role-group-instructions"><b>What’s a group?</b> It’s one set of choices on your menu. For example, members might choose one platform, then pick several interests.</div><div id="role-groups" class="repeater config-input" data-key="<%= field.key %>" data-type="role-groups"><% if(!groups.length){ %><div class="role-group-empty"><strong>You haven’t added any groups yet.</strong><span>Click “Add a role group” to start. You can add as many as you need.</span></div><% } %><% groups.forEach((g,idx)=>{ %><div class="repeater-row role-group-row"><div class="row-head"><strong>Group <span class="row-number"><%= idx+1 %></span><%= g.name?' · '+g.name:'' %></strong><button type="button" class="danger mini remove-row">Remove group</button></div><div class="form-grid"><label>Name shown to members<small>Example: Platform or Interests.</small><input class="rg-name" value="<%= g.name||'' %>" placeholder="For example, Platform"></label><label>How many roles can they pick?<small>Choose one, or let them choose several.</small><select class="rg-max"><option value="1" <%= Number(g.maxSelect||1)===1?'selected':'' %>>One role only</option><option value="99" <%= Number(g.maxSelect||1)>1?'selected':'' %>>As many as they want</option></select></label></div><div class="role-picker-label"><strong>Which roles can members choose?</strong><small>Tick each Discord role you want in this group.</small></div><% if(roles.length){ %><div class="check-picker"><% roles.forEach(r=>{ %><label class="check-option"><input class="rg-role" type="checkbox" value="<%= r.id %>" <%= Array.isArray(g.roleIds)&&g.roleIds.includes(r.id)?'checked':'' %>><span>@<%= r.name %></span></label><% }) %></div><% }else{ %><div class="role-group-empty compact-empty">No Discord roles were found. Add roles in your server settings, then reload this page.</div><% } %></div><% }) %></div></div>
        <% } else if(field.type==='rewards'){ const rewards=Array.isArray(value)?value:[]; %>
          <div class="setting-field wide"><div class="field-heading"><div><span><%= field.label %></span><small>Choose how much XP is needed and which role members unlock.</small></div><button type="button" class="ghost mini" id="add-reward">+ Add reward</button></div><div id="reward-rows" class="repeater config-input" data-key="<%= field.key %>" data-type="rewards"><% rewards.forEach((reward,idx)=>{ %><div class="repeater-row reward-row"><div class="row-head"><strong>Reward <span class="row-number"><%= idx+1 %></span></strong><button type="button" class="danger mini remove-row">Remove</button></div><div class="form-grid"><label>XP<input class="reward-xp" type="number" min="0" value="<%= reward.xp||0 %>"></label><label>Role<select class="reward-role"><option value="">Choose role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= String(reward.roleId||'')===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label></div></div><% }) %></div></div>
        <% } else if(def.key==='server_branding' && field.key==='logoUrl'){ %>
          <label class="setting-field"><span><%= field.label %></span><% if(field.help){ %><small><%= field.help %></small><% } %><input class="config-input" data-key="<%= field.key %>" data-type="string" type="text" value="<%= value||'' %>" placeholder="<%= field.placeholder||'' %>"><% if(typeof discordIconUrl !== 'undefined' && discordIconUrl){ %><button type="button" class="ghost mini" id="use-discord-icon" data-url="<%= discordIconUrl %>">Use Discord server icon</button><% } %></label>
        <% } else { %>
          <label class="setting-field"><span><%= field.label %></span><% if(field.help){ %><small><%= field.help %></small><% } %><input class="config-input" data-key="<%= field.key %>" data-type="string" type="text" value="<%= value||'' %>" placeholder="<%= field.placeholder||'' %>"></label>
        <% } %>

<% }) %>
