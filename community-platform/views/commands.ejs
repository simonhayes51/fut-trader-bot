<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Commands • FC27 Control</title><link rel="stylesheet" href="/style.css"></head><body><aside class="sidebar"><a class="brand" href="/dashboard"><span>FC27</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/setup">Setup wizard</a><a href="/members">Members</a><a href="/analytics">Analytics</a><a class="active" href="/commands">Commands</a><a href="/automation">Automation</a></nav></aside><main class="content"><header><div><div class="eyebrow">COMMAND MANAGER</div><h1>Who can use what?</h1><p class="muted">Turn commands on/off, make them Premium-only, or restrict them to roles and channels.</p></div></header><div class="command-grid"><% names.forEach(name=>{ const s=settings.get(name)||{enabled:true,role_ids:[],channel_ids:[],premium_only:false}; %><form class="panel command-card" method="post" action="/commands/<%= encodeURIComponent(name) %>"><div class="module-top"><h2><%= name.includes(' ')?name:'/'+name %></h2><label class="switch-line">Enabled <input type="checkbox" name="enabled" <%= s.enabled?'checked':'' %>></label></div><label class="toggle-row mini-toggle"><span>Premium only</span><input type="checkbox" name="premiumOnly" <%= s.premium_only?'checked':'' %>></label><details><summary>Restrict roles</summary><div class="check-picker"><% roles.forEach(r=>{ %><label class="check-option"><input type="checkbox" name="roles" value="<%= r.id %>" <%= (s.role_ids||[]).includes(r.id)?'checked':'' %>><span>@<%= r.name %></span></label><% }) %></div></details><details><summary>Restrict channels</summary><div class="check-picker"><% channels.filter(c=>c.type!==4).forEach(c=>{ %><label class="check-option"><input type="checkbox" name="channels" value="<%= c.id %>" <%= (s.channel_ids||[]).includes(c.id)?'checked':'' %>><span># <%= c.name %></span></label><% }) %></div></details><button class="ghost full">Save command</button></form><% }) %></div></main></body></html>