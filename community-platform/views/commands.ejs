<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Commands • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/polish.css"></head><body><aside class="sidebar"></aside><main class="content saas-page">
<% const enabledCount=names.filter(name=>(settings.get(name)||{enabled:true}).enabled!==false).length; const premiumCount=names.filter(name=>Boolean(settings.get(name)?.premium_only)).length; const restrictedCount=names.filter(name=>{const s=settings.get(name)||{};return (s.role_ids||[]).length+(s.channel_ids||[]).length>0;}).length; %>
<section class="page-hero compact"><div><div class="eyebrow">SYSTEM / COMMANDS</div><h1>Command access</h1><p>Control exactly where commands work, who can use them and which experiences require Premium.</p></div><div class="hero-actions"><a class="ghost" href="/setup">System health</a></div></section>
<section class="stats compact-stats"><div class="stat"><span>Total commands</span><strong><%= names.length %></strong></div><div class="stat"><span>Enabled</span><strong><%= enabledCount %></strong></div><div class="stat"><span>Premium only</span><strong><%= premiumCount %></strong></div><div class="stat"><span>Restricted</span><strong><%= restrictedCount %></strong></div></section>
<section class="panel slim-callout"><span class="ops-dot good"></span><div><strong>Least privilege by design</strong><small>Leave roles and channels empty for open access. Add restrictions only where the community experience needs them.</small></div></section>
<div class="command-grid saas-command-grid"><% names.forEach(name=>{ const s=settings.get(name)||{enabled:true,role_ids:[],channel_ids:[],premium_only:false}; const restricted=(s.role_ids||[]).length+(s.channel_ids||[]).length; %><form class="panel command-card compact-command-card" method="post" action="/commands/<%= encodeURIComponent(name) %>"><div class="command-head"><div><span class="command-kicker">DISCORD COMMAND</span><h2><%= name.includes(' ')?name:'/'+name %></h2><small><%= restricted?(restricted+' access restriction'+(restricted===1?'':'s')):'Available wherever Discord allows it' %></small></div><label class="switch-line"><span><%= s.enabled?'On':'Off' %></span><input type="checkbox" name="enabled" <%= s.enabled?'checked':'' %>></label></div><div class="command-options"><label class="toggle-row mini-toggle"><span>Premium only</span><input type="checkbox" name="premiumOnly" <%= s.premium_only?'checked':'' %>></label><details><summary><%= (s.role_ids||[]).length?((s.role_ids||[]).length+' role'+((s.role_ids||[]).length===1?'':'s')):'Roles' %></summary><div class="check-picker"><% roles.forEach(r=>{ %><label class="check-option"><input type="checkbox" name="roles" value="<%= r.id %>" <%= (s.role_ids||[]).includes(r.id)?'checked':'' %>><span>@<%= r.name %></span></label><% }) %></div></details><details><summary><%= (s.channel_ids||[]).length?((s.channel_ids||[]).length+' channel'+((s.channel_ids||[]).length===1?'':'s')):'Channels' %></summary><div class="check-picker"><% channels.filter(c=>c.type!==4).forEach(c=>{ %><label class="check-option"><input type="checkbox" name="channels" value="<%= c.id %>" <%= (s.channel_ids||[]).includes(c.id)?'checked':'' %>><span># <%= c.name %></span></label><% }) %></div></details></div><button class="button compact-save">Save access policy</button></form><% }) %></div>
</main></body></html>