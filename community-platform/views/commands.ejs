<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Commands • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"></head><body><aside class="sidebar"><a class="brand" href="/dashboard"><span>EAFC.Live</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/setup">Setup</a><a href="/members">Members</a><a href="/analytics">Analytics</a><a class="active" href="/commands">Commands</a><a href="/automation">Automation</a></nav></aside><main class="content"><header><div><div class="eyebrow">COMMANDS</div><h1>Command access</h1></div></header><div class="command-grid compact-command-grid"><% names.forEach(name=>{ const s=settings.get(name)||{enabled:true,role_ids:[],channel_ids:[],premium_only:false}; const restricted=(s.role_ids||[]).length+(s.channel_ids||[]).length; %><form class="panel command-card compact-command-card" method="post" action="/commands/<%= encodeURIComponent(name) %>"><div class="command-head"><div><h2><%= name.includes(' ')?name:'/'+name %></h2><small><%= restricted?`${restricted} restriction${restricted===1?'':'s'}`:'No restrictions' %></small></div><label class="switch-line"><span>On</span><input type="checkbox" name="enabled" <%= s.enabled?'checked':'' %>></label></div><div class="command-options"><label class="toggle-row mini-toggle"><span>Premium only</span><input type="checkbox" name="premiumOnly" <%= s.premium_only?'checked':'' %>></label><details><summary>Roles</summary><div class="check-picker"><% roles.forEach(r=>{ %><label class="check-option"><input type="checkbox" name="roles" value="<%= r.id %>" <%= (s.role_ids||[]).includes(r.id)?'checked':'' %>><span>@<%= r.name %></span></label><% }) %></div></details><details><summary>Channels</summary><div class="check-picker"><% channels.filter(c=>c.type!==4).forEach(c=>{ %><label class="check-option"><input type="checkbox" name="channels" value="<%= c.id %>" <%= (s.channel_ids||[]).includes(c.id)?'checked':'' %>><span># <%= c.name %></span></label><% }) %></div></details></div><button class="ghost compact-save">Save</button></form><% }) %></div></main></body></html>