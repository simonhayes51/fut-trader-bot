<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Moderation • FC27 Control</title><link rel="stylesheet" href="/style.css"></head><body>
<aside class="sidebar"><a class="brand" href="/dashboard"><span>FC27</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/trading">Trade calls</a><a href="/tickets">Tickets</a><a href="/social">Social feeds</a><a class="active" href="/moderation">Moderation</a><a href="/audit">Audit log</a></nav></aside>
<main class="content"><header><div><div class="eyebrow">SAFETY & MODERATION</div><h1>Moderation</h1><p class="muted">Recent warnings and automated moderation actions.</p></div></header>
<div class="two-col"><section class="panel"><h2>Warnings</h2><div class="feed-list"><% warnings.forEach(w=>{ %><div><strong><%= w.reason %></strong><small>User <%= w.user_id %> • Mod <%= w.moderator_id %> • <%= new Date(w.created_at).toLocaleString('en-GB') %></small></div><% }) %><% if(!warnings.length){ %><p class="muted">No warnings.</p><% } %></div></section>
<section class="panel"><h2>Recent moderation activity</h2><div class="feed-list"><% auditRows.filter(a=>String(a.action).includes('moderation')||String(a.action).includes('automod')).forEach(a=>{ %><div><strong><%= a.action %></strong><small><%= JSON.stringify(a.details) %> • <%= new Date(a.created_at).toLocaleString('en-GB') %></small></div><% }) %></div></section></div>
</main></body></html>
