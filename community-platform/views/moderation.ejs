<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Moderation • FC27 Control</title><link rel="stylesheet" href="/style.css"></head><body>
<aside class="sidebar"><a class="brand" href="/dashboard"><span>FC27</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/trading">Trade calls</a><a href="/tickets">Tickets</a><a href="/social">Social feeds</a><a href="/billing">Premium & billing</a><a class="active" href="/moderation">Moderation</a><a href="/audit">Audit log</a></nav></aside>
<main class="content"><header><div><div class="eyebrow">SAFETY & MODERATION</div><h1>Moderation</h1><p class="muted">See what the bot has done and change safety settings without touching IDs or config.</p></div><div class="actions"><a class="ghost" href="/modules/automod">Configure automod</a><a class="button" href="/modules/mod_tools">Configure staff tools</a></div></header>
<div class="choice-cards" style="margin-bottom:18px"><a class="choice-card" href="/modules/automod"><strong>Automod & anti-scam</strong><span class="muted">Invite blocking, spam limits, blocked websites, timeouts and logs.</span></a><a class="choice-card" href="/modules/mod_tools"><strong>Staff permissions</strong><span class="muted">Pick which Discord roles can moderate and where actions are logged.</span></a><a class="choice-card" href="/modules/join_security"><strong>Join security</strong><span class="muted">Young-account warnings and raid alerts.</span></a></div>
<div class="two-col"><section class="panel"><h2>Warnings</h2><div class="feed-list"><% warnings.forEach(w=>{ %><div><strong><%= w.reason %></strong><small>Member <%= w.user_id %> • Staff <%= w.moderator_id %> • <%= new Date(w.created_at).toLocaleString('en-GB') %></small></div><% }) %><% if(!warnings.length){ %><p class="muted">No warnings. Nice and quiet.</p><% } %></div></section>
<section class="panel"><h2>Recent automated actions</h2><div class="feed-list"><% const rows=auditRows.filter(a=>String(a.action).includes('moderation')||String(a.action).includes('automod')); rows.forEach(a=>{ %><div><strong><%= String(a.action).replaceAll('.',' › ') %></strong><small><%= new Date(a.created_at).toLocaleString('en-GB') %></small></div><% }) %><% if(!rows.length){ %><p class="muted">No automated moderation actions yet.</p><% } %></div></section></div>
</main></body></html>
