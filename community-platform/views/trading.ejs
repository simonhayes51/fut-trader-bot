<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Trade calls • FC27 Control</title><link rel="stylesheet" href="/style.css"></head><body>
<aside class="sidebar"><a class="brand" href="/dashboard"><span>FC27</span> Control</a><nav><a href="/dashboard">Overview</a><a class="active" href="/trading">Trade calls</a><a href="/tickets">Tickets</a><a href="/social">Social feeds</a><a href="/moderation">Moderation</a><a href="/audit">Audit log</a></nav></aside>
<main class="content"><header><div><div class="eyebrow">TRADER ACCOUNTABILITY</div><h1>Trade calls</h1><p class="muted">Review every structured call and correct/close outcomes from the dashboard.</p></div></header>
<div class="table-wrap"><table><thead><tr><th>ID</th><th>Trader</th><th>Player</th><th>Buy</th><th>Target</th><th>Status</th><th>Created</th><th>Update</th></tr></thead><tbody>
<% calls.forEach(c=>{ %><tr><td>#<%= c.id %></td><td><code><%= c.user_id %></code></td><td><strong><%= c.player %></strong><small class="block"><%= c.reason||'' %></small></td><td><%= Number(c.buy_price||0).toLocaleString() %></td><td><%= Number(c.target_price||0).toLocaleString() %></td><td><span class="pill <%= c.status==='LIVE'?'on':'' %>"><%= c.status %></span></td><td><%= new Date(c.created_at).toLocaleString('en-GB') %></td><td><form method="post" action="/trading/<%= c.id %>/status" class="inline"><select name="status"><% ['LIVE','HIT','PROFIT','MISS','EXPIRED'].forEach(s=>{ %><option <%= c.status===s?'selected':'' %>><%= s %></option><% }) %></select><button class="ghost">Save</button></form></td></tr><% }) %>
<% if(!calls.length){ %><tr><td colspan="8" class="empty">No calls yet.</td></tr><% } %>
</tbody></table></div></main></body></html>
