<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Trade calls • FC27 Control</title><link rel="stylesheet" href="/style.css"></head><body>
<aside class="sidebar"><a class="brand" href="/dashboard"><span>FC27</span> Control</a><nav><a href="/dashboard">Overview</a><a class="active" href="/trading">Trade calls</a><a href="/tickets">Tickets</a><a href="/social">Social feeds</a><a href="/billing">Premium & billing</a><a href="/moderation">Moderation</a><a href="/audit">Audit log</a></nav></aside>
<main class="content"><header><div><div class="eyebrow">TRADING</div><h1>Trade calls</h1><p class="muted">Review live calls and update results.</p></div><a class="button" href="/modules/trade_calls">Configure trade calls</a></header>
<div class="hint-box" style="margin-bottom:16px">Need to change the trade channel, who can post, discussion threads or reason requirements? Use <strong>Configure trade calls</strong>. No IDs or code needed.</div>
<div class="table-wrap"><table><thead><tr><th>Call</th><th>Trader ID</th><th>Player</th><th>Buy</th><th>Target</th><th>Status</th><th>Posted</th><th>Change result</th></tr></thead><tbody>
<% calls.forEach(c=>{ %><tr><td>#<%= c.id %></td><td><code><%= c.user_id %></code></td><td><strong><%= c.player %></strong><small class="block"><%= c.reason||'' %></small></td><td><%= Number(c.buy_price||0).toLocaleString() %></td><td><%= Number(c.target_price||0).toLocaleString() %></td><td><span class="pill <%= c.status==='LIVE'?'on':'' %>"><%= c.status %></span></td><td><%= new Date(c.created_at).toLocaleString('en-GB') %></td><td><form method="post" action="/trading/<%= c.id %>/status" class="inline"><select name="status"><% [['LIVE','Live'],['HIT','Hit target'],['PROFIT','Profit'],['MISS','Miss'],['EXPIRED','Expired']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= c.status===value?'selected':'' %>><%= label %></option><% }) %></select><button class="ghost">Save</button></form></td></tr><% }) %>
<% if(!calls.length){ %><tr><td colspan="8" class="empty">No trade calls yet.</td></tr><% } %>
</tbody></table></div></main></body></html>
