<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Trade calls • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/polish.css"></head><body><aside class="sidebar"></aside><main class="content saas-page">
<% const live=calls.filter(c=>c.status==='LIVE').length; const hit=calls.filter(c=>['HIT','PROFIT'].includes(c.status)).length; const misses=calls.filter(c=>c.status==='MISS').length; const closed=calls.filter(c=>c.status!=='LIVE').length; const rate=closed?Math.round(hit/closed*100):0; %>
<section class="page-hero compact"><div><div class="eyebrow">COMMUNITY / TRADING</div><h1>Trade operations</h1><p>Monitor every call, keep outcomes clean and protect the public track record.</p></div><div class="hero-actions"><a class="ghost" href="/analytics">Trading analytics</a><a class="button" href="/modules/trade_calls">Configure trade calls</a></div></section>
<section class="stats compact-stats"><div class="stat"><span>Total calls</span><strong><%= calls.length %></strong></div><div class="stat"><span>Live now</span><strong><%= live %></strong></div><div class="stat"><span>Successful</span><strong><%= hit %></strong></div><div class="stat"><span>Misses</span><strong><%= misses %></strong></div><div class="stat"><span>Closed hit rate</span><strong><%= rate %>%</strong></div></section>
<section class="panel slim-callout"><span class="ops-dot good"></span><div><strong>Public record discipline</strong><small>Close calls with the correct outcome. Member reputation and future analytics use this data.</small></div></section>
<section class="section"><div class="section-head"><div><h2>Call ledger</h2><p>Newest calls first. Update status without leaving the control centre.</p></div><span class="table-count"><%= calls.length %> records</span></div><div class="table-wrap saas-table"><table><thead><tr><th>Call</th><th>Player</th><th>Buy</th><th>Target</th><th>Status</th><th>Trader</th><th>Posted</th><th>Outcome</th></tr></thead><tbody>
<% calls.forEach(c=>{ %><tr><td><strong>#<%= c.id %></strong></td><td><strong><%= c.player %></strong><small class="block"><%= c.reason||'No thesis supplied' %></small></td><td><%= Number(c.buy_price||0).toLocaleString() %></td><td><%= Number(c.target_price||0).toLocaleString() %></td><td><span class="pill <%= ['HIT','PROFIT'].includes(c.status)?'on':c.status==='MISS'?'off':'' %>"><%= c.status %></span></td><td><a href="/members/<%= c.user_id %>"><code><%= c.user_id %></code></a></td><td><%= new Date(c.created_at).toLocaleString('en-GB') %></td><td><form method="post" action="/trading/<%= c.id %>/status" class="inline outcome-control"><select name="status"><% [['LIVE','Live'],['HIT','Hit target'],['PROFIT','Profit'],['MISS','Miss'],['EXPIRED','Expired']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= c.status===value?'selected':'' %>><%= label %></option><% }) %></select><button class="ghost mini">Save</button></form></td></tr><% }) %>
<% if(!calls.length){ %><tr><td colspan="8" class="empty">No trade calls yet.</td></tr><% } %></tbody></table></div></section>
</main></body></html>