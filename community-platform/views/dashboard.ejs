<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard • FC27 Control</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/polish.css"></head><body><aside class="sidebar"><a class="brand" href="/dashboard"><span>FC27</span> Control</a><nav><a class="active" href="/dashboard">Overview</a><a href="/setup">Setup</a><a href="/members">Members</a><a href="/analytics">Analytics</a><a href="/commands">Commands</a><a href="/automation">Automation</a><a href="/discord">Discord</a><a href="/trading">Trade calls</a><a href="/tickets">Tickets</a><a href="/social">Social feeds</a><a href="/billing">Premium</a><a href="/moderation">Moderation</a><a href="/audit">Audit log</a></nav><div class="sidebar-user"><strong><%= user.username %></strong><small>Administrator</small></div><form method="post" action="/logout"><button class="ghost full">Log out</button></form></aside><main class="content"><header><div><div class="eyebrow">FC27 CONTROL</div><h1><%= guild?.name || 'FC27 Server' %></h1></div><div class="status"><span class="dot"></span> Online</div></header><section class="stats compact-stats"><div class="stat"><span>Members</span><strong><%= stats.members_tracked || 0 %></strong></div><div class="stat"><span>Premium</span><strong><%= stats.premium_members || 0 %></strong></div><div class="stat"><span>Trade calls</span><strong><%= stats.trade_calls || 0 %></strong></div><div class="stat"><span>Tickets</span><strong><%= stats.open_tickets || 0 %></strong></div><div class="stat"><span>Feeds</span><strong><%= stats.active_feeds || 0 %></strong></div><div class="stat"><span>Warnings</span><strong><%= stats.warnings || 0 %></strong></div></section><section class="section quick-section"><div class="section-head"><h2>Quick access</h2></div><div class="quick-grid"><a class="quick-card" href="/setup"><strong>Setup</strong><span>Health & server setup</span></a><a class="quick-card" href="/members"><strong>Members</strong><span>Profiles & access</span></a><a class="quick-card" href="/commands"><strong>Commands</strong><span>Permissions & access</span></a><a class="quick-card" href="/automation"><strong>Automation</strong><span>Posts & giveaways</span></a><a class="quick-card" href="/discord"><strong>Discord</strong><span>Forums, polls & events</span></a><a class="quick-card" href="/billing"><strong>Premium</strong><span>Plans & referrals</span></a></div></section><% for (const category of ['Community','Trading','Moderation','Automation','Social','Billing']) { const categoryModules=modules.filter(m=>m.category===category); if(!categoryModules.length) continue; %><section class="section"><div class="section-head"><h2><%= category %></h2><% if(category==='Billing'){ %><a class="text-link" href="/billing">Billing control →</a><% } %></div><div class="module-grid compact-modules"><% categoryModules.forEach(m=>{ const saved=moduleSettings.get(m.key); const enabled=saved ? saved.enabled : true; %><a class="module-card" href="/modules/<%= m.key %>"><div class="module-top"><h3><%= m.name %></h3><span class="pill <%= enabled?'on':'off' %>"><%= enabled?'On':'Off' %></span></div><p><%= m.description %></p></a><% }) %></div></section><% } %></main></body></html>