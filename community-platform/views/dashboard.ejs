<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/polish.css"></head><body>
<aside class="sidebar"></aside>
<main class="content">
<section class="saas-hero">
  <div>
    <div class="eyebrow">EAFC.LIVE COMMUNITY OS</div>
    <h1><%= guild?.name || 'EAFC.Live' %></h1>
    <p>One control centre for your members, subscriptions, rewards economy, trading activity, moderation and community automation.</p>
    <div class="hero-actions">
      <a class="button" href="/economy">Manage economy</a>
      <a class="ghost" href="/members">View members</a>
      <a class="ghost" href="/billing">Premium & billing</a>
    </div>
  </div>
  <div class="hero-side">
    <div class="hero-metric"><span>7 day active</span><strong><%= Number(stats.active_7d||0).toLocaleString('en-GB') %></strong></div>
    <div class="hero-metric"><span>Premium members</span><strong><%= Number(stats.premium_members||0).toLocaleString('en-GB') %></strong></div>
    <div class="hero-metric"><span>Live Coins</span><strong><%= Number(stats.coins_circulating||0).toLocaleString('en-GB') %></strong></div>
    <div class="hero-metric"><span>Open tickets</span><strong><%= Number(stats.open_tickets||0).toLocaleString('en-GB') %></strong></div>
  </div>
</section>

<section class="stats compact-stats">
  <div class="stat"><span>Tracked members</span><strong><%= Number(stats.members_tracked||0).toLocaleString('en-GB') %></strong><small><%= Number(stats.active_7d||0).toLocaleString('en-GB') %> active in 7 days</small></div>
  <div class="stat"><span>Premium</span><strong><%= Number(stats.premium_members||0).toLocaleString('en-GB') %></strong><small>Active entitlements</small></div>
  <div class="stat"><span>Coins circulating</span><strong><%= Number(stats.coins_circulating||0).toLocaleString('en-GB') %></strong><small><%= Number(stats.coins_earned||0).toLocaleString('en-GB') %> earned lifetime</small></div>
  <div class="stat"><span>Quests this week</span><strong><%= Number(stats.quests_7d||0).toLocaleString('en-GB') %></strong><small>Completed rewards</small></div>
  <div class="stat"><span>Trade calls</span><strong><%= Number(stats.trade_calls||0).toLocaleString('en-GB') %></strong><small><%= Number(stats.live_calls||0).toLocaleString('en-GB') %> currently live</small></div>
  <div class="stat"><span>Reward queue</span><strong><%= Number(stats.pending_rewards||0).toLocaleString('en-GB') %></strong><small><%= Number(queue.failed||0).toLocaleString('en-GB') %> worker failures</small></div>
</section>

<section class="ops-grid">
  <div class="panel">
    <div class="section-head"><div><h2>Operations</h2><p>What needs attention right now.</p></div><a class="text-link" href="/audit">View audit log →</a></div>
    <div class="ops-list">
      <a class="ops-row" href="/tickets"><span class="ops-dot <%= Number(stats.open_tickets||0)?'warn':'good' %>"></span><span><strong>Support queue</strong><small><%= Number(stats.open_tickets||0) %> open tickets</small></span><time>Live</time></a>
      <a class="ops-row" href="/economy"><span class="ops-dot <%= Number(stats.pending_rewards||0)?'warn':'good' %>"></span><span><strong>Reward fulfilment</strong><small><%= Number(stats.pending_rewards||0) %> member rewards waiting</small></span><time>Live</time></a>
      <a class="ops-row" href="/economy"><span class="ops-dot <%= Number(queue.failed||0)?'bad':'good' %>"></span><span><strong>Background workers</strong><small><%= Number(queue.waiting||0) %> waiting • <%= Number(queue.failed||0) %> failed</small></span><time>Live</time></a>
      <a class="ops-row" href="/social"><span class="ops-dot <%= Number(stats.active_feeds||0)?'good':'warn' %>"></span><span><strong>Content feeds</strong><small><%= Number(stats.active_feeds||0) %> active automations</small></span><time>Live</time></a>
    </div>
  </div>

  <div class="panel">
    <div class="section-head"><div><h2><%= season?.name || 'Current season' %></h2><p>Retention loop and progression.</p></div><a class="text-link" href="/economy">Manage →</a></div>
    <% if(season){ %>
      <div class="metric-strip">
        <div class="metric-tile"><span>Participants</span><strong><%= Number(season.participants||0).toLocaleString('en-GB') %></strong></div>
        <div class="metric-tile"><span>Ends</span><strong><%= new Date(season.ends_at).toLocaleDateString('en-GB',{day:'numeric',month:'short'}) %></strong></div>
        <div class="metric-tile"><span>Status</span><strong>Live</strong></div>
      </div>
      <p class="muted small" style="margin-top:12px">Podium rewards: 🥇 <%= Number(season.rewards?.['1']||0).toLocaleString('en-GB') %> • 🥈 <%= Number(season.rewards?.['2']||0).toLocaleString('en-GB') %> • 🥉 <%= Number(season.rewards?.['3']||0).toLocaleString('en-GB') %> Live Coins</p>
    <% } else { %><div class="empty">No active season.</div><% } %>
  </div>
</section>

<section class="section">
  <div class="section-head"><div><h2>Workspace</h2><p>Jump straight into the areas you actually manage.</p></div></div>
  <div class="quick-grid">
    <a class="quick-card" href="/members"><strong>Members</strong><span>Profiles, activity and access</span></a>
    <a class="quick-card" href="/economy"><strong>Economy</strong><span>XP, Live Coins, quests and rewards</span></a>
    <a class="quick-card" href="/billing"><strong>Premium</strong><span>Plans, subscribers and referrals</span></a>
    <a class="quick-card" href="/analytics"><strong>Analytics</strong><span>Retention, activity and trading data</span></a>
    <a class="quick-card" href="/trading"><strong>Trading</strong><span>Calls and outcomes</span></a>
    <a class="quick-card" href="/social"><strong>Content feeds</strong><span>Automated community content</span></a>
    <a class="quick-card" href="/commands"><strong>Commands</strong><span>Roles, channels and permissions</span></a>
    <a class="quick-card" href="/setup"><strong>System health</strong><span>Configuration and launch checks</span></a>
  </div>
</section>

<section class="ops-grid section">
  <div class="panel">
    <div class="section-head"><div><h2>Top community members</h2><p>Permanent XP leaderboard.</p></div><a class="text-link" href="/members">All members →</a></div>
    <div class="leader-list">
      <% topMembers.forEach((m,n)=>{ %>
      <a href="/members/<%= m.user_id %>"><div><b>#<%= n+1 %></b><span><strong><%= m.name %></strong><small><%= Number(m.xp_total||0).toLocaleString('en-GB') %> XP • <%= Number(m.coins_balance||0).toLocaleString('en-GB') %> 🪙 • 🔥 <%= Number(m.current_streak||0) %>d</small></span></div></a>
      <% }) %>
      <% if(!topMembers.length){ %><div class="empty">Member progression will appear here.</div><% } %>
    </div>
  </div>

  <div class="panel">
    <div class="section-head"><div><h2>Recent admin activity</h2><p>Latest control-panel changes.</p></div></div>
    <div class="feed-list">
      <% recentAudit.forEach(a=>{ %><div><strong><%= String(a.action).replaceAll('.',' › ') %></strong><small><%= new Date(a.created_at).toLocaleString('en-GB') %></small></div><% }) %>
      <% if(!recentAudit.length){ %><div class="empty">No recent activity.</div><% } %>
    </div>
  </div>
</section>

<section class="section">
  <div class="section-head"><div><h2>Feature modules</h2><p>Fine-grained server configuration.</p></div></div>
  <div class="module-grid compact-modules">
    <% modules.forEach(m=>{ const setting=moduleSettings.get(m.key); const enabled=setting?.enabled ?? true; %>
      <a class="module-card" href="/modules/<%= m.key %>"><div class="module-top"><h3><%= m.title %></h3><span class="pill <%= enabled?'on':'off' %>"><%= enabled?'Active':'Off' %></span></div><p><%= m.description %></p><span class="arrow">→</span></a>
    <% }) %>
  </div>
</section>
</main></body></html>