<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Automation • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control"><section class="topbar"><div><div class="crumb">Discord Control / Automation</div><h1>Automation</h1><p>Recurring server posts, external content and giveaway activity.</p></div><div class="top-actions"><a class="btn-secondary" href="/automation">Manage schedules</a><a class="btn" href="/social">Manage feeds</a></div></section><section class="grid three"><div class="panel"><div class="panel-head"><div><h2>Scheduled posts</h2><p><%= scheduled.filter(s=>s.enabled).length %> active</p></div></div><div class="list"><% scheduled.slice(0,8).forEach(s=>{ %><div class="row"><span class="row-main"><strong><%= s.name %></strong><small><%= s.cron_expression %></small></span><span class="pill <%= s.enabled?'good':'bad' %>"><%= s.enabled?'On':'Paused' %></span></div><% }) %></div></div><div class="panel"><div class="panel-head"><div><h2>Content feeds</h2><p><%= feeds.filter(f=>f.enabled).length %> active</p></div></div><div class="list"><% feeds.slice(0,8).forEach(f=>{ %><div class="row"><span class="row-main"><strong><%= f.name %></strong><small><%= f.provider %></small></span><span class="pill <%= f.enabled?'good':'bad' %>"><%= f.enabled?'On':'Paused' %></span></div><% }) %></div></div><div class="panel"><div class="panel-head"><div><h2>Giveaways</h2><p>Recent history</p></div></div><div class="list"><% giveaways.slice(0,8).forEach(g=>{ %><div class="row"><span class="row-main"><strong><%= g.prize %></strong><small><%= new Date(g.ends_at).toLocaleString('en-GB') %></small></span><span class="pill <%= g.status==='LIVE'?'good':'' %>"><%= g.status %></span></div><% }) %></div></div></section></main></body></html>