<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Automation • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control">
<section class="topbar"><div><div class="crumb">Discord Control / Automation</div><h1>Automation</h1><p>Recurring server posts and external content, managed without cron strings or IDs.</p></div></section>
<section class="grid two">
<div class="panel"><div class="panel-head"><div><h2>Scheduled messages</h2><p>Create recurring posts in plain English controls.</p></div><span class="pill"><%= scheduled.filter(s=>s.enabled).length %> active</span></div>
<form method="post" action="/control/automation/scheduled" class="form-grid"><label>Name<input name="name" required placeholder="Morning check-in"></label><label>Channel<select name="channelId" required><option value="">Choose channel</option><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>"># <%= c.name %></option><% }) %></select></label><label>Hour<select name="hour"><% for(let h=0;h<24;h++){ %><option value="<%= h %>"><%= String(h).padStart(2,'0') %>:00</option><% } %></select></label><label>Minute<select name="minute"><% [0,5,10,15,20,30,45].forEach(m=>{ %><option value="<%= m %>"><%= String(m).padStart(2,'0') %></option><% }) %></select></label><label class="wide">Days<div class="check-grid"><% [['1','Mon'],['2','Tue'],['3','Wed'],['4','Thu'],['5','Fri'],['6','Sat'],['0','Sun']].forEach(d=>{ %><label class="check"><input type="checkbox" name="days" value="<%= d[0] %>"><span><%= d[1] %></span></label><% }) %></div></label><label class="wide">Message<textarea name="content" rows="4" required placeholder="Good morning everyone…"></textarea></label><div class="wide"><button class="btn">Create schedule</button></div></form>
<div class="list" style="margin-top:12px"><% scheduled.forEach(s=>{ %><div class="row"><span class="row-main"><strong><%= s.name %></strong><small><%= s.cron_expression %> • <%= s.channel_id %></small></span><span class="top-actions"><span class="pill <%= s.enabled?'good':'bad' %>"><%= s.enabled?'On':'Paused' %></span><form method="post" action="/control/automation/scheduled/<%= s.id %>/toggle"><button class="btn-secondary small"><%= s.enabled?'Pause':'Resume' %></button></form><form method="post" action="/control/automation/scheduled/<%= s.id %>/delete"><button class="btn-danger small">Delete</button></form></span></div><% }) %></div></div>

<div class="panel"><div class="panel-head"><div><h2>Content feeds</h2><p>Route useful external content into Discord.</p></div><span class="pill"><%= feeds.filter(f=>f.enabled).length %> active</span></div>
<form method="post" action="/control/automation/feeds" class="form-grid"><label>Source type<select name="provider"><option value="rss">Website / RSS</option><option value="reddit">Reddit</option><option value="youtube">YouTube</option><option value="x">X / Twitter</option><option value="webhook">Custom webhook</option></select></label><label>Feed name<input name="name" required placeholder="EA Sports FC"></label><label class="wide">Source<input name="source" placeholder="@account, subreddit or feed URL"></label><label>Post into<select name="channelId" required><option value="">Choose channel</option><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>"># <%= c.name %></option><% }) %></select></label><label>Mention role<select name="mentionRoleId"><option value="">Nobody</option><% roles.forEach(r=>{ %><option value="<%= r.id %>">@<%= r.name %></option><% }) %></select></label><label>Include words<input name="includeKeywords" placeholder="promo, SBC"></label><label>Exclude words<input name="excludeKeywords" placeholder="ad, giveaway"></label><div class="wide"><button class="btn">Add feed</button></div></form>
<div class="list" style="margin-top:12px"><% feeds.forEach(f=>{ const ch=channels.find(c=>c.id===f.channel_id); %><div class="row"><span class="row-main"><strong><%= f.name %></strong><small><%= f.provider %> → # <%= ch?.name||'unknown' %></small></span><span class="top-actions"><span class="pill <%= f.enabled?'good':'bad' %>"><%= f.enabled?'On':'Paused' %></span><form method="post" action="/control/automation/feeds/<%= f.id %>/toggle"><button class="btn-secondary small"><%= f.enabled?'Pause':'Resume' %></button></form><form method="post" action="/control/automation/feeds/<%= f.id %>/delete"><button class="btn-danger small">Delete</button></form></span></div><% }) %></div></div>
</section>
<section class="panel" style="margin-top:11px"><div class="panel-head"><div><h2>Giveaway activity</h2><p>Giveaway creation stays in Discord with <code>/giveaway</code>; history is visible here.</p></div></div><div class="table-wrap"><table><thead><tr><th>Prize</th><th>Status</th><th>Ends</th><th>Winners</th></tr></thead><tbody><% giveaways.forEach(g=>{ %><tr><td><strong><%= g.prize %></strong></td><td><span class="pill <%= g.status==='LIVE'?'good':'' %>"><%= g.status %></span></td><td><%= new Date(g.ends_at).toLocaleString('en-GB') %></td><td><%= (g.winners||[]).length||'—' %></td></tr><% }) %><% if(!giveaways.length){ %><tr><td colspan="4" class="empty">No giveaways yet.</td></tr><% } %></tbody></table></div></section>
</main></body></html>