<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Growth • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control"><section class="topbar"><div><div class="crumb">Discord Control / Growth</div><h1>Invites, partners & boosters</h1><p>Reward retained growth, measure partner quality and recognise long-term boosters.</p></div></section><% if(saved){ %><div class="notice">Saved.</div><% } %>
<section class="grid two"><div class="panel"><div class="panel-head"><div><h2>Invite leaderboard</h2><p>Retained joins matter more than raw joins.</p></div></div><% inviteLeaders.forEach((x,n)=>{ %><div class="kudos-rank"><b>#<%= n+1 %></b><span><strong><%= x.name %></strong><small><%= x.total %> total joins</small></span><strong><%= x.retained %> retained</strong></div><% }) %></div><div class="panel"><div class="panel-head"><div><h2>Invite milestones</h2><p>Roles, XP, coins and Premium days.</p></div></div><form method="post" action="/control/growth/invite-milestone" class="form-grid"><label>Retained invites<input name="retainedInvites" type="number" min="1" value="5"></label><label>Role<select name="roleId"><option value="">No role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>">@<%= r.name %></option><% }) %></select></label><label>XP<input name="xpReward" type="number" min="0" value="500"></label><label>Coins<input name="coinReward" type="number" min="0" value="500"></label><label>Premium days<input name="premiumDays" type="number" min="0" value="0"></label><div class="wide"><button class="btn">Save milestone</button></div></form><div class="list" style="margin-top:8px"><% inviteMilestones.forEach(m=>{ %><div class="row"><span class="row-main"><strong><%= m.retained_invites %> retained joins</strong><small><%= m.xp_reward %> XP • <%= m.coin_reward %> coins • <%= m.premium_days %> Premium days</small></span></div><% }) %></div></div></section>
<section class="grid two" style="margin-top:11px"><div class="panel"><div class="panel-head"><div><h2>Partnership manager</h2><p>Track who sends useful members, not just vanity partnerships.</p></div></div><form method="post" action="/control/growth/partners" class="form-grid"><label>Partner name<input name="partnerName" required></label><label>Server ID<input name="serverId"></label><label>Contact name<input name="contactName"></label><label>Contact Discord ID<input name="contactDiscordId"></label><label>Invite code<input name="inviteCode"></label><label>Started<input type="date" name="startedAt"></label><label>Review date<input type="date" name="reviewAt"></label><label class="wide">Notes<textarea name="notes" rows="2"></textarea></label><div class="wide"><button class="btn">Add partner</button></div></form><div class="list" style="margin-top:8px"><% partners.forEach(p=>{ %><div class="row"><span class="row-main"><strong><%= p.partner_name %></strong><small><%= p.joins||0 %> joins • <%= p.retained||0 %> retained<%= p.review_at?' • review '+new Date(p.review_at).toLocaleDateString('en-GB'):'' %></small></span><form method="post" action="/control/growth/partners/<%= p.id %>/toggle"><button class="btn-secondary small"><%= p.status %></button></form></div><% }) %></div></div>
<div class="panel"><div class="panel-head"><div><h2>Booster milestones</h2><p>Reward supporters at meaningful boost anniversaries.</p></div></div><form method="post" action="/control/growth/booster-milestone" class="form-grid"><label>Months<input name="months" type="number" min="1" value="3"></label><label>Role<select name="roleId"><option value="">No role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>">@<%= r.name %></option><% }) %></select></label><label>XP<input name="xpReward" type="number" min="0" value="250"></label><label>Coins<input name="coinReward" type="number" min="0" value="350"></label><div class="wide"><button class="btn">Save milestone</button></div></form><div class="list" style="margin-top:8px"><% boosterMilestones.forEach(m=>{ %><div class="row"><span class="row-main"><strong><%= m.months %> months</strong><small><%= m.xp_reward %> XP • <%= m.coin_reward %> coins</small></span></div><% }) %></div></div></section>
</main></body></html>