<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Discord features • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"></head><body><aside class="sidebar"><a class="brand" href="/dashboard"><span>EAFC.Live</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/setup">Setup wizard</a><a href="/members">Members</a><a href="/analytics">Analytics</a><a href="/commands">Commands</a><a href="/automation">Automation</a><a class="active" href="/discord">Discord features</a></nav></aside><main class="content saas-page"><section class="page-hero compact"><div><div class="eyebrow">COMMUNITY / DISCORD</div><h1>Native Discord tools</h1><p>Use Discord forums, polls, scheduled events and Community Onboarding from the same control centre.</p></div></section><% if(message){ %><div class="notice">✓ <%= message %></div><% } %><% if(error){ %><div class="notice" style="background:#29171a;border-color:#5f2a31;color:#ffa4ae">⚠ <%= error %></div><% } %><div class="native-tools-grid"><section class="panel"><h2>Create a Forum channel</h2><p class="muted">Ideal for investments, guides and trading questions that need persistent organised threads.</p><form method="post" action="/discord/forum" class="form-grid"><label>Name<input name="name" value="trading-forum" required></label><label class="wide">Topic<input name="topic" value="FC27 investments, guides and trading questions"></label><button class="button wide">Create forum</button></form></section><section class="panel"><h2>Post a native Discord poll</h2><form method="post" action="/discord/poll" class="form-grid"><label>Channel<select name="channelId"><% channels.filter(c=>c.type===0||c.type===5).forEach(c=>{ %><option value="<%= c.id %>"># <%= c.name %></option><% }) %></select></label><label>Duration<select name="duration"><option value="1">1 hour</option><option value="4">4 hours</option><option value="8">8 hours</option><option value="24" selected>24 hours</option><option value="72">3 days</option><option value="168">1 week</option></select></label><label class="wide">Question<input name="question" required placeholder="Fodder tonight?"></label><label class="wide">Answers<textarea name="answers" rows="5" required placeholder="Buy\nHold\nSell"></textarea></label><label class="toggle-row wide"><span>Allow multiple answers</span><input type="checkbox" name="multiselect"></label><button class="button wide">Post poll</button></form></section><section class="panel"><h2>Create a Discord event</h2><form method="post" action="/discord/event" class="form-grid"><label>Name<input name="name" required placeholder="FC27 live trading session"></label><label>Starts<input type="datetime-local" name="startsAt" required></label><label>Duration (minutes)<input type="number" name="duration" value="60" min="15"></label><label>Location<input name="location" value="Discord"></label><label class="wide">Description<textarea name="description" rows="3"></textarea></label><button class="button wide">Create event</button></form></section><section class="panel"><h2>Sync Community Onboarding</h2><p class="muted">Turns your EAFC.Live Control role groups into Discord's own onboarding questions. Choose the channels every new member should see. Discord Community must already be enabled.</p><form method="post" action="/discord/onboarding"><div class="check-picker"><% channels.filter(c=>c.type===0||c.type===5).forEach(c=>{ %><label class="check-option"><input type="checkbox" name="defaultChannelIds" value="<%= c.id %>"><span># <%= c.name %></span></label><% }) %></div><button class="button full">Sync role groups to onboarding</button></form><a class="ghost full" href="/modules/role_menus">Edit role groups first</a></section></div></main></body></html>