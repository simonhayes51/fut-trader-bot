<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= member.displayName %> • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"></head><body><aside class="sidebar"><a class="brand" href="/dashboard"><span>EAFC.Live</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/setup">Setup wizard</a><a class="active" href="/members">Members</a><a href="/analytics">Analytics</a><a href="/commands">Commands</a><a href="/automation">Automation</a></nav></aside><main class="content"><a class="back" href="/members">← Back to members</a><header><div><div class="eyebrow">MEMBER PROFILE</div><h1><%= member.displayName %></h1><p class="muted">@<%= member.user.username %> • joined <%= member.joinedAt?new Date(member.joinedAt).toLocaleDateString('en-GB'):'—' %></p></div></header><section class="stats"><div class="stat"><span>Level</span><strong><%= level %></strong><small><%= Number(economy?.xp_total||0).toLocaleString() %> XP</small></div><div class="stat"><span>Live Coins</span><strong><%= Number(economy?.coins_balance||0).toLocaleString() %></strong><small><%= Number(economy?.lifetime_coins_earned||0).toLocaleString() %> earned</small></div><div class="stat"><span>Streak</span><strong><%= Number(streak?.current_streak||0) %>d</strong><small>Best <%= Number(streak?.longest_streak||0) %>d</small></div><div class="stat"><span>Trader accuracy</span><strong><%= callAccuracy %>%</strong><small><%= calls.filter(c=>c.status!=='LIVE').length %> closed calls</small></div><div class="stat"><span>Helpful votes</span><strong><%= stats?.thanks_received||0 %></strong></div><div class="stat"><span>Achievements</span><strong><%= achievements.length %></strong></div></section><div class="two-col"><section class="panel"><h2>Trading</h2><div class="feed-list"><% trades.forEach(t=>{ %><div><strong><%= t.player %> • <%= Number(t.profit||0)>=0?'+':'' %><%= Number(t.profit||0).toLocaleString() %></strong><small>Buy <%= Number(t.buy_price).toLocaleString() %> • Sell <%= Number(t.sell_price||0).toLocaleString() %> • Qty <%= t.quantity %></small></div><% }) %><% if(!trades.length){ %><p class="muted">No journal trades.</p><% } %></div></section><section class="panel"><h2>Premium & referrals</h2><div class="feed-list"><% subs.slice(0,5).forEach(s=>{ %><div><strong><%= s.plan_name||'Premium' %> • <%= s.status %></strong><small><%= s.current_period_end?new Date(s.current_period_end).toLocaleDateString('en-GB'):'No expiry' %></small></div><% }) %><% refs.forEach(r=>{ %><div><strong>Referral <%= r.code %></strong><small><%= r.clicks %> clicks • <%= r.conversions %> conversions</small></div><% }) %><% if(!subs.length&&!refs.length){ %><p class="muted">No Premium or referral activity.</p><% } %></div></section><section class="panel"><h2>Staff history</h2><div class="feed-list"><% warnings.forEach(w=>{ %><div><strong>⚠️ <%= w.reason %></strong><small><%= new Date(w.created_at).toLocaleString('en-GB') %></small></div><% }) %><% notes.forEach(n=>{ %><div><strong>📝 <%= n.note %></strong><small><%= new Date(n.created_at).toLocaleString('en-GB') %></small></div><% }) %><% if(!warnings.length&&!notes.length){ %><p class="muted">Clean history.</p><% } %></div></section><section class="panel"><h2>Achievements</h2><div class="badge-grid"><% achievements.forEach(a=>{ %><span class="achievement"><%= a.icon||'🏅' %> <%= a.name||a.achievement_key.replaceAll('_',' ') %></span><% }) %><% if(!achievements.length){ %><p class="muted">None unlocked yet.</p><% } %></div></section><section class="panel"><h2>Quest progress</h2><div class="feed-list"><% quests.forEach(q=>{ %><div><strong><%= q.rewarded_at?'✅ ':'🎯 ' %><%= q.name %></strong><small><%= Math.min(Number(q.progress||0),Number(q.target||0)) %>/<%= q.target %> • <%= q.cadence %></small></div><% }) %><% if(!quests.length){ %><p class="muted">No quest activity yet.</p><% } %></div></section><section class="panel"><h2>Economy ledger</h2><div class="feed-list"><% ledger.slice(0,12).forEach(l=>{ %><div><strong><%= Number(l.amount)>0?'+':'' %><%= Number(l.amount).toLocaleString() %> <%= l.currency==='coins'?'🪙':'XP' %></strong><small><%= l.reason %> • <%= new Date(l.created_at).toLocaleString('en-GB') %></small></div><% }) %><% if(!ledger.length){ %><p class="muted">No economy activity yet.</p><% } %></div></section></div></main></body></html>