<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= member.displayName %> • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/polish.css"></head><body><aside class="sidebar"></aside><main class="content saas-page">
<a class="back" href="/members">← Back to member centre</a>
<section class="profile-hero"><div class="profile-main"><span class="profile-avatar"><%= member.displayName.slice(0,1).toUpperCase() %></span><div><div class="eyebrow">MEMBER RECORD</div><h1><%= member.displayName %></h1><p>@<%= member.user.username %> • Joined <%= member.joinedAt?new Date(member.joinedAt).toLocaleDateString('en-GB'):'—' %></p></div></div><div class="profile-tags"><span class="pill <%= subs.some(s=>['active','comped','gifted','past_due'].includes(s.status))?'on':'' %>"><%= subs.some(s=>['active','comped','gifted','past_due'].includes(s.status))?'Premium':'Standard' %></span><span class="pill">Level <%= level %></span></div></section>
<section class="stats compact-stats profile-stats"><div class="stat"><span>Level</span><strong><%= level %></strong><small><%= Number(economy?.xp_total||0).toLocaleString() %> XP</small></div><div class="stat"><span>Live Coins</span><strong><%= Number(economy?.coins_balance||0).toLocaleString() %></strong><small><%= Number(economy?.lifetime_coins_earned||0).toLocaleString() %> earned</small></div><div class="stat"><span>Streak</span><strong><%= Number(streak?.current_streak||0) %>d</strong><small>Best <%= Number(streak?.longest_streak||0) %>d</small></div><div class="stat"><span>Trader accuracy</span><strong><%= callAccuracy %>%</strong><small><%= calls.filter(c=>c.status!=='LIVE').length %> closed calls</small></div><div class="stat"><span>Helpful votes</span><strong><%= stats?.thanks_received||0 %></strong></div><div class="stat"><span>Achievements</span><strong><%= achievements.length %></strong></div></section>
<div class="profile-layout">
<section class="panel profile-primary"><div class="section-head"><div><h2>Trading record</h2><p>Journal performance and recent activity.</p></div><a class="text-link" href="/trading">All calls →</a></div><div class="feed-list richer"><% trades.slice(0,12).forEach(t=>{ %><div><span class="feed-badge <%= Number(t.profit||0)>=0?'positive':'negative' %>"><%= Number(t.profit||0)>=0?'+':'' %><%= Number(t.profit||0).toLocaleString() %></span><span><strong><%= t.player %></strong><small>Buy <%= Number(t.buy_price).toLocaleString() %> • Sell <%= Number(t.sell_price||0).toLocaleString() %> • Qty <%= t.quantity %></small></span></div><% }) %><% if(!trades.length){ %><div class="empty">No journal trades.</div><% } %></div></section>
<section class="panel"><div class="section-head"><div><h2>Premium & referrals</h2><p>Access and acquisition history.</p></div></div><div class="feed-list"><% subs.slice(0,6).forEach(s=>{ %><div><strong><%= s.plan_name||'Premium' %> • <%= s.status.replaceAll('_',' ') %></strong><small><%= s.current_period_end?new Date(s.current_period_end).toLocaleDateString('en-GB'):'No expiry' %></small></div><% }) %><% refs.forEach(r=>{ %><div><strong>Referral <%= r.code %></strong><small><%= r.clicks %> checkout starts • <%= r.conversions %> conversions</small></div><% }) %><% if(!subs.length&&!refs.length){ %><div class="empty">No Premium or referral activity.</div><% } %></div></section>
<section class="panel"><div class="section-head"><div><h2>Achievements</h2><p>Permanent milestones.</p></div></div><div class="badge-grid achievement-grid"><% achievements.forEach(a=>{ %><span class="achievement"><b><%= a.icon||'🏅' %></b><span><strong><%= a.name||a.achievement_key.replaceAll('_',' ') %></strong><small><%= a.description||'' %></small></span></span><% }) %><% if(!achievements.length){ %><div class="empty">No achievements yet.</div><% } %></div></section>
<section class="panel"><div class="section-head"><div><h2>Quest progress</h2><p>Recent progression activity.</p></div></div><div class="feed-list"><% quests.slice(0,12).forEach(q=>{ const pct=Math.min(100,Math.round(Number(q.progress||0)/Math.max(1,Number(q.target||1))*100)); %><div class="quest-line"><span><strong><%= q.rewarded_at?'✓ ':'' %><%= q.name %></strong><small><%= q.cadence %> • <%= Math.min(Number(q.progress||0),Number(q.target||0)) %>/<%= q.target %></small></span><span class="mini-progress"><i style="width:<%= pct %>%"></i></span></div><% }) %><% if(!quests.length){ %><div class="empty">No quest activity yet.</div><% } %></div></section>
<section class="panel"><div class="section-head"><div><h2>Staff record</h2><p>Internal notes, warnings and support history.</p></div></div><div class="feed-list"><% warnings.forEach(w=>{ %><div><strong>⚠ <%= w.reason %></strong><small><%= new Date(w.created_at).toLocaleString('en-GB') %></small></div><% }) %><% notes.forEach(n=>{ %><div><strong>📝 <%= n.note %></strong><small><%= new Date(n.created_at).toLocaleString('en-GB') %></small></div><% }) %><% tickets.slice(0,6).forEach(t=>{ %><div><strong>🎫 Ticket #<%= t.id %> • <%= t.status %></strong><small><%= new Date(t.created_at).toLocaleString('en-GB') %></small></div><% }) %><% if(!warnings.length&&!notes.length&&!tickets.length){ %><div class="empty">Clean history.</div><% } %></div></section>
<section class="panel"><div class="section-head"><div><h2>Economy ledger</h2><p>Auditable progression and wallet movements.</p></div></div><div class="ledger-list"><% ledger.slice(0,16).forEach(l=>{ %><div><span class="ledger-amount <%= Number(l.amount)>=0?'positive':'negative' %>"><%= Number(l.amount)>0?'+':'' %><%= Number(l.amount).toLocaleString() %> <%= l.currency==='coins'?'🪙':'XP' %></span><span><strong><%= l.reason %></strong><small><%= new Date(l.created_at).toLocaleString('en-GB') %></small></span></div><% }) %><% if(!ledger.length){ %><div class="empty">No economy activity yet.</div><% } %></div></section>
</div></main></body></html>