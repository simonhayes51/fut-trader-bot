<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= member.displayName %> • FC27 Control</title><link rel="stylesheet" href="/style.css"></head><body><aside class="sidebar"><a class="brand" href="/dashboard"><span>FC27</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/setup">Setup wizard</a><a class="active" href="/members">Members</a><a href="/analytics">Analytics</a><a href="/commands">Commands</a><a href="/automation">Automation</a></nav></aside><main class="content"><a class="back" href="/members">← Back to members</a><header><div><div class="eyebrow">MEMBER PROFILE</div><h1><%= member.displayName %></h1><p class="muted">@<%= member.user.username %> • joined <%= member.joinedAt?new Date(member.joinedAt).toLocaleDateString('en-GB'):'—' %></p></div></header><section class="stats"><div class="stat"><span>XP</span><strong><%= Number(stats?.xp||0).toLocaleString() %></strong></div><div class="stat"><span>Thanks</span><strong><%= stats?.thanks_received||0 %></strong></div><div class="stat"><span>Trade calls</span><strong><%= calls.length %></strong></div><div class="stat"><span>Journal trades</span><strong><%= trades.length %></strong></div><div class="stat"><span>Warnings</span><strong><%= warnings.length %></strong></div><div class="stat"><span>Achievements</span><strong><%= achievements.length %></strong></div></section><div class="two-col"><section class="panel"><h2>Trading</h2><div class="feed-list"><% trades.forEach(t=>{ %><div><strong><%= t.player %> • <%= Number(t.profit||0)>=0?'+':'' %><%= Number(t.profit||0).toLocaleString() %></strong><small>Buy <%= Number(t.buy_price).toLocaleString() %> • Sell <%= Number(t.sell_price||0).toLocaleString() %> • Qty <%= t.quantity %></small></div><% }) %><% if(!trades.length){ %><p class="muted">No journal trades.</p><% } %></div></section><section class="panel"><h2>Premium & referrals</h2><div class="feed-list"><% subs.slice(0,5).forEach(s=>{ %><div><strong><%= s.plan_name||'Premium' %> • <%= s.status %></strong><small><%= s.current_period_end?new Date(s.current_period_end).toLocaleDateString('en-GB'):'No expiry' %></small></div><% }) %><% refs.forEach(r=>{ %><div><strong>Referral <%= r.code %></strong><small><%= r.clicks %> clicks • <%= r.conversions %> conversions</small></div><% }) %><% if(!subs.length&&!refs.length){ %><p class="muted">No Premium or referral activity.</p><% } %></div></section><section class="panel"><h2>Staff history</h2><div class="feed-list"><% warnings.forEach(w=>{ %><div><strong>⚠️ <%= w.reason %></strong><small><%= new Date(w.created_at).toLocaleString('en-GB') %></small></div><% }) %><% notes.forEach(n=>{ %><div><strong>📝 <%= n.note %></strong><small><%= new Date(n.created_at).toLocaleString('en-GB') %></small></div><% }) %><% if(!warnings.length&&!notes.length){ %><p class="muted">Clean history.</p><% } %></div></section><section class="panel"><h2>Achievements</h2><div class="badge-grid"><% achievements.forEach(a=>{ %><span class="achievement">🏅 <%= a.achievement_key.replaceAll('_',' ') %></span><% }) %><% if(!achievements.length){ %><p class="muted">None unlocked yet.</p><% } %></div></section></div></main></body></html>