<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Safety • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control"><section class="topbar"><div><div class="crumb">Discord Control / Safety & Support</div><h1>Safety & support</h1><p>Moderation and member support in one queue.</p></div><div class="top-actions"><a class="btn-secondary" href="/modules/automod">Automod</a><a class="btn-secondary" href="/modules/join_security">Join security</a><a class="btn" href="/modules/tickets">Ticket settings</a></div></section><section class="grid metrics"><div class="metric"><span>Open tickets</span><strong><%= tickets.filter(t=>t.status==='OPEN').length %></strong></div><div class="metric"><span>Warnings</span><strong><%= warnings.length %></strong></div><div class="metric"><span>Reports</span><strong><%= reports.filter(r=>r.status==='OPEN').length %></strong></div></section><section class="grid two"><div class="panel"><div class="panel-head"><div><h2>Open support</h2><p>Newest tickets first.</p></div></div><div class="list"><% tickets.filter(t=>t.status==='OPEN').slice(0,15).forEach(t=>{ const m=members.find(x=>x.id===t.user_id); %><div class="row"><span class="row-main"><strong>#<%= t.id %> • <%= t.ticket_type %></strong><small><%= m?.name||t.user_id %> • <%= new Date(t.created_at).toLocaleString('en-GB') %></small></span><span class="pill <%= t.claimed_by?'good':'warn' %>"><%= t.claimed_by?'Claimed':'Unclaimed' %></span></div><% }) %></div></div><div class="panel"><div class="panel-head"><div><h2>Recent moderation</h2><p>Warnings and reports.</p></div></div><div class="list"><% warnings.slice(0,8).forEach(w=>{ const m=members.find(x=>x.id===w.user_id); %><div class="row"><span class="row-main"><strong>⚠ <%= w.reason %></strong><small><%= m?.name||w.user_id %> • <%= new Date(w.created_at).toLocaleString('en-GB') %></small></span></div><% }) %><% reports.filter(r=>r.status==='OPEN').slice(0,5).forEach(r=>{ %><div class="row"><span class="row-main"><strong>Report #<%= r.id %></strong><small><%= r.evidence.slice(0,100) %></small></span><span class="pill warn">Open</span></div><% }) %></div></div></section></main></body></html>