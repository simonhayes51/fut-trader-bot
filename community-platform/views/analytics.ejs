<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Analytics • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/polish.css"></head><body><aside class="sidebar"></aside><main class="content saas-page">
<section class="page-hero compact"><div><div class="eyebrow">WORKSPACE / ANALYTICS</div><h1>Community intelligence</h1><p>Engagement, economy and trading signals in one operational view.</p></div><div class="hero-actions"><a class="ghost" href="/members">Member centre</a><a class="button" href="/economy">Economy controls</a></div></section>
<section class="stats compact-stats"><div class="stat"><span>Journal trades</span><strong><%= Number(summary.journal_trades||0).toLocaleString() %></strong></div><div class="stat"><span>Tracked profit</span><strong><%= Number(summary.tracked_profit||0).toLocaleString() %></strong></div><div class="stat"><span>Live Coins</span><strong><%= Number(summary.coins_circulating||0).toLocaleString() %></strong></div><div class="stat"><span>Quests completed</span><strong><%= Number(summary.quests_completed||0).toLocaleString() %></strong></div><div class="stat"><span>Referral codes</span><strong><%= Number(summary.referrals||0).toLocaleString() %></strong></div></section>
<section class="panel analytics-chart"><div class="section-head"><div><h2>30-day community activity</h2><p>Daily message volume from the server metrics ledger.</p></div><span class="table-count">Last 30 days</span></div><div class="chart-bars saas-chart"><% const max=Math.max(1,...daily.map(d=>Number(d.messages||0))); daily.forEach(d=>{ const activity=Number(d.messages||0); const h=Math.max(4,Math.round(activity/max*180)); %><div class="bar-col" title="<%= d.metric_date %>: <%= activity %> messages"><div class="bar-value"><%= activity %></div><div class="bar" style="height:<%= h %>px"></div><small><%= new Date(d.metric_date).getDate() %></small></div><% }) %><% if(!daily.length){ %><div class="empty">Analytics will populate as members use the server.</div><% } %></div></section>
<section class="analytics-grid section"><section class="panel leaderboard-panel"><div class="section-head"><h2>Top XP</h2></div><div class="rank-list"><% topXp.forEach((r,n)=>{ %><a href="/members/<%= r.user_id %>"><b>#<%= n+1 %></b><span><strong><%= r.user_id %></strong><small><%= Number(r.xp).toLocaleString() %> XP</small></span></a><% }) %></div></section><section class="panel leaderboard-panel"><div class="section-head"><h2>Richest wallets</h2></div><div class="rank-list"><% topCoins.forEach((r,n)=>{ %><a href="/members/<%= r.user_id %>"><b>#<%= n+1 %></b><span><strong><%= r.user_id %></strong><small><%= Number(r.coins_balance).toLocaleString() %> Live Coins</small></span></a><% }) %></div></section><section class="panel leaderboard-panel"><div class="section-head"><h2>Most helpful</h2></div><div class="rank-list"><% topHelpful.forEach((r,n)=>{ %><a href="/members/<%= r.user_id %>"><b>#<%= n+1 %></b><span><strong><%= r.user_id %></strong><small><%= r.thanks_received %> helpful votes</small></span></a><% }) %></div></section><section class="panel leaderboard-panel"><div class="section-head"><h2>Trading profit</h2></div><div class="rank-list"><% topProfit.forEach((r,n)=>{ %><a href="/members/<%= r.user_id %>"><b>#<%= n+1 %></b><span><strong><%= r.user_id %></strong><small><%= Number(r.profit).toLocaleString() %> coins</small></span></a><% }) %></div></section></section>
</main></body></html>