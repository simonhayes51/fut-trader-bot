<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Analytics • FC27 Control</title><link rel="stylesheet" href="/style.css"></head><body><aside class="sidebar"><a class="brand" href="/dashboard"><span>FC27</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/setup">Setup wizard</a><a href="/members">Members</a><a class="active" href="/analytics">Analytics</a><a href="/commands">Commands</a><a href="/automation">Automation</a><a href="/billing">Premium & billing</a></nav></aside><main class="content"><header><div><div class="eyebrow">COMMUNITY INTELLIGENCE</div><h1>Analytics</h1><p class="muted">Community growth, engagement and trading performance.</p></div></header><section class="stats"><div class="stat"><span>Journal trades</span><strong><%= summary.journal_trades||0 %></strong></div><div class="stat"><span>Tracked profit</span><strong><%= Number(summary.tracked_profit||0).toLocaleString() %></strong></div><div class="stat"><span>Giveaways</span><strong><%= summary.giveaways||0 %></strong></div><div class="stat"><span>Reports</span><strong><%= summary.reports||0 %></strong></div><div class="stat"><span>Referral codes</span><strong><%= summary.referrals||0 %></strong></div></section><section class="panel"><h2>Last 30 days</h2><div class="chart-bars"><% daily.forEach(d=>{ const activity=Number(d.messages||0); %><div class="bar-col" title="<%= d.metric_date %>: <%= activity %> messages"><div class="bar" style="height:<%= Math.max(3,Math.min(160,activity/2)) %>px"></div><small><%= new Date(d.metric_date).getDate() %></small></div><% }) %><% if(!daily.length){ %><p class="muted">Analytics will fill in as members use the server.</p><% } %></div></section><div class="three-col"><section class="panel"><h2>Top XP</h2><div class="feed-list"><% topXp.forEach((r,n)=>{ %><div><strong>#<%= n+1 %> <a href="/members/<%= r.user_id %>"><%= r.user_id %></a></strong><small><%= Number(r.xp).toLocaleString() %> XP</small></div><% }) %></div></section><section class="panel"><h2>Most helpful</h2><div class="feed-list"><% topHelpful.forEach((r,n)=>{ %><div><strong>#<%= n+1 %> <a href="/members/<%= r.user_id %>"><%= r.user_id %></a></strong><small><%= r.thanks_received %> thanks</small></div><% }) %></div></section><section class="panel"><h2>Trading profit</h2><div class="feed-list"><% topProfit.forEach((r,n)=>{ %><div><strong>#<%= n+1 %> <a href="/members/<%= r.user_id %>"><%= r.user_id %></a></strong><small><%= Number(r.profit).toLocaleString() %> coins</small></div><% }) %></div></section></div></main></body></html>