<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Automation • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"></head><body><aside class="sidebar"><a class="brand" href="/dashboard"><span>EAFC.Live</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/setup">Setup wizard</a><a href="/members">Members</a><a href="/analytics">Analytics</a><a href="/commands">Commands</a><a class="active" href="/automation">Automation</a><a href="/social">Social feeds</a></nav></aside><main class="content"><header><div><div class="eyebrow">AUTOMATION</div><h1>Scheduled posts & giveaways</h1><p class="muted">No cron expressions. Pick the time, days and channel.</p></div></header><div class="two-col"><section class="panel"><h2>New scheduled post</h2><form method="post" action="/automation/scheduled" class="form-grid"><label>Name<input name="name" required placeholder="Morning market thread"></label><label>Channel<select name="channelId" required><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>"># <%= c.name %></option><% }) %></select></label><label>Hour<select name="hour"><% for(let h=0;h<24;h++){ %><option value="<%= h %>"><%= String(h).padStart(2,'0') %>:00</option><% } %></select></label><label>Minute<select name="minute"><% [0,5,10,15,20,30,45].forEach(m=>{ %><option value="<%= m %>"><%= String(m).padStart(2,'0') %></option><% }) %></select></label><div class="wide"><strong class="field-title">Days</strong><div class="check-picker"><% [['1','Mon'],['2','Tue'],['3','Wed'],['4','Thu'],['5','Fri'],['6','Sat'],['0','Sun']].forEach(d=>{ %><label class="check-option"><input type="checkbox" name="days" value="<%= d[0] %>"><span><%= d[1] %></span></label><% }) %></div><small class="muted">Leave all unticked for every day.</small></div><label class="wide">Message<textarea name="content" rows="5" required placeholder="Good morning traders…"></textarea></label><button class="button wide">Create schedule</button></form></section><section class="panel"><h2>Active schedules</h2><div class="feed-list"><% scheduled.forEach(s=>{ %><div><strong><%= s.name %> <span class="pill <%= s.enabled?'on':'off' %>"><%= s.enabled?'On':'Paused' %></span></strong><small><%= s.cron_expression %> • <#<%= s.channel_id %>></small><div class="actions"><form method="post" action="/automation/scheduled/<%= s.id %>/toggle"><button class="ghost mini"><%= s.enabled?'Pause':'Resume' %></button></form><form method="post" action="/automation/scheduled/<%= s.id %>/delete" onsubmit="return confirm('Delete this schedule?')"><button class="danger mini">Delete</button></form></div></div><% }) %><% if(!scheduled.length){ %><p class="muted">No scheduled posts yet.</p><% } %></div></section></div><section class="panel"><h2>Giveaway history</h2><div class="table-wrap"><table><thead><tr><th>ID</th><th>Prize</th><th>Status</th><th>Ends</th><th>Winners</th></tr></thead><tbody><% giveaways.forEach(g=>{ %><tr><td>#<%= g.id %></td><td><strong><%= g.prize %></strong></td><td><span class="pill <%= g.status==='LIVE'?'on':'' %>"><%= g.status %></span></td><td><%= new Date(g.ends_at).toLocaleString('en-GB') %></td><td><%= (g.winners||[]).join(', ')||'—' %></td></tr><% }) %></tbody></table></div></section></main></body></html>