<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Message Studio • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control"><section class="topbar"><div><div class="crumb">Discord Control / Message Studio</div><h1>Message & role studio</h1><p>Build polished embeds, announcement templates, buttons, dropdowns and role panels without code.</p></div></section><% if(saved){ %><div class="notice">Saved or published successfully.</div><% } %>
<section class="grid two"><div class="panel"><div class="panel-head"><div><h2>New message template</h2><p>Reusable announcement, update or help panel.</p></div></div><form method="post" action="/control/studio/templates" class="form-grid"><label>Name<input name="name" required placeholder="Premium announcement"></label><label>Template type<select name="templateType"><option>announcement</option><option>server update</option><option>maintenance</option><option>event</option><option>giveaway</option><option>premium</option><option>help panel</option></select></label><label class="wide">Title<input name="title" placeholder="EAFC.Live Premium"></label><label class="wide">Body<textarea name="body" rows="5" required></textarea></label><label>Accent colour<input name="colour" placeholder="#27D7E8"></label><label>Mention role<select name="mentionRoleId"><option value="">Nobody</option><% roles.forEach(r=>{ %><option value="<%= r.id %>">@<%= r.name %></option><% }) %></select></label><label class="wide">Image URL<input name="imageUrl" placeholder="https://…"></label><label class="wide">Thumbnail URL<input name="thumbnailUrl" placeholder="https://…"></label>
<% [1,2,3].forEach(n=>{ %><label>Button <%= n %> label<input name="button<%= n %>Label"></label><label>Button <%= n %> URL<input name="button<%= n %>Url" placeholder="https://…"></label><label>Button <%= n %> role<select name="button<%= n %>Role"><option value="">No role action</option><% roles.forEach(r=>{ %><option value="<%= r.id %>">@<%= r.name %></option><% }) %></select></label><% }) %>
<label class="wide">Dropdown placeholder<input name="selectPlaceholder" placeholder="Choose an option"></label><% [1,2,3].forEach(n=>{ %><label>Option <%= n %> label<input name="option<%= n %>Label"></label><label>Option <%= n %> role<select name="option<%= n %>Role"><option value="">No role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>">@<%= r.name %></option><% }) %></select></label><label class="wide">Option <%= n %> reply<input name="option<%= n %>Response" placeholder="Optional private response"></label><% }) %><div class="wide"><button class="btn">Save template</button></div></form></div>
<div class="panel"><div class="panel-head"><div><h2>Saved templates</h2><p>Publish the same polished message anywhere.</p></div></div><div class="list"><% templates.forEach(t=>{ %><div class="row"><span class="row-main"><strong><%= t.name %></strong><small><%= t.template_type %> • updated <%= new Date(t.updated_at).toLocaleDateString('en-GB') %></small></span><span class="top-actions"><form method="post" action="/control/studio/templates/<%= t.id %>/publish" style="display:flex;gap:4px"><select name="channelId" required><option value="">Channel…</option><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>"># <%= c.name %></option><% }) %></select><button class="btn small">Publish</button></form><form method="post" action="/control/studio/templates/<%= t.id %>/delete"><button class="btn-danger small">Delete</button></form></span></div><% }) %></div></div></section>
<section class="grid two" style="margin-top:11px"><div class="panel"><div class="panel-head"><div><h2>Role panel builder</h2><p>Button or dropdown self-role panels.</p></div></div><form method="post" action="/control/studio/panels" class="form-grid"><label>Name<input name="name" required value="Member roles"></label><label>Channel<select name="channelId" required><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>"># <%= c.name %></option><% }) %></select></label><label>Style<select name="panelType"><option value="buttons">Buttons</option><option value="select">Dropdown</option></select></label><label><span>Publish immediately</span><input type="checkbox" name="publishNow"></label><label class="wide">Title<input name="title" value="Choose your roles"></label><label class="wide">Body<textarea name="body" rows="2">Use the controls below to manage your roles.</textarea></label><% [1,2,3,4,5].forEach(n=>{ %><label>Role <%= n %><select name="role<%= n %>Id"><option value="">None</option><% roles.forEach(r=>{ %><option value="<%= r.id %>">@<%= r.name %></option><% }) %></select></label><label>Label<input name="role<%= n %>Label" placeholder="Role label"></label><% }) %><div class="wide"><button class="btn">Create panel</button></div></form><div class="list" style="margin-top:10px"><% panels.forEach(p=>{ %><div class="row"><span class="row-main"><strong><%= p.name %></strong><small><%= p.panel_type %> • <%= p.message_id?'published':'draft' %></small></span><form method="post" action="/control/studio/panels/<%= p.id %>/publish"><button class="btn-secondary small">Publish</button></form></div><% }) %></div></div>
<div class="panel"><div class="panel-head"><div><h2>Reaction roles</h2><p>Traditional emoji → role mapping.</p></div></div><form method="post" action="/control/studio/reaction-role" class="form-grid"><label>Channel<select name="channelId"><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>"># <%= c.name %></option><% }) %></select></label><label>Message ID<input name="messageId" required></label><label>Emoji<input name="emoji" required value="⭐"></label><label>Role<select name="roleId"><% roles.forEach(r=>{ %><option value="<%= r.id %>">@<%= r.name %></option><% }) %></select></label><div class="wide"><button class="btn">Add reaction role</button></div></form><div class="list" style="margin-top:10px"><% reactions.forEach(r=>{ %><div class="row"><span class="row-main"><strong><%= r.emoji %> → <%= roles.find(x=>x.id===r.role_id)?.name||r.role_id %></strong><small>Message <%= r.message_id %></small></span><form method="post" action="/control/studio/reaction-role/delete"><input type="hidden" name="messageId" value="<%= r.message_id %>"><input type="hidden" name="emoji" value="<%= r.emoji %>"><button class="btn-danger small">Delete</button></form></div><% }) %></div></div></section>
</main></body></html>