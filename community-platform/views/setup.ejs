<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Setup • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"></head><body><aside class="sidebar"><a class="brand" href="/dashboard"><span>EAFC.Live</span> Control</a><nav><a href="/dashboard">Overview</a><a class="active" href="/setup">Setup</a><a href="/members">Members</a><a href="/analytics">Analytics</a><a href="/commands">Commands</a><a href="/automation">Automation</a><a href="/billing">Premium</a></nav></aside><main class="content narrow"><header><div><div class="eyebrow">SETUP</div><h1>Server setup</h1></div><div class="health-ring"><strong><%= health.score %>%</strong><span>ready</span></div></header><% if(saved){ %><div class="notice">✓ Setup updated</div><% } %><% if(message){ %><div class="notice">✓ <%= message %></div><% } %><% if(error){ %><div class="notice error-notice">⚠ <%= error %></div><% } %><section class="panel"><div class="section-head"><h2>Configuration</h2><span class="muted small"><%= health.checks.filter(c=>c.ok).length %>/<%= health.checks.length %> ready</span></div><div class="health-list"><% health.checks.forEach(c=>{ %><a class="health-item <%= c.ok?'good':'bad' %>" href="<%= c.href||'#' %>"><span class="health-icon"><%= c.ok?'✓':'!' %></span><span><%= c.label %></span><b><%= c.ok?'Ready':'Fix' %></b></a><% }) %></div></section><section class="panel compact-action"><div><h2>Quick setup</h2><p class="muted">Create any missing core roles, channels and bot links.</p></div><form method="post" action="/setup/quick" onsubmit="return confirm('Create any missing recommended roles/channels and connect the bot to them?')"><button class="button">Run setup</button></form></section><div class="two-col"><section class="panel"><div class="section-head"><h2>Test connections</h2></div><div class="actions wrap"><form method="post" action="/setup/test/welcome"><button class="ghost" type="submit">Welcome</button></form><form method="post" action="/setup/test/automod"><button class="ghost" type="submit">Mod log</button></form><form method="post" action="/setup/test/tickets"><button class="ghost" type="submit">Ticket log</button></form></div></section><section class="panel"><div class="section-head"><h2>Member roles</h2></div><div class="actions"><a class="ghost" href="/modules/role_menus">Configure</a><form method="post" action="/setup/publish-roles"><button class="button" type="submit">Publish</button></form></div></section></div></main></body></html>