<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Setup • FC27 Control</title><link rel="stylesheet" href="/style.css"></head><body><aside class="sidebar"><a class="brand" href="/dashboard"><span>FC27</span> Control</a><nav><a href="/dashboard">Overview</a><a class="active" href="/setup">Setup wizard</a><a href="/members">Members</a><a href="/analytics">Analytics</a><a href="/commands">Commands</a><a href="/automation">Automation</a><a href="/billing">Premium & billing</a></nav></aside><main class="content narrow"><header><div><div class="eyebrow">GUIDED SETUP</div><h1>Server setup</h1><p class="muted">Core connection and permission checks.</p></div><div class="health-ring"><strong><%= health.score %>%</strong><span>ready</span></div></header><% if(saved){ %><div class="notice">✓ Quick setup completed.</div><% } %><% if(message){ %><div class="notice">✓ <%= message %></div><% } %><% if(error){ %><div class="notice error-notice">⚠ <%= error %></div><% } %><section class="panel"><h2>Configuration health</h2><div class="health-list"><% health.checks.forEach(c=>{ %><a class="health-item" href="<%= c.href||'#' %>"><span class="health-icon <%= c.ok?'good':'bad' %>"><%= c.ok?'✓':'!' %></span><span><%= c.label %></span><b><%= c.ok?'Ready':'Fix this' %></b></a><% }) %></div></section><section class="panel hero-panel"><h2>Quick setup</h2><p class="muted">Creates any missing core roles, channels and logs. Existing matching items are reused.</p><form method="post" action="/setup/quick" onsubmit="return confirm('Create any missing recommended roles/channels and connect the bot to them?')"><button class="button">Run quick setup</button></form></section><div class="two-col"><section class="panel"><h2>Connection tests</h2><div class="actions wrap"><form method="post" action="/setup/test/welcome"><button class="ghost" type="submit">Test welcome</button></form><form method="post" action="/setup/test/automod"><button class="ghost" type="submit">Test mod log</button></form><form method="post" action="/setup/test/tickets"><button class="ghost" type="submit">Test ticket log</button></form></div></section><section class="panel"><h2>Member roles</h2><div class="actions"><a class="ghost" href="/modules/role_menus">Configure roles</a><form method="post" action="/setup/publish-roles"><button class="button" type="submit">Publish menus</button></form></div></section></div></main></body></html>