<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Insights • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control"><section class="topbar"><div><div class="crumb">Discord Control / Insights</div><h1>Community intelligence</h1><p>Retention, engagement, Premium, referrals and feature usage. Metrics that answer whether the server is actually working.</p></div></section><% if(saved){ %><div class="notice">Dashboard preferences saved.</div><% } %>
<section class="grid metrics"><div class="metric"><span>Joined</span><strong><%= funnel.joins||0 %></strong></div><div class="metric"><span>Verified</span><strong><%= funnel.verified||0 %></strong></div><div class="metric"><span>Activated</span><strong><%= funnel.activated||0 %></strong></div><div class="metric"><span>7-day retained</span><strong><%= funnel.retained7||0 %></strong></div><div class="metric"><span>Premium active</span><strong><%= premium.active||0 %></strong></div><div class="metric"><span>Premium churned</span><strong><%= premium.churned||0 %></strong></div></section>
<section class="grid two"><div class="panel"><div class="panel-head"><div><h2>New-member funnel</h2><p>Joined → verified → active → retained.</p></div></div><% const total=Math.max(1,Number(funnel.joins||0)); [['Joined',funnel.joins],['Verified',funnel.verified],['First activity',funnel.activated],['1-day retained',funnel.retained1],['7-day retained',funnel.retained7],['30-day retained',funnel.retained30]].forEach(x=>{ const pct=Math.round(Number(x[1]||0)/total*100); %><div class="row"><span class="row-main"><strong><%= x[0] %></strong><small><%= pct %>% of joins</small></span><strong><%= x[1]||0 %></strong></div><div class="statbar"><i style="width:<%= pct %>%"></i></div><% }) %></div>
<div class="panel"><div class="panel-head"><div><h2>Engagement</h2><p>Last 30 days where applicable.</p></div></div><div class="list"><div class="row"><span class="row-main"><strong>Kudos</strong></span><strong><%= engagement.kudos||0 %></strong></div><div class="row"><span class="row-main"><strong>Quest completions</strong></span><strong><%= engagement.quests||0 %></strong></div><div class="row"><span class="row-main"><strong>Active streaks</strong></span><strong><%= engagement.streaks||0 %></strong></div><div class="row"><span class="row-main"><strong>Giveaway entries</strong></span><strong><%= engagement.giveaway_entries||0 %></strong></div><div class="row"><span class="row-main"><strong>Premium conversions (30d)</strong></span><strong><%= premium.conversions30||0 %></strong></div><div class="row"><span class="row-main"><strong>Referral conversion</strong><small><%= referrals.clicks||0 %> checkout starts</small></span><strong><%= referrals.conversions||0 %></strong></div></div></div></section>
<section class="grid two" style="margin-top:11px"><div class="panel"><div class="panel-head"><div><h2>Most-used commands</h2><p>30-day usage.</p></div></div><% commands.forEach((x,n)=>{ %><div class="kudos-rank"><b>#<%= n+1 %></b><span><strong>/<%= x.feature_key %></strong><small><%= x.users %> unique users</small></span><strong><%= x.uses %></strong></div><% }) %></div><div class="panel"><div class="panel-head"><div><h2>Feature usage</h2><p>What members actually use.</p></div></div><% features.slice(0,20).forEach(x=>{ %><div class="row"><span class="row-main"><strong><%= x.feature_key %></strong><small><%= x.last_used?new Date(x.last_used).toLocaleDateString('en-GB'):'Never' %></small></span><strong><%= x.uses %></strong></div><% }) %></div></section>
<section class="grid two" style="margin-top:11px"><div class="panel"><div class="panel-head"><div><h2>Dead-feature detection</h2><p>Enabled features with no recorded usage in 30 days.</p></div></div><% dead.forEach(x=>{ %><div class="row"><span class="row-main"><strong><%= x.feature_key %></strong><small>No recorded usage</small></span><span class="pill warn">Review</span></div><% }) %><% if(!dead.length){ %><div class="empty">Nothing currently flagged.</div><% } %></div><div class="panel"><div class="panel-head"><div><h2>My dashboard widgets</h2><p>Choose what should matter most on your admin dashboard.</p></div></div><form method="post" action="/control/insights/widgets"><div class="check-grid"><% ['retention','kudos','premium','referrals','security','tickets','economy','giveaways','partners','feature_usage'].forEach(k=>{ %><label class="check"><input type="checkbox" name="widgets" value="<%= k %>" <%= widgets.some(w=>w.widget_key===k)?'checked':'' %>><span><%= k.replaceAll('_',' ') %></span></label><% }) %></div><button class="btn" style="margin-top:8px">Save dashboard</button></form></div></section>
</main></body></html>