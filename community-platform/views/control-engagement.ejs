<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Engagement • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control"><section class="topbar"><div><div class="crumb">Discord Control / Engagement</div><h1>Engagement</h1><p>Recognition, progression and rewards. No trading journal, calls or market tracking.</p></div><div class="top-actions"><a class="btn-secondary" href="/economy">Advanced economy</a></div></section><section class="grid three"><% [['reputation','Kudos','Member recognition'],['levels','Levels','XP and role milestones'],['giveaways','Giveaways','Community prizes'],['starboard','Starboard','Best community posts']].forEach(x=>{ const st=settings.get(x[0]); %><a class="feature-card" href="/modules/<%= x[0] %>"><h3><%= x[1] %></h3><p><%= x[2] %></p><div class="meta"><span class="pill <%= st?.enabled===false?'bad':'good' %>"><%= st?.enabled===false?'Off':'Active' %></span><span>Configure →</span></div></a><% }) %></section><section class="grid two" style="margin-top:11px"><div class="panel"><div class="panel-head"><div><h2>Kudos leaderboard</h2><p>Most recognised members.</p></div></div><% topKudos.forEach((k,n)=>{ %><div class="kudos-rank"><b>#<%= n+1 %></b><span><strong><%= k.name %></strong><small>Recognition received</small></span><strong><%= Number(k.thanks_received||0) %></strong></div><% }) %></div><div class="panel"><div class="panel-head"><div><h2><%= season?.name||'Current season' %></h2><p>XP and rewards cycle.</p></div></div><div class="list"><div class="row"><span class="row-main"><strong><%= quests.length %> active quests</strong><small>Daily, weekly and seasonal goals</small></span></div><div class="row"><span class="row-main"><strong><%= store.filter(s=>s.active).length %> store rewards</strong><small>Spendable Live Coin rewards</small></span></div><div class="row"><span class="row-main"><strong><%= achievements %> achievements unlocked</strong><small>Across the community</small></span></div></div></div></section></main></body></html>