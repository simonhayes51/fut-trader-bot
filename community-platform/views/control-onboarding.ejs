<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Onboarding • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control">
<section class="topbar"><div><div class="crumb">Discord Control / Onboarding</div><h1>Onboarding & identity</h1><p>Verification, member profiles, birthdays, counting and server counters.</p></div></section><% if(saved){ %><div class="notice">Saved.</div><% } %>
<section class="grid two"><div class="panel"><div class="panel-head"><div><h2>Onboarding wizard</h2><p>Verify members and collect platform/interests.</p></div></div><form method="post" action="/control/onboarding" class="form-grid">
<label class="wide">Onboarding channel<select name="channelId"><option value="">Choose channel</option><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>" <%= onboarding.channel_id===c.id?'selected':'' %>># <%= c.name %></option><% }) %></select></label>
<label>Verified role<select name="verifiedRoleId"><option value="">No role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= onboarding.verified_role_id===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label>
<label>Quarantine role<select name="quarantineRoleId"><option value="">No quarantine role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= onboarding.quarantine_role_id===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label>
<label>Minimum account age (hours)<input name="minAccountAgeHours" type="number" min="0" value="<%= onboarding.min_account_age_hours??24 %>"></label>
<label class="wide">Panel title<input name="welcomeTitle" value="<%= onboarding.welcome_title||'Welcome to EAFC.Live' %>"></label><label class="wide">Panel text<textarea name="welcomeBody" rows="3"><%= onboarding.welcome_body||'' %></textarea></label>
<% [['PlayStation','PlayStation'],['Xbox','Xbox'],['PC','PC']].forEach(([key,label])=>{ %><label><%= label %> role<select name="platform_<%= key %>"><option value="">No role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= onboarding.platform_roles?.[label]===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label><% }) %>
<% [['EAFCLive','EAFC.Live'],['UltimateTeam','Ultimate Team'],['SBCsObjectives','SBCs & Objectives'],['Gameplay','Gameplay'],['Community','Community']].forEach(([field,label])=>{ %><label><%= label %> interest role<select name="interest_<%= field %>"><option value="">No role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= onboarding.interest_roles?.[label]===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label><% }) %>
<div class="wide top-actions"><button class="btn">Save onboarding</button></div></form><form method="post" action="/control/onboarding/publish" style="margin-top:8px"><input type="hidden" name="channelId" value="<%= onboarding.channel_id||'' %>"><button class="btn-secondary" <%= onboarding.channel_id?'':'disabled' %>>Publish onboarding panel</button></form></div>
<div class="panel"><div class="panel-head"><div><h2>Birthdays</h2><p>Opt-in birthday role, announcement and reward.</p></div></div><form method="post" action="/control/onboarding/birthday" class="form-grid"><label><span>Enabled</span><input name="enabled" type="checkbox" <%= birthday.enabled?'checked':'' %>></label><label>Announcement channel<select name="channelId"><option value="">No announcement</option><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>" <%= birthday.config.channelId===c.id?'selected':'' %>># <%= c.name %></option><% }) %></select></label><label>Birthday role<select name="roleId"><option value="">No role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= birthday.config.roleId===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label><label>XP reward<input name="xpReward" type="number" min="0" value="<%= birthday.config.xpReward??50 %>"></label><label>Live Coins<input name="coinReward" type="number" min="0" value="<%= birthday.config.coinReward??100 %>"></label><div class="wide"><button class="btn">Save birthday settings</button></div></form></div></section>
<section class="grid two" style="margin-top:11px"><div class="panel"><div class="panel-head"><div><h2>Counting channel</h2><p>Anti-cheat counting with milestone rewards.</p></div></div><form method="post" action="/control/onboarding/counting" class="form-grid"><label><span>Enabled</span><input name="enabled" type="checkbox" <%= counting.enabled?'checked':'' %>></label><label>Channel<select name="channelId"><option value="">Choose channel</option><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>" <%= counting.channel_id===c.id?'selected':'' %>># <%= c.name %></option><% }) %></select></label><label>Next number<input name="nextNumber" type="number" min="1" value="<%= counting.next_number??1 %>"></label><label>Reward every<input name="rewardEvery" type="number" min="0" value="<%= counting.reward_every??100 %>"></label><div class="wide"><button class="btn">Save counting</button></div></form></div>
<div class="panel"><div class="panel-head"><div><h2>Server counters</h2><p>Auto-updating voice-channel style counters.</p></div></div><form method="post" action="/control/onboarding/counters" class="form-grid"><label>Channel<select name="channelId" required><option value="">Choose channel</option><% channels.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><label>Metric<select name="metric"><option value="members">Members</option><option value="online">Online</option><option value="premium">Premium</option><option value="boosters">Boosters</option><option value="verified">Verified</option></select></label><label class="wide">Channel name template<input name="label" value="Members: {count}"></label><div class="wide"><button class="btn">Add counter</button></div></form><div class="list" style="margin-top:10px"><% counters.forEach(c=>{ %><div class="row"><span class="row-main"><strong><%= c.label %></strong><small><%= c.metric %></small></span><form method="post" action="/control/onboarding/counters/<%= c.id %>/delete"><button class="btn-danger small">Delete</button></form></div><% }) %></div></div></section>
</main></body></html>