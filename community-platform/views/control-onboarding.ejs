<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Onboarding • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control">
<section class="topbar"><div><div class="crumb">Discord Control / Onboarding</div><h1>New member experience</h1><p>Set up verification and member roles. Birthday rewards, counting and server counters are separate tools below.</p></div></section><% if(error){ %><div class="notice error-notice" role="alert"><strong>Check these settings</strong><br><%= error %></div><% } %><% if(saved){ %><div class="notice" role="status">Onboarding settings saved.</div><% } %><% if(published){ %><div class="notice" role="status">Onboarding panel published to Discord.</div><% } %>
<section class="grid two"><div class="panel"><div class="panel-head"><div><h2>Onboarding wizard</h2><p>Verify members and collect platform/interests.</p></div></div><form method="post" action="/control/onboarding" class="form-grid">
<label class="wide">Onboarding channel<select name="channelId"><option value="">Choose channel</option><% channels.filter(c=>c.type!==4&&c.type!==2).forEach(c=>{ %><option value="<%= c.id %>" <%= onboarding.channel_id===c.id?'selected':'' %>># <%= c.name %></option><% }) %></select></label>
<label>Verified role<select name="verifiedRoleId"><option value="">No role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= onboarding.verified_role_id===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label>
<label>Quarantine role<select name="quarantineRoleId"><option value="">No quarantine role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= onboarding.quarantine_role_id===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label>
<label>Minimum account age (hours)<input name="minAccountAgeHours" type="number" min="0" value="<%= onboarding.min_account_age_hours??24 %>"></label>
<label class="wide">Panel title<input name="welcomeTitle" value="<%= onboarding.welcome_title||'Welcome to EAFC.Live' %>"></label><label class="wide">Panel text<textarea name="welcomeBody" rows="3"><%= onboarding.welcome_body||'' %></textarea></label>
<% [['PlayStation','PlayStation'],['Xbox','Xbox'],['PC','PC']].forEach(([key,label])=>{ %><label><%= label %> role<select name="platform_<%= key %>"><option value="">No role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= onboarding.platform_roles?.[label]===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label><% }) %>
<% [['EAFCLive','EAFC.Live'],['UltimateTeam','Ultimate Team'],['SBCsObjectives','SBCs & Objectives'],['Gameplay','Gameplay'],['Community','Community']].forEach(([field,label])=>{ %><label><%= label %> interest role<select name="interest_<%= field %>"><option value="">No role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= onboarding.interest_roles?.[label]===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label><% }) %>
<% ['Announcements','Giveaways','Events','Premium'].forEach(label=>{ %><label><%= label %> notification role<select name="notification_<%= label %>"><option value="">No role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= onboarding.notification_roles?.[label]===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label><% }) %>
<label class="wide">Optional join questions <small>One question per line, maximum five.</small><textarea name="questions" rows="5" placeholder="How did you find us?&#10;What do you want from the community?"><%= (onboarding.questions||[]).map(q=>q.label||q.question||'').join('\n') %></textarea></label>
<div class="wide top-actions"><button class="btn">Save onboarding</button></div></form><form method="post" action="/control/onboarding/publish" style="margin-top:8px"><input type="hidden" name="channelId" value="<%= onboarding.channel_id||'' %>"><button class="btn-secondary" <%= onboarding.channel_id?'':'disabled' %>>Publish onboarding panel</button></form></div>
<div class="panel"><div class="panel-head"><div><h2>Birthdays</h2><p>Opt-in birthday role, announcement and reward.</p></div></div><form method="post" action="/control/onboarding/birthday" class="form-grid"><label><span>Enabled</span><input name="enabled" type="checkbox" <%= birthday.enabled?'checked':'' %>></label><label>Announcement channel<select name="channelId"><option value="">No announcement</option><% channels.filter(c=>c.type!==4&&c.type!==2).forEach(c=>{ %><option value="<%= c.id %>" <%= birthday.config.channelId===c.id?'selected':'' %>># <%= c.name %></option><% }) %></select></label><label>Birthday role<select name="roleId"><option value="">No role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= birthday.config.roleId===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label><label>XP reward<input name="xpReward" type="number" min="0" value="<%= birthday.config.xpReward??50 %>"></label><label>Live Coins<input name="coinReward" type="number" min="0" value="<%= birthday.config.coinReward??100 %>"></label><div class="wide"><button class="btn">Save birthday settings</button></div></form></div></section>
<section class="grid two" style="margin-top:11px"><div class="panel"><div class="panel-head"><div><h2>Counting channel</h2><p>Anti-cheat counting with milestone rewards.</p></div></div><form method="post" action="/control/onboarding/counting" class="form-grid"><label><span>Enabled</span><input name="enabled" type="checkbox" <%= counting.enabled?'checked':'' %>></label><label>Channel<select name="channelId"><option value="">Choose channel</option><% channels.filter(c=>c.type!==4&&c.type!==2).forEach(c=>{ %><option value="<%= c.id %>" <%= counting.channel_id===c.id?'selected':'' %>># <%= c.name %></option><% }) %></select></label><label>Next number<input name="nextNumber" type="number" min="1" value="<%= counting.next_number??1 %>"></label><label>Reward every<input name="rewardEvery" type="number" min="0" value="<%= counting.reward_every??100 %>"></label><div class="wide"><button class="btn">Save counting</button></div></form></div>
<div class="panel"><div class="panel-head"><div><h2>Server counters</h2><p>Auto-updating voice-channel names. Use {count} where the number should appear.</p></div></div><form method="post" action="/control/onboarding/counters" class="form-grid"><label>Voice channel<select name="channelId" required><option value="">Choose voice channel</option><% channels.filter(c=>c.type===2).forEach(c=>{ %><option value="<%= c.id %>" <%= counterDraft.channelId===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>What to count<select name="metric"><% [['members','Members'],['online','Online'],['premium','Premium'],['boosters','Boosters'],['verified','Verified']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= (counterDraft.metric||'members')===value?'selected':'' %>><%= label %></option><% }) %></select></label><label class="wide">Channel name template<input name="label" maxlength="100" required value="<%= counterDraft.label||'Members: {count}' %>"><small>Include <code>{count}</code> exactly once.</small></label><div class="wide"><button class="btn">Save counter</button></div></form><div class="list" style="margin-top:10px"><% if(!counters.length){ %><div class="empty">No live counters yet. Choose a voice channel above to create one.</div><% } %><% counters.forEach(c=>{ %><div class="row"><span class="row-main"><strong><%= c.label %></strong><small><%= c.metric %></small></span><form method="post" action="/control/onboarding/counters/<%= c.id %>/delete"><button class="btn-danger small" type="submit">Delete</button></form></div><% }) %></div></div></section>
</main></body></html>
