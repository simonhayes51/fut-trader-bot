<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Features • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control"><section class="topbar"><div><div class="crumb">Discord Control / Features</div><h1>Features</h1><p>Everything this bot owns. Trading and market tools are intentionally excluded.</p></div><div class="top-actions"><a class="btn-secondary" href="/commands">Command access</a></div></section><section class="feature-grid"><% modules.forEach(m=>{ const on=m.state?.enabled!==false; %><a class="feature-card" href="/modules/<%= m.key %>"><div class="meta"><span class="pill"><%= m.category %></span><span class="pill <%= on?'good':'bad' %>"><%= on?'Active':'Off' %></span></div><h3><%= m.name %></h3><p><%= m.description %></p><div class="meta"><span><%= m.fields.length %> settings</span><span>Configure →</span></div></a><% }) %></section></main></body></html>