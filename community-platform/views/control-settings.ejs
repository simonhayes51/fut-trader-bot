<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Features • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control"><section class="topbar"><div><div class="crumb">Discord Control / Features</div><h1>Features</h1><p>Everything this bot owns. Trading and market tools are intentionally excluded.</p></div><div class="top-actions"><a class="btn" href="/branding">Branding</a><a class="btn-secondary" href="/commands">Command access</a></div></section><section class="feature-grid"><% modules.forEach(m=>{ const on=m.state?.enabled!==false; %><a class="feature-card" href="/modules/<%= m.key %>"><div class="meta"><span class="pill"><%= m.category %></span><span class="pill <%= on?'good':'bad' %>"><%= on?'Active':'Off' %></span></div><h3><%= m.name %></h3><p><%= m.description %></p><div class="meta"><span><%= m.fields.length %> settings</span><span>Configure →</span></div></a><% }) %></section>
<% if (botRemoved) { %><section class="panel" style="margin-top:18px;border-color:var(--green,#22c55e)"><strong>Bot removed from the selected server.</strong><p>The bot left that server. Channels, messages, and saved configuration were not deleted, and the bot remains available to other servers.</p></section><% } %>
<% if (guild) { %><section class="panel" style="margin-top:18px;border-color:var(--red,#ef4444)"><div class="panel-head"><div><span class="pill bad">Server access</span><h2>Remove EAFC.Live from <%= guild.name %></h2><p>This makes the command bot leave this server only. It does not delete channels, messages, or saved settings, and does not affect other servers.</p></div></div><form method="post" action="/control/settings/remove-bot" onsubmit="return confirm('Make EAFC.Live leave this server? No server content will be deleted.');"><input type="hidden" name="guildId" value="<%= guild.id %>"><label style="display:block;margin:12px 0">Type <strong><%= guild.name %></strong> to confirm<input name="confirmation" required autocomplete="off" placeholder="Server name" style="display:block;width:100%;max-width:420px;margin-top:6px"></label><button class="btn-danger" type="submit">Remove bot from server</button></form></section><% } %>
</main></body></html>
