<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= def.name %> • FC27 Control</title><link rel="stylesheet" href="/style.css"></head><body>
<aside class="sidebar"><a class="brand" href="/dashboard"><span>FC27</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/trading">Trade calls</a><a href="/tickets">Tickets</a><a href="/social">Social feeds</a><a href="/billing">Premium & billing</a><a href="/moderation">Moderation</a><a href="/audit">Audit log</a></nav></aside>
<main class="content narrow">
  <a class="back" href="/dashboard">← Back to overview</a>
  <header><div><div class="eyebrow"><%= def.category.toUpperCase() %></div><h1><%= def.name %></h1><p class="muted"><%= def.description %></p></div></header>
  <% if (typeof saved !== 'undefined') { %><div class="notice">✓ Saved. Your changes are live.</div><% } %>

  <form method="post" class="panel setup-panel" id="module-form">
    <label class="toggle-row module-master"><div><strong>Turn <%= def.name %> on</strong><small>Switch this off to pause the feature without losing your setup.</small></div><input type="checkbox" name="enabled" <%= enabled?'checked':'' %>></label>
    <hr>
    <div class="settings-title"><div><h2>Set it up</h2><p class="muted">Pick from your real Discord channels and roles. No IDs, JSON or code.</p></div></div>
    <div class="settings-grid">
      <% def.fields.forEach(field=>{ const value=current[field.key] ?? def.defaults[field.key]; %>
        <% if(field.type==='toggle'){ %>
          <label class="setting-card toggle-setting"><div><strong><%= field.label %></strong><small><%= field.help||'' %></small></div><input class="config-input" data-key="<%= field.key %>" data-type="boolean" type="checkbox" <%= value?'checked':'' %>></label>

        <% } else if(field.type==='number'){ %>
          <label class="setting-field"><span><%= field.label %></span><small><%= field.help||'' %></small><input class="config-input" data-key="<%= field.key %>" data-type="number" type="number" value="<%= value ?? 0 %>" <%= field.min!==undefined?`min="${field.min}"`:'' %> <%= field.max!==undefined?`max="${field.max}"`:'' %> <%= field.step!==undefined?`step="${field.step}"`:'' %>></label>

        <% } else if(field.type==='channel'){ %>
          <label class="setting-field"><span><%= field.label %></span><small><%= field.help||'' %></small><select class="config-input" data-key="<%= field.key %>" data-type="string"><option value="">None / not set</option><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>" <%= String(value||'')===c.id?'selected':'' %>># <%= c.name %></option><% }) %></select></label>

        <% } else if(field.type==='category'){ %>
          <label class="setting-field"><span><%= field.label %></span><small><%= field.help||'' %></small><select class="config-input" data-key="<%= field.key %>" data-type="string"><option value="">None / not set</option><% channels.filter(c=>c.type===4).forEach(c=>{ %><option value="<%= c.id %>" <%= String(value||'')===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label>

        <% } else if(field.type==='role'){ %>
          <label class="setting-field"><span><%= field.label %></span><small><%= field.help||'' %></small><select class="config-input" data-key="<%= field.key %>" data-type="string"><option value="">None / not set</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= String(value||'')===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label>

        <% } else if(field.type==='roles'){ %>
          <label class="setting-field wide"><span><%= field.label %></span><small><%= field.help||'' %></small><div class="check-picker config-input" data-key="<%= field.key %>" data-type="checkbox-array"><% roles.forEach(r=>{ %><label class="check-option"><input type="checkbox" value="<%= r.id %>" <%= Array.isArray(value)&&value.includes(r.id)?'checked':'' %>><span>@<%= r.name %></span></label><% }) %></div></label>

        <% } else if(field.type==='channels'){ %>
          <label class="setting-field wide"><span><%= field.label %></span><small><%= field.help||'' %></small><div class="check-picker config-input" data-key="<%= field.key %>" data-type="checkbox-array"><% channels.filter(c=>c.type!==4).forEach(c=>{ %><label class="check-option"><input type="checkbox" value="<%= c.id %>" <%= Array.isArray(value)&&value.includes(c.id)?'checked':'' %>><span># <%= c.name %></span></label><% }) %></div></label>

        <% } else if(field.type==='select'){ %>
          <label class="setting-field"><span><%= field.label %></span><small><%= field.help||'' %></small><select class="config-input" data-key="<%= field.key %>" data-type="string"><% (field.options||[]).forEach(o=>{ %><option value="<%= o.value %>" <%= String(value)===o.value?'selected':'' %>><%= o.label %></option><% }) %></select></label>

        <% } else if(field.type==='textarea'){ %>
          <label class="setting-field wide"><span><%= field.label %></span><small><%= field.help||'' %></small><textarea class="config-input" data-key="<%= field.key %>" data-type="string" rows="5" placeholder="<%= field.placeholder||'' %>"><%= value||'' %></textarea></label>

        <% } else if(field.type==='list'){ %>
          <label class="setting-field wide"><span><%= field.label %></span><small><%= field.help||'' %></small><textarea class="config-input" data-key="<%= field.key %>" data-type="array-lines" rows="6" placeholder="<%= field.placeholder||'One item per line' %>"><%= Array.isArray(value)?value.join('\n'):'' %></textarea></label>

        <% } else if(field.type==='roleGroups'){ const groups=Array.isArray(value)?value:[]; %>
          <div class="setting-field wide"><span><%= field.label %></span><small><%= field.help||'' %></small>
            <div id="role-groups" class="repeater config-input" data-key="<%= field.key %>" data-type="role-groups">
              <% groups.forEach((g,idx)=>{ %><div class="repeater-row role-group-row"><div class="row-head"><strong>Group <span class="row-number"><%= idx+1 %></span></strong><button type="button" class="danger mini remove-row">Remove</button></div><div class="form-grid"><label>Group name<input class="rg-name" value="<%= g.name||'' %>" placeholder="Platform"></label><label>How many can members choose?<select class="rg-max"><option value="1" <%= Number(g.maxSelect||1)===1?'selected':'' %>>One role</option><option value="99" <%= Number(g.maxSelect||1)>1?'selected':'' %>>Multiple roles</option></select></label></div><div class="check-picker"><% roles.forEach(r=>{ %><label class="check-option"><input class="rg-role" type="checkbox" value="<%= r.id %>" <%= Array.isArray(g.roleIds)&&g.roleIds.includes(r.id)?'checked':'' %>><span>@<%= r.name %></span></label><% }) %></div></div><% }) %>
            </div><button type="button" class="ghost add-row" id="add-role-group">+ Add role group</button>
          </div>

        <% } else if(field.type==='rewards'){ const rewards=Array.isArray(value)?value:[]; %>
          <div class="setting-field wide"><span><%= field.label %></span><small><%= field.help||'' %></small>
            <div id="reward-rows" class="repeater config-input" data-key="<%= field.key %>" data-type="rewards">
              <% rewards.forEach((reward,idx)=>{ %><div class="repeater-row reward-row"><div class="row-head"><strong>Reward <span class="row-number"><%= idx+1 %></span></strong><button type="button" class="danger mini remove-row">Remove</button></div><div class="form-grid"><label>XP needed<input class="reward-xp" type="number" min="0" value="<%= reward.xp||0 %>"></label><label>Role to award<select class="reward-role"><option value="">Choose role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= String(reward.roleId||'')===r.id?'selected':'' %>>@<%= r.name %></option><% }) %></select></label></div></div><% }) %>
            </div><button type="button" class="ghost add-row" id="add-reward">+ Add reward</button>
          </div>

        <% } else { %>
          <label class="setting-field"><span><%= field.label %></span><small><%= field.help||'' %></small><input class="config-input" data-key="<%= field.key %>" data-type="string" type="text" value="<%= value||'' %>" placeholder="<%= field.placeholder||'' %>"></label>
        <% } %>
      <% }) %>
    </div>
    <textarea name="config" id="config-output" hidden></textarea>
    <div class="form-actions sticky-save"><button class="button" type="submit">Save changes</button><span class="muted">That’s it. No other setup is needed on this page.</span></div>
  </form>
</main>

<template id="role-group-template"><div class="repeater-row role-group-row"><div class="row-head"><strong>New role group</strong><button type="button" class="danger mini remove-row">Remove</button></div><div class="form-grid"><label>Group name<input class="rg-name" placeholder="Platform"></label><label>How many can members choose?<select class="rg-max"><option value="1">One role</option><option value="99">Multiple roles</option></select></label></div><div class="check-picker"><% roles.forEach(r=>{ %><label class="check-option"><input class="rg-role" type="checkbox" value="<%= r.id %>"><span>@<%= r.name %></span></label><% }) %></div></div></template>
<template id="reward-template"><div class="repeater-row reward-row"><div class="row-head"><strong>New reward</strong><button type="button" class="danger mini remove-row">Remove</button></div><div class="form-grid"><label>XP needed<input class="reward-xp" type="number" min="0" value="100"></label><label>Role to award<select class="reward-role"><option value="">Choose role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>">@<%= r.name %></option><% }) %></select></label></div></div></template>
<script>
function bindRemove(root=document){root.querySelectorAll('.remove-row').forEach(b=>{if(b.dataset.bound)return;b.dataset.bound='1';b.addEventListener('click',()=>b.closest('.repeater-row').remove())})}
bindRemove();
const addRoleGroup=document.getElementById('add-role-group');if(addRoleGroup)addRoleGroup.addEventListener('click',()=>{const host=document.getElementById('role-groups');host.append(document.getElementById('role-group-template').content.cloneNode(true));bindRemove(host)});
const addReward=document.getElementById('add-reward');if(addReward)addReward.addEventListener('click',()=>{const host=document.getElementById('reward-rows');host.append(document.getElementById('reward-template').content.cloneNode(true));bindRemove(host)});

document.getElementById('module-form').addEventListener('submit',()=>{
  const out={};
  document.querySelectorAll('.config-input').forEach(el=>{
    const key=el.dataset.key,type=el.dataset.type;
    if(type==='boolean') out[key]=el.checked;
    else if(type==='number') out[key]=Number(el.value||0);
    else if(type==='array-lines') out[key]=el.value.split(/\n/).map(v=>v.trim()).filter(Boolean);
    else if(type==='checkbox-array') out[key]=Array.from(el.querySelectorAll('input:checked')).map(x=>x.value);
    else if(type==='role-groups') out[key]=Array.from(el.querySelectorAll('.role-group-row')).map(row=>({name:row.querySelector('.rg-name').value.trim(),maxSelect:Number(row.querySelector('.rg-max').value),roleIds:Array.from(row.querySelectorAll('.rg-role:checked')).map(x=>x.value)})).filter(g=>g.name&&g.roleIds.length);
    else if(type==='rewards') out[key]=Array.from(el.querySelectorAll('.reward-row')).map(row=>({xp:Number(row.querySelector('.reward-xp').value||0),roleId:row.querySelector('.reward-role').value})).filter(r=>r.roleId);
    else out[key]=el.value;
  });
  document.getElementById('config-output').value=JSON.stringify(out);
});
</script></body></html>
