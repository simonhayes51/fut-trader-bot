<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= def.name %> • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"></head><body>
<aside class="sidebar"><a class="brand" href="/dashboard"><span>EAFC.Live</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/trading">Trade calls</a><a href="/tickets">Tickets</a><a href="/social">Social feeds</a><a href="/billing">Premium</a><a href="/moderation">Moderation</a><a href="/audit">Audit log</a></nav></aside>
<main class="content saas-page module-workspace">
  <a class="back" href="/dashboard">← Back to overview</a>
  <section class="page-hero compact"><div><div class="eyebrow">SYSTEM / <%= def.category.toUpperCase() %></div><h1><%= def.name %></h1><p><%= def.description %></p></div><div class="hero-actions"><span class="pill <%= enabled?'on':'off' %>"><%= enabled?'Active':'Disabled' %></span></div></section>
  <% if (typeof saved !== 'undefined' && saved) { %><div class="notice">✓ <%= ['role_menus','tickets'].includes(def.key) ? 'Saved & published to Discord' : 'Saved' %></div><% } %>
  <% if (typeof publishError !== 'undefined' && publishError) { %><div class="notice error-notice">⚠ <%= publishError %></div><% } %>

  <form method="post" class="panel setup-panel module-config-card" id="module-form">
    <label class="toggle-row module-master"><div><strong>Turn this feature on</strong><small>Switch it off to pause it. Your settings will stay saved.</small></div><input type="checkbox" name="enabled" <%= enabled?'checked':'' %>></label>
    <hr>
    <aside class="module-live-preview" aria-label="Live feature preview">
      <div class="preview-heading"><span><span class="preview-step">03</span><span class="preview-title-wrap"><strong>See what members see</strong><small>Preview it before you publish.</small></span></span><span class="pill good" id="preview-status"><%= enabled?'Ready':'Paused' %></span></div>
      <div class="discord-preview" id="discord-preview" style="--preview-accent:<%= /^#[0-9a-f]{6}$/i.test(current.primaryColour||'')?current.primaryColour:'#8f67ee' %>">
        <div class="discord-preview-brand"><span class="preview-avatar">E</span><span><strong id="preview-brand"><%= current.name||guild?.name||'EAFC.Live' %></strong><small>BOT · COMMUNITY</small></span></div>
        <div class="discord-preview-body"><span class="preview-category"><%= def.category %></span><h3 id="preview-title"><%= def.name %></h3><p id="preview-message"><%= current.message||def.description %></p>
          <% if(def.key==='role_menus'){ %><div class="preview-role-list" id="preview-role-list"><% (current.groups||[]).slice(0,3).forEach(group=>{ %><span><%= group.name||'Role group' %><b>›</b></span><% }) %><% if(!(current.groups||[]).length){ %><span>Role groups appear here<b>›</b></span><% } %></div><% } else if(def.key==='welcome'){ %><div class="preview-placeholder">👋 &nbsp; Welcome {user} to {server}!</div><% } else if(def.key==='server_branding'){ %><div class="preview-brand-strip"></div><% } else { %><div class="preview-placeholder"><span class="preview-dot"></span><%= def.category %> feature is ready to configure</div><% } %>
        </div>
        <div class="preview-footer">EAFC.Live · Discord community</div>
      </div>
      <div class="preview-destination"><span class="destination-icon">#</span><span><small>ROLE MENU CHANNEL</small><strong id="preview-channel"><%= current.channelId ? '# '+(channels.find(c=>c.id===current.channelId)?.name||'Selected channel') : 'Choose a channel above' %></strong></span></div>
      <p class="preview-hint">This is the message members will use. Changes appear here as you edit.</p>
      <div class="preview-checklist"><span><i>✓</i> Bot connected</span><span><i class="<%= enabled?'':'paused-check' %>"><%= enabled?'✓':'Ⅱ' %></i> <%= enabled?'Feature enabled':'Feature paused' %></span></div>
    </aside>
    <% const settingTypes=new Set(['channel','category','role','select','number','toggle']); const settingsFields=def.fields.filter(field=>settingTypes.has(field.type)); const builderFields=def.fields.filter(field=>!settingTypes.has(field.type)); %>
    <div class="module-editor-layout">
      <section class="editor-pane settings-pane">
        <div class="editor-pane-heading"><span class="editor-step">01</span><span><strong><%= def.key==='role_menus'?'Choose where members find it':def.key==='tickets'?'Choose where tickets go':def.key==='welcome'?'Choose where welcomes go':'Set the rules for this feature' %></strong><small><%= def.key==='role_menus'?'Pick the Discord channel where your role menu will appear.':def.key==='tickets'?'Choose where members open tickets and where staff see logs.':def.key==='welcome'?'Choose the channel and role used for new members.':'Choose the channels, roles and limits this feature should use.' %></small></span></div>
        <div class="settings-grid"><% if(settingsFields.length){ %><%- include('partials/module-fields',{fields:settingsFields,current,def,channels,roles,discordIconUrl:typeof discordIconUrl!=='undefined'?discordIconUrl:null}) %><% }else{ %><div class="editor-empty">This feature has no server destination or thresholds. Its controls are in the builder.</div><% } %></div>
      </section>
      <section class="editor-pane builder-pane">
        <div class="editor-pane-heading"><span class="editor-step">02</span><span><strong><%= def.key==='role_menus'?'Build the role menu':def.key==='tickets'?'Build your ticket panels':def.key==='welcome'?'Write the welcome message':def.key==='server_branding'?'Set your server branding':'Set up this feature' %></strong><small><%= def.key==='role_menus'?'Add groups, then choose which Discord roles belong in each group.':def.key==='tickets'?'Create the buttons and choices members use to contact your team.':def.key==='welcome'?'Write what new members will see when they join.':def.key==='server_branding'?'Choose the name, colours and images used by the bot.':'Fill in these options to decide how this feature works.' %></small></span></div>
        <div class="settings-grid"><% if(builderFields.length){ %><%- include('partials/module-fields',{fields:builderFields,current,def,channels,roles,discordIconUrl:typeof discordIconUrl!=='undefined'?discordIconUrl:null}) %><% }else{ %><div class="editor-empty">This feature uses settings only. There is no message or panel to build.</div><% } %></div>
      </section>
    </div>
    <textarea name="config" id="config-output" hidden></textarea>
    <div class="form-actions sticky-save"><span class="save-caption" id="save-caption"><%= def.key==='role_menus'?'Saving will publish this menu to '+(current.channelId?'# '+(channels.find(c=>c.id===current.channelId)?.name||'your selected channel'):'the channel you choose above')+'.':'Changes apply to '+(guild?.name||'the selected server')+'.' %></span><button class="button" id="save-button" type="submit"><%= ['role_menus','tickets'].includes(def.key) ? 'Save & publish' : 'Save changes' %></button></div>
  </form>
</main>
<template id="ticket-panel-template"><div class="repeater-row ticket-panel-row"><div class="row-head"><strong>New panel</strong><button type="button" class="danger mini remove-row">Remove</button></div><label class="toggle-row"><div><strong>Enabled</strong><small>Publish this panel when saving.</small></div><input class="tp-enabled" type="checkbox" checked></label><div class="form-grid"><label>Panel ID<input class="tp-id" placeholder="applications"></label><label>Panel name<input class="tp-name" placeholder="Staff Applications"></label><label>Post panel into<select class="tp-channel"><option value="">Choose channel</option><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>"># <%= c.name %></option><% }) %></select></label><label>Ticket category<select class="tp-category"><option value="">Choose category</option><% channels.filter(c=>c.type===4).forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label></div><label><span>Dropdown options</span><small>One per line.</small><textarea class="tp-types" rows="4" placeholder="Support&#10;Question&#10;Other"></textarea></label><div><span>Ticket staff</span><div class="check-picker"><% roles.forEach(r=>{ %><label class="check-option"><input class="tp-staff" type="checkbox" value="<%= r.id %>"><span>@<%= r.name %></span></label><% }) %></div></div></div></template>
<template id="role-group-template"><div class="repeater-row role-group-row"><div class="row-head"><strong>New role group</strong><button type="button" class="danger mini remove-row">Remove group</button></div><div class="form-grid"><label>Name shown to members<small>Example: Platform or Interests.</small><input class="rg-name" placeholder="For example, Platform"></label><label>How many roles can they pick?<small>Choose one, or let them choose several.</small><select class="rg-max"><option value="1">One role only</option><option value="99">As many as they want</option></select></label></div><div class="role-picker-label"><strong>Which roles can members choose?</strong><small>Tick each Discord role you want in this group.</small></div><% if(roles.length){ %><div class="check-picker"><% roles.forEach(r=>{ %><label class="check-option"><input class="rg-role" type="checkbox" value="<%= r.id %>"><span>@<%= r.name %></span></label><% }) %></div><% }else{ %><div class="role-group-empty compact-empty">No Discord roles were found. Add roles in your server settings, then reload this page.</div><% } %></div></template>
<template id="reward-template"><div class="repeater-row reward-row"><div class="row-head"><strong>New reward</strong><button type="button" class="danger mini remove-row">Remove</button></div><div class="form-grid"><label>XP<input class="reward-xp" type="number" min="0" value="100"></label><label>Role<select class="reward-role"><option value="">Choose role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>">@<%= r.name %></option><% }) %></select></label></div></div></template>
<script>
function showEmptyRoleGroups(host){if(!host||host.querySelector('.role-group-row'))return;const empty=document.createElement('div');empty.className='role-group-empty';const title=document.createElement('strong');title.textContent='You haven’t added any groups yet.';const detail=document.createElement('span');detail.textContent='Click “Add a role group” to start. You can add as many as you need.';empty.append(title,detail);host.append(empty)}
function bindRemove(root=document){root.querySelectorAll('.remove-row').forEach(b=>{if(b.dataset.bound)return;b.dataset.bound='1';b.addEventListener('click',()=>{const row=b.closest('.repeater-row');const roleGroups=row?.closest('#role-groups');row?.remove();if(roleGroups)showEmptyRoleGroups(roleGroups)})})}
bindRemove();const addTicketPanel=document.getElementById('add-ticket-panel');if(addTicketPanel)addTicketPanel.addEventListener('click',()=>{const host=document.getElementById('ticket-panels');host.append(document.getElementById('ticket-panel-template').content.cloneNode(true));bindRemove(host)});const addRoleGroup=document.getElementById('add-role-group');if(addRoleGroup)addRoleGroup.addEventListener('click',()=>{const host=document.getElementById('role-groups');host.querySelector('.role-group-empty')?.remove();host.append(document.getElementById('role-group-template').content.cloneNode(true));bindRemove(host)});const addReward=document.getElementById('add-reward');if(addReward)addReward.addEventListener('click',()=>{const host=document.getElementById('reward-rows');host.append(document.getElementById('reward-template').content.cloneNode(true));bindRemove(host)});
const useDiscordIcon=document.getElementById('use-discord-icon');if(useDiscordIcon)useDiscordIcon.addEventListener('click',()=>{const input=document.querySelector('.config-input[data-key="logoUrl"]');if(input)input.value=useDiscordIcon.dataset.url||'';});
const form=document.getElementById('module-form');
const previewMessage=document.getElementById('preview-message'),previewChannel=document.getElementById('preview-channel'),previewBrand=document.getElementById('preview-brand'),previewStatus=document.getElementById('preview-status'),preview=document.getElementById('discord-preview'),saveCaption=document.getElementById('save-caption');
function refreshModulePreview(){
 const message=form?.querySelector('[data-key="message"]'); if(message&&previewMessage)previewMessage.textContent=message.value||'<%= def.description.replace(/'/g,"\\'") %>';
 const channel=form?.querySelector('[data-key="channelId"]'); if(channel&&previewChannel){const destination=channel.selectedOptions[0]?.text.replace(/^#\s*/,'');previewChannel.textContent=destination?`# ${destination}`:'Choose a channel above';if(saveCaption&&'<%= def.key %>'==='role_menus')saveCaption.textContent=destination?`Saving will publish this menu to # ${destination}.`:'Choose a channel above before you publish the menu.';}
 const name=form?.querySelector('[data-key="name"]'); if(name&&previewBrand)previewBrand.textContent=name.value||'EAFC.Live';
 const enabled=form?.querySelector('[name="enabled"]');if(enabled&&previewStatus){previewStatus.textContent=enabled.checked?'Ready':'Paused';previewStatus.classList.toggle('bad',!enabled.checked);previewStatus.classList.toggle('good',enabled.checked)}
 const colour=form?.querySelector('[data-key="primaryColour"]');if(colour&&preview&&/^#[0-9a-f]{6}$/i.test(colour.value))preview.style.setProperty('--preview-accent',colour.value);
 const groups=form?.querySelector('#role-groups');const list=document.getElementById('preview-role-list');if(groups&&list){const names=[...groups.querySelectorAll('.rg-name')].map(x=>x.value.trim()).filter(Boolean);list.replaceChildren(...(names.length?names:['Role groups appear here']).slice(0,3).map(label=>{const row=document.createElement('span');row.textContent=label;const chevron=document.createElement('b');chevron.textContent='›';row.append(chevron);return row}))}
}
if(form){form.addEventListener('input',refreshModulePreview);form.addEventListener('change',refreshModulePreview);new MutationObserver(refreshModulePreview).observe(form,{childList:true,subtree:true});refreshModulePreview()}
function ticketPanelId(name){return String(name||'ticket').toLowerCase().replace(/[^a-z0-9-]+/g,'-').replace(/^-+|-+$/g,'').slice(0,40)||'ticket'}
function serializeConfig(){const out={};document.querySelectorAll('.config-input').forEach(el=>{const key=el.dataset.key,type=el.dataset.type;if(type==='boolean')out[key]=el.checked;else if(type==='number')out[key]=Number(el.value||0);else if(type==='array-lines')out[key]=el.value.split(/\n/).map(v=>v.trim()).filter(Boolean);else if(type==='checkbox-array')out[key]=Array.from(el.querySelectorAll('input:checked')).map(x=>x.value);else if(type==='ticket-panels')out[key]=Array.from(el.querySelectorAll('.ticket-panel-row')).map(row=>{const name=row.querySelector('.tp-name').value.trim();return{enabled:row.querySelector('.tp-enabled').checked,id:ticketPanelId(row.querySelector('.tp-id').value.trim()||name),name,panelChannelId:row.querySelector('.tp-channel').value,categoryId:row.querySelector('.tp-category').value,staffRoleIds:Array.from(row.querySelectorAll('.tp-staff:checked')).map(x=>x.value),types:row.querySelector('.tp-types').value.split(/\n/).map(v=>v.trim()).filter(Boolean)}}).filter(p=>p.name);else if(type==='role-groups')out[key]=Array.from(el.querySelectorAll('.role-group-row')).map(row=>({name:row.querySelector('.rg-name').value.trim(),maxSelect:Number(row.querySelector('.rg-max').value),roleIds:Array.from(row.querySelectorAll('.rg-role:checked')).map(x=>x.value)})).filter(g=>g.name&&g.roleIds.length);else if(type==='rewards')out[key]=Array.from(el.querySelectorAll('.reward-row')).map(row=>({xp:Number(row.querySelector('.reward-xp').value||0),roleId:row.querySelector('.reward-role').value})).filter(r=>r.roleId);else out[key]=el.value;});document.getElementById('config-output').value=JSON.stringify(out);}
form.addEventListener('submit',serializeConfig);
</script></body></html>
