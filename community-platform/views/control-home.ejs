<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Control • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control">
<section class="topbar"><div><div class="crumb">EAFC.Live / Discord Control</div><h1><%= guild?.name||'Community' %></h1><p>Community health, engagement and operations. Trading data lives in the EAFC.Live app bot, not here.</p></div><div class="top-actions"><a class="btn-secondary" href="/discord">Discord tools</a><a class="btn" href="/control/settings">Configure features</a></div></section>
<section class="grid metrics"><div class="metric"><span>Tracked members</span><strong><%= Number(metrics.tracked_members||0).toLocaleString() %></strong><small><%= Number(metrics.active_7d||0) %> active in 7 days</small></div><div class="metric"><span>Kudos this week</span><strong><%= Number(metrics.kudos_7d||0).toLocaleString() %></strong><small>Member recognition</small></div><div class="metric"><span>Premium</span><strong><%= Number(metrics.premium_members||0).toLocaleString() %></strong><small>Active access</small></div><div class="metric"><span>Open tickets</span><strong><%= Number(metrics.open_tickets||0) %></strong><small>Support queue</small></div><div class="metric"><span>Automations</span><strong><%= Number(metrics.schedules||0)+Number(metrics.feeds||0) %></strong><small><%= metrics.schedules||0 %> schedules • <%= metrics.feeds||0 %> feeds</small></div><div class="metric"><span>Live giveaways</span><strong><%= Number(metrics.live_giveaways||0) %></strong><small><%= Number(metrics.coins_circulating||0).toLocaleString() %> Live Coins circulating</small></div></section>
<section class="grid two"><div class="panel"><div class="panel-head"><div><h2>Community operations</h2><p>What deserves attention now.</p></div></div><div class="list"><a class="row" href="/control/safety"><span class="row-main"><strong>Support queue</strong><small><%= metrics.open_tickets||0 %> open tickets</small></span><span class="pill <%= Number(metrics.open_tickets||0)?'warn':'good' %>"><%= Number(metrics.open_tickets||0)?'Review':'Clear' %></span></a><a class="row" href="/control/safety"><span class="row-main"><strong>Moderation</strong><small><%= metrics.warnings_7d||0 %> warnings in the last 7 days</small></span><span class="pill <%= Number(metrics.warnings_7d||0)?'warn':'good' %>"><%= Number(metrics.warnings_7d||0)?'Activity':'Quiet' %></span></a><a class="row" href="/control/automation"><span class="row-main"><strong>Automation</strong><small>Scheduled posts and content feeds</small></span><span class="pill good">Running</span></a><a class="row" href="/control/community"><span class="row-main"><strong>Community tools</strong><small>Welcome, roles, starboard, responses and stickies</small></span><span class="pill good">Manage</span></a></div></div>
<div class="panel"><div class="panel-head"><div><h2>Kudos leaderboard</h2><p>Recognition, not trade tracking.</p></div><a class="pill" href="/control/engagement">Open engagement</a></div><div><% kudos.forEach((k,n)=>{ %><div class="kudos-rank"><b>#<%= n+1 %></b><span><strong><%= k.name %></strong><small>Community recognition</small></span><strong><%= Number(k.thanks_received||0) %></strong></div><% }) %><% if(!kudos.length){ %><div class="empty">No kudos yet.</div><% } %></div></div></section>
<section class="grid three" style="margin-top:11px"><a class="feature-card" href="/control/members"><h3>Members</h3><p>Find members, review XP, streaks, Premium and kudos.</p><div class="meta"><span class="pill">Directory</span><span>→</span></div></a><a class="feature-card" href="/control/engagement"><h3>Engagement</h3><p>XP, Live Coins, quests, seasons, giveaways and kudos.</p><div class="meta"><span class="pill">Retention</span><span>→</span></div></a><a class="feature-card" href="/control/community"><h3>Community</h3><p>Welcome, roles, suggestions, starboard, autoresponses and sticky messages.</p><div class="meta"><span class="pill">Discord</span><span>→</span></div></a><a class="feature-card" href="/control/automation"><h3>Automation</h3><p>Scheduled posts, external feeds and giveaway history.</p><div class="meta"><span class="pill">Automate</span><span>→</span></div></a><a class="feature-card" href="/control/safety"><h3>Safety & support</h3><p>Warnings, reports, ticket queue and moderation settings.</p><div class="meta"><span class="pill">Operations</span><span>→</span></div></a><a class="feature-card" href="/billing"><h3>Premium</h3><p>Stripe subscriptions, complimentary access and referrals.</p><div class="meta"><span class="pill">Billing</span><span>→</span></div></a></section>
<section class="grid two" style="margin-top:11px"><div class="panel"><div class="panel-head"><div><h2><%= season?.name||'Community season' %></h2><p>Current progression cycle.</p></div></div><% if(season){ const total=Math.max(1,new Date(season.ends_at).getTime()-new Date(season.starts_at).getTime()); const elapsed=Math.max(0,Date.now()-new Date(season.starts_at).getTime()); const pct=Math.min(100,Math.round(elapsed/total*100)); %><div class="row"><span class="row-main"><strong>Season in progress</strong><small>Ends <%= new Date(season.ends_at).toLocaleDateString('en-GB') %></small></span><span class="pill good">Live</span></div><div class="statbar"><i style="width:<%= pct %>%"></i></div><% }else{ %><div class="empty">No active season.</div><% } %></div><div class="panel"><div class="panel-head"><div><h2>Recent admin activity</h2><p>Latest control changes.</p></div><a class="pill" href="/audit">Audit log</a></div><div class="list"><% recent.forEach(r=>{ %><div class="row"><span class="row-main"><strong><%= String(r.action).replaceAll('.',' › ') %></strong><small><%= new Date(r.created_at).toLocaleString('en-GB') %></small></span></div><% }) %><% if(!recent.length){ %><div class="empty">No recent changes.</div><% } %></div></div></section>
</main></body></html>