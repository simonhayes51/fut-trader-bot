<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Overview • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control overview-page">
<% const selected=new Set(widgets||[]); const allMetrics=[
  {key:'retention',label:'Tracked members',value:Number(metrics.tracked_members||0)?Number(metrics.tracked_members).toLocaleString('en-GB'):'Not tracked',note:Number(metrics.tracked_members||0)?`${Number(metrics.active_7d||0).toLocaleString('en-GB')} active this week`:'Member activity tracking has no records yet'},
  {key:'premium',label:'Premium members',value:Number(metrics.premium_members||0).toLocaleString('en-GB'),note:'Current active access'},
  {key:'tickets',label:'Open support tickets',value:Number(metrics.open_tickets||0).toLocaleString('en-GB'),note:'Waiting for staff'},
  {key:'security',label:'Security findings',value:Number(metrics.health_findings||0).toLocaleString('en-GB'),note:`${Number(metrics.warnings_7d||0)} warnings this week`},
  {key:'kudos',label:'Kudos this week',value:Number(metrics.kudos_7d||0).toLocaleString('en-GB'),note:'Member recognition'},
  {key:'economy',label:'Live Coins in circulation',value:Number(metrics.coins_circulating||0).toLocaleString('en-GB'),note:'Community balance'},
  {key:'giveaways',label:'Live giveaways',value:Number(metrics.live_giveaways||0).toLocaleString('en-GB'),note:'Currently running'},
  {key:'referrals',label:'Referral conversions',value:Number(metrics.referral_conversions||0).toLocaleString('en-GB'),note:'Premium sign-ups'},
  {key:'partners',label:'Active partners',value:Number(metrics.active_partners||0).toLocaleString('en-GB'),note:'Tracked partnerships'},
  {key:'feature_usage',label:'Bot interactions',value:Number(metrics.feature_events_7d||0)?Number(metrics.feature_events_7d).toLocaleString('en-GB'):'No data',note:Number(metrics.feature_events_7d||0)?'Recorded in the last 7 days':'No interactions recorded; tracking may not cover every tool'}
]; const defaults=new Set(['retention','premium','tickets','security']); const shown=selected.size?allMetrics.filter(x=>selected.has(x.key)):allMetrics.filter(x=>defaults.has(x.key));
const attention=[
  {title:'Support queue',detail:`${Number(metrics.open_tickets||0)} open tickets`,count:Number(metrics.open_tickets||0),href:'/control/safety',label:'Open support'},
  {title:'Server health',detail:`${Number(metrics.health_findings||0)} active findings`,count:Number(metrics.health_findings||0),href:'/control/security',label:'Review health'},
  {title:'Recent moderation',detail:`${Number(metrics.warnings_7d||0)} warnings this week`,count:Number(metrics.warnings_7d||0),href:'/control/safety',label:'Review safety'}
].filter(x=>x.count>0);
%>
<section class="overview-header"><div><div class="crumb"><%= guild?.name||'Discord server' %> / Overview</div><h1>Server overview</h1><p>Start with anything that needs attention, then jump straight to the tools you use most.</p></div><div class="top-actions"><a class="btn-secondary" href="/control/insights">View insights</a><a class="btn" href="/control/security">Server health</a></div></section>

<section class="overview-metrics" aria-label="Key server metrics">
  <% shown.slice(0,6).forEach(m=>{ %><article class="overview-metric"><span><%= m.label %></span><strong><%= m.value %></strong><small><%= m.note %></small></article><% }) %>
</section>

<section class="overview-columns">
  <div class="overview-main-column">
    <section class="overview-panel attention-panel">
      <header class="overview-panel-head"><div><span class="section-kicker">PRIORITY</span><h2>Needs attention</h2><p>Open items that may need a staff response.</p></div><span class="attention-count <%= attention.length?'has-items':'clear' %>"><%= attention.length?`${attention.length} to review`:'All clear' %></span></header>
      <% if(attention.length){ %><div class="attention-list"><% attention.forEach(item=>{ %><a class="attention-item" href="<%= item.href %>"><span class="attention-icon">!</span><span class="attention-copy"><strong><%= item.title %></strong><small><%= item.detail %></small></span><span class="attention-link"><%= item.label %> <b>→</b></span></a><% }) %></div><% } else { %><div class="clear-state"><span class="clear-check">✓</span><span><strong>You’re up to date</strong><small>No open support tickets or active server health findings.</small></span></div><% } %>
    </section>

    <section class="overview-panel recent-panel">
      <header class="overview-panel-head"><div><span class="section-kicker">LATEST CHANGES</span><h2>Recent admin activity</h2><p>Changes made to this server’s setup.</p></div><a class="panel-link" href="/audit">Full audit log <b>→</b></a></header>
      <% if(recent.length){ %><div class="recent-list"><% recent.slice(0,5).forEach(r=>{ %><div class="recent-item"><span class="recent-dot"></span><span class="recent-copy"><strong><%= String(r.action).replaceAll('.',' › ') %></strong><small><%= new Date(r.created_at).toLocaleString('en-GB',{dateStyle:'medium',timeStyle:'short'}) %></small></span></div><% }) %></div><% } else { %><div class="quiet-empty">Admin changes will appear here.</div><% } %>
    </section>
  </div>

  <aside class="overview-side-column">
    <section class="overview-panel quick-panel">
      <header class="overview-panel-head"><div><span class="section-kicker">SHORTCUTS</span><h2>Quick actions</h2><p>Common tasks, one click away.</p></div></header>
      <div class="quick-action-list">
        <a class="quick-action" href="/control/onboarding"><span class="quick-action-icon violet">＋</span><span><strong>Set up onboarding</strong><small>Welcome, verification and roles</small></span><b>→</b></a>
        <a class="quick-action" href="/control/studio"><span class="quick-action-icon blue">✦</span><span><strong>Build a Discord message</strong><small>Embeds, buttons and role panels</small></span><b>→</b></a>
        <a class="quick-action" href="/control/automation"><span class="quick-action-icon green">↻</span><span><strong>Schedule a post</strong><small>Recurring posts and content feeds</small></span><b>→</b></a>
        <a class="quick-action" href="/economy"><span class="quick-action-icon amber">¤</span><span><strong>Manage economy & rewards</strong><small>Live Coins, quests and redemptions</small></span><b>→</b></a>
      </div>
    </section>

    <section class="overview-panel pulse-panel">
      <header class="overview-panel-head"><div><span class="section-kicker">SERVER SNAPSHOT</span><h2>Community activity</h2></div><a class="panel-link" href="/control/insights">Insights <b>→</b></a></header>
      <div class="snapshot-list">
        <div><span>Active this week</span><strong><%= Number(metrics.active_7d||0).toLocaleString('en-GB') %></strong></div>
        <div><span>Scheduled posts</span><strong><%= Number(metrics.schedules||0).toLocaleString('en-GB') %></strong></div>
        <div><span>Content feeds</span><strong><%= Number(metrics.feeds||0).toLocaleString('en-GB') %></strong></div>
        <div><span>Live giveaways</span><strong><%= Number(metrics.live_giveaways||0).toLocaleString('en-GB') %></strong></div>
      </div>
    </section>
  </aside>
</section>
</main></body></html>
