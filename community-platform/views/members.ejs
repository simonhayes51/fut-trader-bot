<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Members • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/polish.css"></head><body><aside class="sidebar"></aside><main class="content saas-page">
<% const premiumCount=members.filter(m=>Boolean(m.premium)).length; const activeStreaks=members.filter(m=>Number(m.streak?.current_streak||0)>0).length; const totalCoins=members.reduce((a,m)=>a+Number(m.economy?.coins_balance||0),0); %>
<section class="page-hero compact"><div><div class="eyebrow">WORKSPACE / MEMBERS</div><h1>Member centre</h1><p>Search the community, inspect progression and open a full member record.</p></div><div class="hero-actions"><a class="ghost" href="/analytics">View analytics</a><a class="button" href="/economy">Manage rewards</a></div></section>
<section class="stats compact-stats member-summary"><div class="stat"><span>Visible members</span><strong><%= members.length %></strong></div><div class="stat"><span>Premium</span><strong><%= premiumCount %></strong></div><div class="stat"><span>Active streaks</span><strong><%= activeStreaks %></strong></div><div class="stat"><span>Coins held</span><strong><%= totalCoins.toLocaleString('en-GB') %></strong></div></section>
<section class="panel directory-toolbar"><form class="directory-search" method="get"><div><span class="field-label">Find member</span><input name="q" value="<%= q %>" placeholder="Search display name or username…" autofocus></div><button class="button">Search</button><% if(q){ %><a class="ghost" href="/members">Clear</a><% } %></form><div class="directory-meta"><span><%= members.length %> result<%= members.length===1?'':'s' %></span><span>Click a member for the full record</span></div></section>
<div class="member-grid saas-member-grid"><% members.forEach(m=>{ const premium=Boolean(m.premium); %><a class="member-card saas-member-card" href="/members/<%= m.id %>"><div class="member-card-top"><div class="member-ident"><span class="member-initial"><%= m.name.slice(0,1).toUpperCase() %></span><span><strong><%= m.name %></strong><small>@<%= m.username %></small></span></div><span class="pill <%= premium?'on':'' %>"><%= premium?'Premium':'Standard' %></span></div><div class="member-metrics"><span><b>Lv <%= m.level||1 %></b><small><%= Number(m.economy?.xp_total||0).toLocaleString() %> XP</small></span><span><b><%= Number(m.economy?.coins_balance||0).toLocaleString() %></b><small>Live Coins</small></span></div><div class="member-signals"><span>🔥 <%= Number(m.streak?.current_streak||0) %>d streak</span><span>💚 <%= m.stats?.thanks_received||0 %> helpful</span></div><div class="role-line"><%= m.roles.slice(0,4).join(' • ')||'No Discord roles' %><%= m.roles.length>4?` • +${m.roles.length-4}`:'' %></div><span class="card-arrow">Open profile →</span></a><% }) %><% if(!members.length){ %><div class="panel empty">No members found.</div><% } %></div>
</main></body></html>