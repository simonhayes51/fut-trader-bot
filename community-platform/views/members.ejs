<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Members • FC27 Control</title><link rel="stylesheet" href="/style.css"></head><body><aside class="sidebar"><a class="brand" href="/dashboard"><span>FC27</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/setup">Setup wizard</a><a class="active" href="/members">Members</a><a href="/analytics">Analytics</a><a href="/commands">Commands</a><a href="/automation">Automation</a><a href="/billing">Premium & billing</a></nav></aside><main class="content"><header><div><div class="eyebrow">MEMBER CENTRE</div><h1>Members</h1><p class="muted">Search by a name. Never touch a Discord user ID again.</p></div></header><form class="searchbar" method="get"><input name="q" value="<%= q %>" placeholder="Search member name…" autofocus><button class="button">Search</button></form><div class="member-grid"><% members.forEach(m=>{ %><a class="member-card" href="/members/<%= m.id %>"><div><strong><%= m.name %></strong><small>@<%= m.username %></small></div><div class="member-metrics"><span><b><%= Number(m.stats?.xp||0).toLocaleString() %></b> XP</span><span><b><%= m.stats?.thanks_received||0 %></b> thanks</span><span class="pill <%= m.premium&&['active','trialing','comped','gifted','past_due'].includes(m.premium.status)?'on':'' %>"><%= m.premium?.status||'Free' %></span></div><small><%= m.roles.slice(0,5).join(' • ')||'No roles' %></small></a><% }) %><% if(!members.length){ %><div class="panel empty">No members found.</div><% } %></div></main></body></html>