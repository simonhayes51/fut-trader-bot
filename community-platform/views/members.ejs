<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Members • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"></head><body><aside class="sidebar"><a class="brand" href="/dashboard"><span>EAFC.Live</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/setup">Setup</a><a class="active" href="/members">Members</a><a href="/analytics">Analytics</a><a href="/commands">Commands</a><a href="/automation">Automation</a><a href="/billing">Premium</a></nav></aside><main class="content"><header><div><div class="eyebrow">MEMBERS</div><h1>Member centre</h1></div></header><form class="searchbar compact-search" method="get"><input name="q" value="<%= q %>" placeholder="Search members…" autofocus><button class="button">Search</button></form><div class="member-grid"><% members.forEach(m=>{ const premium=Boolean(m.premium&&['active','trialing','comped','gifted','past_due'].includes(m.premium.status)); %><a class="member-card" href="/members/<%= m.id %>"><div class="member-card-top"><div><strong><%= m.name %></strong><small>@<%= m.username %></small></div><span class="pill <%= premium?'on':'' %>"><%= premium?'Premium':'Free' %></span></div><div class="member-metrics"><span><b>Lv <%= m.level||1 %></b><small><%= Number(m.economy?.xp_total||0).toLocaleString() %> XP</small></span><span><b><%= Number(m.economy?.coins_balance||0).toLocaleString() %></b><small>Live Coins</small></span></div><div class="role-line">🔥 <%= Number(m.streak?.current_streak||0) %> day streak • 💚 <%= m.stats?.thanks_received||0 %> helpful</div><div class="role-line"><%= m.roles.slice(0,4).join(' • ')||'No roles' %><%= m.roles.length>4?` • +${m.roles.length-4}`:'' %></div></a><% }) %><% if(!members.length){ %><div class="panel empty">No members found.</div><% } %></div></main></body></html>