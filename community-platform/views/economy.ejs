<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Economy • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/polish.css"><link rel="stylesheet" href="/economy.css"></head><body>
<aside class="sidebar"></aside>
<main class="content economy-page">
<header><div><div class="eyebrow">COMMUNITY ENGINE</div><h1>XP, Live Coins & Rewards</h1><p class="page-summary muted">Run progression, quests, seasons and a reward economy that gives members a reason to come back every day.</p></div><div class="status"><span class="dot"></span> Economy live</div></header>
<% if(saved){ %><div class="notice">Changes saved.</div><% } %><% if(error){ %><div class="notice error-notice"><%= error %></div><% } %>
<section class="stats compact-stats economy-stats">
<div class="stat"><span>Tracked members</span><strong><%= Number(metrics.members||0).toLocaleString('en-GB') %></strong></div>
<div class="stat"><span>Coins circulating</span><strong><%= Number(metrics.circulating||0).toLocaleString('en-GB') %></strong></div>
<div class="stat"><span>Lifetime earned</span><strong><%= Number(metrics.earned||0).toLocaleString('en-GB') %></strong></div>
<div class="stat"><span>Quests completed</span><strong><%= Number(metrics.quests_completed||0).toLocaleString('en-GB') %></strong></div>
<div class="stat"><span>Pending rewards</span><strong><%= Number(metrics.pending||0).toLocaleString('en-GB') %></strong></div>
<div class="stat"><span>Worker queue</span><strong><%= Number(queue.waiting||0).toLocaleString('en-GB') %></strong><small class="<%= Number(queue.failed||0)?'danger-text':'' %>"><%= Number(queue.failed||0) %> failed</small></div>
</section>

<section class="economy-grid two-wide">
<div class="panel"><div class="section-head"><div><h2>Economy tuning</h2><p class="muted small">Spam-protected defaults. XP is permanent progression; Live Coins are spendable.</p></div></div>
<form method="post" action="/economy/settings" class="settings-grid economy-settings">
<label class="setting-field toggle-setting"><div><span>Economy enabled</span><small>Pause all member rewards without deleting progress.</small></div><input type="checkbox" name="enabled" <%= settings.enabled!==false?'checked':'' %>></label>
<label class="setting-field"><span>XP / message</span><input type="number" min="0" name="xp_per_message" value="<%= settings.xp_per_message??4 %>"></label>
<label class="setting-field"><span>Coins / message</span><input type="number" min="0" name="coins_per_message" value="<%= settings.coins_per_message??1 %>"></label>
<label class="setting-field"><span>Message cooldown (sec)</span><input type="number" min="10" name="message_cooldown_seconds" value="<%= settings.message_cooldown_seconds??60 %>"></label>
<label class="setting-field"><span>Daily message XP cap</span><input type="number" min="0" name="daily_message_xp_cap" value="<%= settings.daily_message_xp_cap??200 %>"></label>
<label class="setting-field"><span>Daily message coin cap</span><input type="number" min="0" name="daily_message_coin_cap" value="<%= settings.daily_message_coin_cap??40 %>"></label>
<label class="setting-field"><span>Daily claim coins</span><input type="number" min="0" name="daily_claim_coins" value="<%= settings.daily_claim_coins??25 %>"></label>
<label class="setting-field"><span>Streak bonus / day</span><input type="number" min="0" name="streak_bonus_per_day" value="<%= settings.streak_bonus_per_day??5 %>"></label>
<label class="setting-field"><span>Streak bonus cap</span><input type="number" min="0" name="streak_bonus_cap" value="<%= settings.streak_bonus_cap??50 %>"></label>
<label class="setting-field"><span>Helpful XP</span><input type="number" min="0" name="helpful_xp" value="<%= settings.helpful_xp??30 %>"></label>
<label class="setting-field"><span>Helpful coins</span><input type="number" min="0" name="helpful_coins" value="<%= settings.helpful_coins??15 %>"></label>
<label class="setting-field"><span>Referral XP</span><input type="number" min="0" name="referral_xp" value="<%= settings.referral_xp??250 %>"></label>
<label class="setting-field"><span>Referral coins</span><input type="number" min="0" name="referral_coins" value="<%= settings.referral_coins??500 %>"></label>
<label class="setting-field"><span>Trade XP</span><input type="number" min="0" name="trade_xp" value="<%= settings.trade_xp??20 %>"></label>
<label class="setting-field"><span>Trade coins</span><input type="number" min="0" name="trade_coins" value="<%= settings.trade_coins??5 %>"></label>
<label class="setting-field"><span>Join XP</span><input type="number" min="0" name="join_xp" value="<%= settings.join_xp??25 %>"></label>
<label class="setting-field"><span>Join coins</span><input type="number" min="0" name="join_coins" value="<%= settings.join_coins??25 %>"></label>
<div class="wide sticky-save"><button class="button" type="submit">Save economy</button><span class="muted">Reward rates update immediately.</span></div>
</form></div>

<div class="panel"><div class="section-head"><div><h2>Current season</h2><p class="muted small">Season XP gives you a recurring competitive loop without wiping permanent XP.</p></div></div>
<% const activeSeason=seasons.find(s=>s.active); %>
<% if(activeSeason){ %><div class="season-hero"><div><span>LIVE NOW</span><strong><%= activeSeason.name %></strong><small>Ends <%= new Date(activeSeason.ends_at).toLocaleDateString('en-GB') %></small></div><div class="season-orb">🏆</div></div><% } else { %><div class="empty">No active season.</div><% } %>
<form method="post" action="/economy/season" class="form-grid compact-form"><label><span>New season name</span><input name="name" placeholder="FC27 Season 2"></label><label><span>Length (days)</span><input name="days" type="number" value="30" min="1" max="365"></label><label><span>🥇 1st place reward</span><input name="first_reward" type="number" min="0" value="<%= Number(activeSeason?.rewards?.['1']??2000) %>"></label><label><span>🥈 2nd place reward</span><input name="second_reward" type="number" min="0" value="<%= Number(activeSeason?.rewards?.['2']??1000) %>"></label><label><span>🥉 3rd place reward</span><input name="third_reward" type="number" min="0" value="<%= Number(activeSeason?.rewards?.['3']??500) %>"></label><div class="wide hint-box">Starting a new season settles the current leaderboard first and pays its configured podium rewards automatically.</div><div class="wide"><button class="ghost" type="submit">Settle current & start new season</button></div></form>
<hr><h3>Top members</h3><div class="leader-list"><% top.forEach((m,n)=>{ const member=members.find(x=>x.id===m.user_id); %><div><b>#<%= n+1 %></b><span><strong><%= member?.name||m.user_id %></strong><small><%= Number(m.xp_total||0).toLocaleString('en-GB') %> XP • <%= Number(m.coins_balance||0).toLocaleString('en-GB') %> 🪙 • <%= Number(m.current_streak||0) %>d streak</small></span></div><% }) %><% if(!top.length){ %><div class="empty">No progression data yet.</div><% } %></div>
</div>
</section>

<section class="section"><div class="section-head"><div><h2>Rewards store</h2><p class="muted small">Create rewards members can actually work towards. Premium can fulfil automatically; EAFC.Live claims queue for verification.</p></div></div><div class="store-grid"><% items.forEach(x=>{ %><article class="reward-card <%= x.active?'':'disabled' %>"><div class="reward-icon"><%= x.emoji||'🎁' %></div><div class="reward-body"><div class="reward-title"><strong><%= x.name %></strong><span><%= Number(x.cost_coins).toLocaleString('en-GB') %> 🪙</span></div><p><%= x.description %></p><small><code><%= x.item_key %></code> • <%= x.fulfillment_type.replaceAll('_',' ') %><%= x.duration_days?` • ${x.duration_days} days`:'' %><%= x.stock!==null?` • ${x.stock} left`:'' %></small></div><form method="post" action="/economy/store/<%= x.id %>/toggle"><button class="ghost mini"><%= x.active?'Disable':'Enable' %></button></form></article><% }) %></div>
<div class="panel inset"><h3>Add / update reward</h3><form method="post" action="/economy/store" class="form-grid"><label><span>Key</span><input name="item_key" placeholder="premium-30d" required></label><label><span>Name</span><input name="name" placeholder="1 month Premium" required></label><label class="wide"><span>Description</span><input name="description" placeholder="Unlock Premium for 30 days"></label><label><span>Emoji</span><input name="emoji" value="🎁"></label><label><span>Cost (Live Coins)</span><input name="cost_coins" type="number" min="0" required></label><label><span>Fulfilment</span><select name="fulfillment_type"><option value="discord_premium">Discord Premium</option><option value="eafc_live">EAFC.Live access</option><option value="role">Discord role</option><option value="badge">Profile badge</option><option value="custom">Manual / custom</option></select></label><label><span>Duration days</span><input name="duration_days" type="number" min="1"></label><label><span>Role</span><select name="role_id"><option value="">None</option><% roles.forEach(r=>{ %><option value="<%= r.id %>"><%= r.name %></option><% }) %></select></label><label><span>Billing plan slug</span><input name="billing_plan_slug" placeholder="premium-monthly"></label><label><span>Stock (blank = unlimited)</span><input name="stock" type="number" min="0"></label><label><span>Per-member limit</span><input name="per_user_limit" type="number" min="1"></label><label><span>Sort order</span><input name="sort_order" type="number" value="100"></label><div class="wide"><button class="button">Save reward</button></div></form></div></section>

<section class="section"><div class="section-head"><div><h2>Quest engine</h2><p class="muted small">Daily and weekly tasks reward useful behaviour instead of raw message spam.</p></div></div><div class="quest-admin-grid"><% quests.forEach(q=>{ %><article class="quest-admin-card <%= q.active?'':'disabled' %>"><div><span class="quest-cadence"><%= q.cadence %></span><strong><%= q.name %></strong><p><%= q.description %></p></div><div class="quest-meta"><span><%= q.event_type %> × <%= q.target %></span><span><%= q.xp_reward %> XP</span><span><%= q.coin_reward %> 🪙</span></div><form method="post" action="/economy/quests/<%= q.id %>/toggle"><button class="ghost mini"><%= q.active?'Disable':'Enable' %></button></form></article><% }) %></div>
<div class="panel inset"><h3>Add / update quest</h3><form method="post" action="/economy/quests" class="form-grid"><label><span>Key</span><input name="quest_key" placeholder="weekly_market_maker" required></label><label><span>Name</span><input name="name" placeholder="Market maker" required></label><label class="wide"><span>Description</span><input name="description" placeholder="Complete the task to earn rewards"></label><label><span>Cadence</span><select name="cadence"><option>daily</option><option>weekly</option><option>season</option><option>lifetime</option></select></label><label><span>Event type</span><input name="event_type" placeholder="message / trade_logged / helpful_received" required></label><label><span>Target</span><input name="target" type="number" min="1" value="1"></label><label><span>XP reward</span><input name="xp_reward" type="number" min="0" value="50"></label><label><span>Coin reward</span><input name="coin_reward" type="number" min="0" value="25"></label><label class="toggle-setting"><div><span>Premium only</span></div><input type="checkbox" name="premium_only"></label><label><span>Sort order</span><input name="sort_order" type="number" value="100"></label><div class="wide"><button class="button">Save quest</button></div></form></div></section>

<section class="economy-grid two-wide section">
<div class="panel"><div class="section-head"><div><h2>Reward fulfilment</h2><p class="muted small">EAFC.Live and custom rewards land here for staff action.</p></div></div><div class="fulfil-list"><% redemptions.slice(0,30).forEach(r=>{ %><article class="fulfil-row"><div><span class="pill <%= r.status==='FULFILLED'?'on':r.status==='PENDING'?'':'off' %>"><%= r.status %></span><strong><%= r.item_name %></strong><small><code><%= r.claim_code %></code> • <%= Number(r.cost_coins).toLocaleString('en-GB') %> 🪙 • <%= new Date(r.created_at).toLocaleString('en-GB') %></small><small>Member: <%= members.find(x=>x.id===r.user_id)?.name||r.user_id %></small></div><% if(r.status==='PENDING'){ %><div class="actions wrap"><form method="post" action="/economy/redemptions/<%= r.id %>/fulfill" class="inline"><input name="notes" placeholder="Fulfilment note"><button class="button mini">Fulfilled</button></form><form method="post" action="/economy/redemptions/<%= r.id %>/refund"><button class="danger mini">Refund</button></form></div><% } %></article><% }) %><% if(!redemptions.length){ %><div class="empty">No redemptions yet.</div><% } %></div></div>
<div class="panel"><div class="section-head"><div><h2>Manual adjustment</h2><p class="muted small">Support tool for competitions, corrections and one-off rewards. Every change is ledgered and audited.</p></div></div><form method="post" action="/economy/grant" class="form-grid"><label class="wide"><span>Member</span><select name="user_id" required><option value="">Choose member</option><% members.forEach(m=>{ %><option value="<%= m.id %>"><%= m.name %> (@<%= m.username %>)</option><% }) %></select></label><label><span>Currency</span><select name="currency"><option value="coins">Live Coins</option><option value="xp">XP</option></select></label><label><span>Amount</span><input name="amount" type="number" placeholder="500 or -500" required></label><label class="wide"><span>Reason</span><input name="reason" placeholder="Competition prize / correction" required></label><div class="wide"><button class="button">Apply adjustment</button></div></form><hr><h3>Recent ledger</h3><div class="ledger-list"><% ledger.slice(0,18).forEach(l=>{ %><div><span class="ledger-amount <%= Number(l.amount)>=0?'positive':'negative' %>"><%= Number(l.amount)>0?'+':'' %><%= Number(l.amount).toLocaleString('en-GB') %> <%= l.currency==='coins'?'🪙':'XP' %></span><span><strong><%= members.find(x=>x.id===l.user_id)?.name||l.user_id %></strong><small><%= l.reason %> • <%= new Date(l.created_at).toLocaleString('en-GB') %></small></span></div><% }) %></div></div>
</section>
</main></body></html>
