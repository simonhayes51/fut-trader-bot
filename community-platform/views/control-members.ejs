<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Members · EAFC.Live</title>
  <link rel="stylesheet" href="/control.css">
</head>
<body>
  <aside class="sidebar"></aside>
  <main class="control members-page">
    <header class="topbar directory-heading">
      <div>
        <div class="crumb">Community <span aria-hidden="true">/</span> Members</div>
        <h1>Members</h1>
        <p>Find a person, check their access and see how they use your server.</p>
      </div>
      <div class="directory-total"><strong><%= totalMembers.toLocaleString() %></strong><span><%= totalMembers===1?'member':'members' %> in this server</span></div>
    </header>

    <section class="directory-toolbar" aria-label="Find members">
      <form class="directory-search" method="get" action="/control/members">
        <label for="member-search">Search members</label>
        <div class="directory-search-row">
          <input id="member-search" name="q" value="<%= q %>" placeholder="Name or Discord username" autocomplete="off">
          <button class="btn" type="submit">Search</button>
          <% if(q){ %><a class="btn-secondary" href="/control/members">Clear</a><% } %>
        </div>
      </form>
      <div class="directory-result-count"><strong><%= totalMembers.toLocaleString() %></strong> matching <%= totalMembers===1?'member':'members' %></div>
    </section>

    <section class="directory-table-wrap" aria-label="Member directory">
      <div class="table-scroll">
        <table class="directory-table">
          <thead>
            <tr><th scope="col">Member</th><th scope="col">Access</th><th scope="col">Activity</th><th scope="col">Progress</th><th scope="col">Kudos</th><th scope="col">Live Coins</th><th scope="col">Streak</th></tr>
          </thead>
          <tbody>
            <% members.forEach(m=>{ %>
              <tr>
                <td>
                  <a class="directory-member directory-member-link" href="/members/<%= m.id %>">
                    <span class="directory-avatar" aria-hidden="true"><%= m.name.slice(0,1).toUpperCase() %></span>
                    <span class="directory-member-name"><strong><%= m.name %></strong><small>@<%= m.username %></small></span>
                  </a>
                </td>
                <td><span class="access-badge <%= m.premium?'is-premium':'' %>"><i></i><%= m.premium?'Premium':'Member' %></span></td>
                <td>
                  <% if(m.tracked){ %><span class="table-primary-value"><%= m.messages.toLocaleString() %> messages</span><small class="table-secondary-value"><%= m.lastActive?'Last active '+new Date(m.lastActive).toLocaleDateString('en-GB'):'No recent activity' %></small>
                  <% }else{ %><span class="not-tracked">Not tracked yet</span><small class="table-secondary-value">Activity appears after their first message.</small><% } %>
                </td>
                <td><% if(m.tracked){ %><span class="table-primary-value">Level <%= m.level %></span><small class="table-secondary-value"><%= m.xp.toLocaleString() %> XP</small><% }else{ %><span class="table-placeholder">—</span><% } %></td>
                <td><span class="table-number"><%= m.tracked?m.kudos.toLocaleString():'—' %></span></td>
                <td><span class="table-number"><%= m.tracked?m.coins.toLocaleString():'—' %></span></td>
                <td><span class="table-number"><%= m.tracked?`${m.streak} days`:'—' %></span></td>
              </tr>
            <% }) %>
            <% if(!members.length){ %>
              <tr><td colspan="7"><div class="directory-empty"><strong><%= q?'No members match that search.':'No members found.' %></strong><span><%= q?'Try a display name or Discord username.':'Members will appear here when the bot can access this server.' %></span></div></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% if(pageCount>1){ %>
        <nav class="directory-pagination" aria-label="Member pages">
          <span>Showing <strong><%= ((page-1)*pageSize+1).toLocaleString() %>–<%= Math.min(page*pageSize,totalMembers).toLocaleString() %></strong> of <strong><%= totalMembers.toLocaleString() %></strong></span>
          <div>
            <% if(page>1){ %><a class="btn-secondary" href="/control/members?q=<%= encodeURIComponent(q) %>&amp;page=<%= page-1 %>">Previous</a><% } %>
            <span class="page-indicator">Page <%= page %> of <%= pageCount %></span>
            <% if(page<pageCount){ %><a class="btn-secondary" href="/control/members?q=<%= encodeURIComponent(q) %>&amp;page=<%= page+1 %>">Next</a><% } %>
          </div>
        </nav>
      <% } %>
    </section>
    <p class="directory-footnote">Discord membership is live. Activity and reward figures are shown only when the bot has tracked that member.</p>
  </main>
</body>
</html>
