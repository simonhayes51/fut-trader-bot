<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Members • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control"><section class="topbar"><div><div class="crumb">Discord Control / Members</div><h1>Members</h1><p>Community directory focused on engagement, recognition and access.</p></div></section><form class="searchbar"><input name="q" value="<%= q %>" placeholder="Search display name or username"><button class="btn">Search</button><% if(q){ %><a class="btn-secondary" href="/control/members">Clear</a><% } %></form><section class="member-grid"><% members.forEach(m=>{ %><article class="member"><div class="member-head"><div class="identity"><span class="avatar"><%= m.name.slice(0,1).toUpperCase() %></span><span><strong><%= m.name %></strong><small>@<%= m.username %></small></span></div><span class="pill <%= m.premium?'good':'' %>"><%= m.premium?'Premium':'Member' %></span></div><div class="member-stats"><div><b>Lv <%= m.level %></b><small><%= m.xp.toLocaleString() %> XP</small></div><div><b><%= m.kudos %></b><small>Kudos</small></div><div><b>🔥 <%= m.streak %></b><small>Streak</small></div></div><div class="row" style="padding-bottom:0"><span class="row-main"><small><%= m.messages.toLocaleString() %> messages<%= m.lastActive?' • active '+new Date(m.lastActive).toLocaleDateString('en-GB'):'' %></small></span><span class="pill"><%= m.coins.toLocaleString() %> 🪙</span></div></article><% }) %><% if(!members.length){ %><div class="panel empty">No matching members.</div><% } %></section></main></body></html>