<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Premium • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"><link rel="stylesheet" href="/polish.css"></head><body><aside class="sidebar"></aside><main class="content saas-page">
<section class="page-hero compact"><div><div class="eyebrow">GROWTH / PREMIUM</div><h1>Premium & billing</h1><p>Manage pricing, subscribers, complimentary access, referrals and Stripe health from one workspace.</p></div><div class="hero-actions"><span class="status"><span class="dot"></span> <%= stripeReady?'Stripe connected':'Stripe setup required' %></span></div></section>
<section class="stats compact-stats"><div class="stat"><span>Premium members</span><strong><%= metrics.active %></strong></div><div class="stat"><span>Complimentary</span><strong><%= metrics.complimentary %></strong></div><div class="stat"><span>Payment issues</span><strong><%= metrics.pastDue %></strong></div><div class="stat"><span>Ending soon</span><strong><%= metrics.cancelling %></strong></div><div class="stat"><span>Active plans</span><strong><%= plans.filter(p=>p.active).length %></strong></div><div class="stat"><span>Referral codes</span><strong><%= refs.filter(r=>r.active).length %></strong></div></section>

<section class="billing-grid">
<div>
<section class="panel"><div class="section-head"><div><h2>Plans</h2><p>Map live Stripe prices to the Discord Premium role.</p></div></div>
<div class="plan-stack"><% plans.forEach(p=>{ const role=roles.find(r=>r.id===p.role_id); %><article class="plan-row"><div><span class="pill <%= p.active?'on':'off' %>"><%= p.active?'Live':'Hidden' %></span><strong><%= p.name %></strong><small><%= p.description||'Premium access' %> • @<%= role?.name||'Role unavailable' %></small></div><form method="post" action="/billing/plans/<%= p.id %>/toggle"><button class="ghost mini"><%= p.active?'Hide':'Enable' %></button></form></article><% }) %><% if(!plans.length){ %><div class="empty">No Premium plans configured.</div><% } %></div>
<details class="creation-drawer"><summary>+ Add or update a plan</summary><form method="post" action="/billing/plans" class="form-grid drawer-body"><label><span>Plan name</span><input name="name" required placeholder="EAFC.Live Premium Monthly"></label><label><span>Stripe price</span><select name="stripePriceId" required><option value="">Choose price</option><% prices.forEach(p=>{ const amount=p.amount==null?'Custom':new Intl.NumberFormat('en-GB',{style:'currency',currency:p.currency.toUpperCase()}).format(p.amount/100); %><option value="<%= p.id %>"><%= p.label %> • <%= amount %> / <%= p.interval %></option><% }) %></select></label><label><span>Discord role</span><select name="roleId" required><option value="">Choose role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>">@<%= r.name %></option><% }) %></select></label><label><span>Display order</span><input name="sortOrder" type="number" value="0"></label><label class="wide"><span>Description</span><input name="description" placeholder="Premium trade rooms, events and member perks"></label><label class="wide"><span>Slug</span><input name="slug" placeholder="premium-monthly"></label><div class="wide"><button class="button">Save plan</button></div></form></details>
</section>

<section class="panel section"><div class="section-head"><div><h2>Subscribers</h2><p>Paid and complimentary access currently known to the platform.</p></div><span class="table-count"><%= subs.length %> records</span></div><div class="table-wrap saas-table flush"><table><thead><tr><th>Member</th><th>Plan</th><th>Status</th><th>Access until</th><th>Source</th><th></th></tr></thead><tbody><% subs.forEach(s=>{ const member=members.find(m=>m.id===s.discord_user_id); %><tr><td><strong><%= member?.name||'Discord member' %></strong><small class="block"><%= member?'@'+member.username:s.discord_user_id %></small></td><td><%= s.plan_name||'Premium' %></td><td><span class="pill <%= ['active','comped','gifted','past_due'].includes(s.status)?'on':'off' %>"><%= s.status==='comped'?'Complimentary':s.status.replaceAll('_',' ') %></span></td><td><%= s.current_period_end?new Date(s.current_period_end).toLocaleDateString('en-GB'):'—' %><%= s.cancel_at_period_end?' • ending':'' %></td><td><%= s.source==='stripe'?'Stripe':s.source==='manual'?'Manual':s.source %></td><td><% if(s.plan_id&&['comped','gifted'].includes(s.status)){ %><form method="post" action="/billing/revoke"><input type="hidden" name="discordUserId" value="<%= s.discord_user_id %>"><input type="hidden" name="planId" value="<%= s.plan_id %>"><button class="danger mini">Revoke</button></form><% } %></td></tr><% }) %><% if(!subs.length){ %><tr><td colspan="6" class="empty">No Premium records yet.</td></tr><% } %></tbody></table></div></section>
</div>

<div>
<section class="panel"><div class="section-head"><div><h2>Grant complimentary access</h2><p>For staff, partners, competitions or customer support.</p></div></div><form method="post" action="/billing/comp" class="stack-form"><label><span>Member</span><select name="discordUserId" required><option value="">Choose member</option><% members.forEach(m=>{ %><option value="<%= m.id %>"><%= m.name %> (@<%= m.username %>)</option><% }) %></select></label><label><span>Plan</span><select name="planId" required><option value="">Choose plan</option><% plans.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></label><label><span>Duration</span><select name="days"><option value="7">7 days</option><option value="30" selected>30 days</option><option value="90">90 days</option><option value="365">1 year</option></select></label><button class="button">Grant access</button></form></section>

<section class="panel"><div class="section-head"><div><h2>Referral programme</h2><p>Create partner/member tracking codes without touching Stripe.</p></div></div><form method="post" action="/billing/referrals" class="stack-form"><label><span>Code</span><input name="code" placeholder="RAZZER"></label><label><span>Owner</span><select name="ownerDiscordUserId"><option value="">Tracking only</option><% members.forEach(m=>{ %><option value="<%= m.id %>"><%= m.name %> (@<%= m.username %>)</option><% }) %></select></label><div class="form-grid"><label><span>Reward type</span><select name="rewardType"><option value="none">Track only</option><option value="percent">Percentage commission</option><option value="fixed">Fixed amount</option><option value="days">Premium days</option></select></label><label><span>Value</span><input name="rewardValue" type="number" step="0.01" min="0" value="0"></label></div><button class="button">Create referral</button></form><div class="referral-stack"><% refs.slice(0,12).forEach(r=>{ const owner=members.find(m=>m.id===r.owner_discord_user_id); %><article><div><strong><%= r.code %></strong><small><%= owner?owner.name:'Tracking only' %> • <%= r.clicks %> starts • <%= r.conversions %> conversions</small></div><form method="post" action="/billing/referrals/<%= r.id %>/toggle"><button class="ghost mini"><%= r.active?'Active':'Disabled' %></button></form></article><% }) %></div></section>

<details class="panel technical-drawer"><summary><strong>Stripe event health</strong><span class="muted"> <%= events.filter(e=>e.error).length %> errors in recent history</span></summary><div class="feed-list" style="margin-top:12px"><% events.slice(0,12).forEach(e=>{ %><div><strong><%= e.event_type %> <%= e.error?'• error':'' %></strong><small><%= new Date(e.created_at).toLocaleString('en-GB') %> • <%= e.processed_at?'processed':'pending' %><%= e.error?' • '+e.error:'' %></small></div><% }) %></div></details>
</div>
</section>
</main></body></html>