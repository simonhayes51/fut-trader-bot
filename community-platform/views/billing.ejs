<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Billing • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"></head><body>
<aside class="sidebar"><a class="brand" href="/dashboard"><span>EAFC.Live</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/trading">Trade calls</a><a href="/tickets">Tickets</a><a href="/social">Social feeds</a><a class="active" href="/billing">Premium & billing</a><a href="/moderation">Moderation</a><a href="/audit">Audit log</a></nav><div class="sidebar-user"><strong><%= user.username %></strong><small>Administrator</small></div><form method="post" action="/logout"><button class="ghost full">Log out</button></form></aside>
<main class="content">
<header><div><div class="eyebrow">PREMIUM MEMBERSHIPS</div><h1>Premium & billing</h1><p class="muted">Set up plans, give free access and manage referrals without touching Stripe IDs or Discord IDs.</p></div><div class="status"><span class="dot"></span> <%= stripeReady?'Stripe connected':'Stripe setup required' %></div></header>
<section class="stats"><div class="stat"><span>Premium members</span><strong><%= metrics.active %></strong></div><div class="stat"><span>Complimentary access</span><strong><%= metrics.complimentary %></strong></div><div class="stat"><span>Payment issue</span><strong><%= metrics.pastDue %></strong></div><div class="stat"><span>Ending soon</span><strong><%= metrics.cancelling %></strong></div></section>

<section class="section"><div class="section-head"><div><h2>Create or update a Premium plan</h2><p class="muted">Pick a Stripe price and the Discord role members should receive.</p></div></div>
<div class="panel"><form method="post" action="/billing/plans" class="form-grid">
<label><span>Plan name</span><small>What members will see in Discord.</small><input name="name" required placeholder="FC27 Premium Monthly"></label>
<label><span>Price</span><small>Recurring prices already created in Stripe.</small><select name="stripePriceId" required><option value="">Choose a Stripe price</option><% prices.forEach(p=>{ const amount=p.amount==null?'Custom':new Intl.NumberFormat('en-GB',{style:'currency',currency:p.currency.toUpperCase()}).format(p.amount/100); %><option value="<%= p.id %>"><%= p.label %> • <%= amount %> / <%= p.intervalCount>1?p.intervalCount+' ':'' %><%= p.interval %></option><% }) %></select></label>
<label><span>Premium role</span><small>The role automatically added after checkout.</small><select name="roleId" required><option value="">Choose Discord role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>">@<%= r.name %></option><% }) %></select></label>

<label class="wide"><span>Description</span><small>Short, member-friendly summary of what they get.</small><input name="description" placeholder="Premium trade rooms, events and community perks"></label>
<details class="wide"><summary class="muted">Advanced naming options</summary><div class="form-grid" style="margin-top:12px"><label><span>Command name / slug</span><small>Leave blank and we make one from the plan name.</small><input name="slug" placeholder="premium-monthly"></label><label><span>Display order</span><small>Lower numbers appear first.</small><input name="sortOrder" type="number" value="0"></label></div></details>
<div class="wide"><button class="button" type="submit">Save Premium plan</button></div>
</form></div>
<div class="table-wrap friendly-table"><table><thead><tr><th>Plan</th><th>Discord access</th><th>Status</th><th></th></tr></thead><tbody><% plans.forEach(p=>{ const role=roles.find(r=>r.id===p.role_id); %><tr><td><strong><%= p.name %></strong><br><small><%= p.description||'Premium access' %></small></td><td>@<%= role?.name||'Role unavailable' %></td><td><span class="pill <%= p.active?'on':'off' %>"><%= p.active?'Available':'Hidden' %></span></td><td><form method="post" action="/billing/plans/<%= p.id %>/toggle"><button class="ghost"><%= p.active?'Hide plan':'Make available' %></button></form></td></tr><% }) %><% if(!plans.length){%><tr><td colspan="4" class="empty">No plans yet. Create your first one above.</td></tr><%}%></tbody></table></div></section>

<section class="section"><div class="section-head"><div><h2>Give someone free Premium</h2><p class="muted">Useful for staff, partners, competition winners or goodwill.</p></div></div><div class="panel"><form method="post" action="/billing/comp" class="form-grid">
<label><span>Member</span><small>Choose someone already in the Discord server.</small><select name="discordUserId" required><option value="">Choose member</option><% members.forEach(m=>{ %><option value="<%= m.id %>"><%= m.name %> (@<%= m.username %>)</option><% }) %></select></label>
<label><span>Premium plan</span><select name="planId" required><option value="">Choose plan</option><% plans.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></label>
<label><span>How long?</span><select name="days"><option value="7">7 days</option><option value="30" selected>30 days</option><option value="90">90 days</option><option value="365">1 year</option></select></label>
<div style="align-self:end"><button class="button" type="submit">Grant Premium</button></div></form></div></section>

<section class="section"><div class="section-head"><h2>Members with Premium</h2></div><div class="table-wrap"><table><thead><tr><th>Member</th><th>Plan</th><th>Status</th><th>Access until</th><th>How they got it</th><th></th></tr></thead><tbody><% subs.forEach(s=>{ const member=members.find(m=>m.id===s.discord_user_id); %><tr><td><strong><%= member?.name||'Discord member' %></strong><% if(member){%><small class="block">@<%= member.username %></small><%}%></td><td><%= s.plan_name||'Premium' %></td><td><span class="pill <%= ['active','trialing','comped','gifted','past_due'].includes(s.status)?'on':'off' %>"><%= s.status==='trialing'?'Free trial':s.status==='comped'?'Complimentary':s.status.replaceAll('_',' ') %></span></td><td><%= s.current_period_end?new Date(s.current_period_end).toLocaleDateString('en-GB'):'—' %><%= s.cancel_at_period_end?' • ending':'' %></td><td><%= s.source==='stripe'?'Stripe payment':s.source==='manual'?'Free access':s.source %><%= s.referral_code?` • ${s.referral_code}`:'' %></td><td><% if(s.plan_id&&['comped','gifted'].includes(s.status)){ %><form method="post" action="/billing/revoke"><input type="hidden" name="discordUserId" value="<%= s.discord_user_id %>"><input type="hidden" name="planId" value="<%= s.plan_id %>"><button class="danger mini">Remove free access</button></form><% } %></td></tr><% }) %><% if(!subs.length){%><tr><td colspan="6" class="empty">Nobody has Premium yet.</td></tr><%}%></tbody></table></div></section>

<section class="section"><div class="section-head"><div><h2>Referral codes</h2><p class="muted">Attach a code to a member or partner and choose how you want to reward them.</p></div></div><div class="panel"><form method="post" action="/billing/referrals" class="form-grid">
<label><span>Referral code</span><small>Leave blank to generate one automatically.</small><input name="code" placeholder="RAZZER"></label>
<label><span>Who owns it?</span><small>Optional. Pick the member/partner who should get credit.</small><select name="ownerDiscordUserId"><option value="">No owner / tracking only</option><% members.forEach(m=>{ %><option value="<%= m.id %>"><%= m.name %> (@<%= m.username %>)</option><% }) %></select></label>
<label><span>Reward</span><select name="rewardType" id="reward-type"><option value="none">Track conversions only</option><option value="percent">Percentage commission</option><option value="fixed">Fixed cash amount</option><option value="days">Free Premium days</option></select></label>
<label><span>Reward amount</span><small>Example: 10 for 10%, £10, or 10 free days.</small><input name="rewardValue" type="number" step="0.01" min="0" value="0"></label>
<div class="wide"><button class="button">Create referral code</button></div></form></div><div class="table-wrap"><table><thead><tr><th>Code</th><th>Owner</th><th>Reward</th><th>Checkout starts</th><th>Paid conversions</th><th>Status</th></tr></thead><tbody><% refs.forEach(r=>{ const owner=members.find(m=>m.id===r.owner_discord_user_id); %><tr><td><strong><%= r.code %></strong></td><td><%= owner?`${owner.name} (@${owner.username})`:'Tracking only' %></td><td><%= r.reward_type==='none'?'None':`${r.reward_value} ${r.reward_type==='percent'?'%':r.reward_type==='fixed'?'fixed': 'days'}` %></td><td><%= r.clicks %></td><td><%= r.conversions %></td><td><form method="post" action="/billing/referrals/<%= r.id %>/toggle"><button class="ghost"><%= r.active?'Active':'Disabled' %></button></form></td></tr><% }) %><% if(!refs.length){%><tr><td colspan="6" class="empty">No referral codes yet.</td></tr><%}%></tbody></table></div></section>

<details class="section"><summary><strong>Technical status</strong> <span class="muted">Stripe webhook & event history</span></summary><div class="panel" style="margin-top:12px"><p><strong>Webhook:</strong> connected to this dashboard automatically.</p><p class="muted">You normally do not need to touch this section.</p></div><div class="table-wrap"><table><thead><tr><th>Event</th><th>Received</th><th>Processed</th><th>Error</th></tr></thead><tbody><% events.forEach(e=>{ %><tr><td><%= e.event_type %></td><td><%= new Date(e.created_at).toLocaleString('en-GB') %></td><td><%= e.processed_at?'Yes':'No' %></td><td><%= e.error||'—' %></td></tr><% }) %></tbody></table></div></details>
</main></body></html>
