<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Billing • FC27 Control</title><link rel="stylesheet" href="/style.css"></head><body>
<aside class="sidebar"><a class="brand" href="/dashboard"><span>FC27</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/trading">Trade calls</a><a href="/tickets">Tickets</a><a href="/social">Social feeds</a><a class="active" href="/billing">Premium & billing</a><a href="/moderation">Moderation</a><a href="/audit">Audit log</a></nav><div class="sidebar-user"><strong><%= user.username %></strong><small>Administrator</small></div><form method="post" action="/logout"><button class="ghost full">Log out</button></form></aside>
<main class="content">
<header><div><div class="eyebrow">PREMIUM MEMBERSHIPS</div><h1>Billing control</h1><p class="muted">Stripe subscriptions, Discord role entitlements, trials, referrals and complimentary access.</p></div><div class="status"><span class="dot"></span> <%= stripeReady?'Stripe configured':'Stripe setup required' %></div></header>
<section class="stats"><div class="stat"><span>Active access</span><strong><%= metrics.active %></strong></div><div class="stat"><span>Trials</span><strong><%= metrics.trialing %></strong></div><div class="stat"><span>Past due</span><strong><%= metrics.pastDue %></strong></div><div class="stat"><span>Cancelling</span><strong><%= metrics.cancelling %></strong></div></section>
<section class="section"><div class="section-head"><h2>Membership plans</h2></div><div class="panel"><form method="post" action="/billing/plans" class="form-grid"><label>Name<input name="name" required placeholder="FC27 Premium"></label><label>Slug<input name="slug" required placeholder="premium"></label><label>Stripe Price ID<input name="stripePriceId" required placeholder="price_..."></label><label>Discord role<select name="roleId" required><option value="">Select role</option><% roles.forEach(r=>{ %><option value="<%= r.id %>"><%= r.name %></option><% }) %></select></label><label>Trial days<input name="trialDays" type="number" min="0" value="0"></label><label>Sort order<input name="sortOrder" type="number" value="0"></label><label style="grid-column:1/-1">Description<input name="description" placeholder="Premium trade rooms, events and community perks"></label><button class="primary" type="submit">Save plan</button></form></div>
<div class="table-wrap"><table><thead><tr><th>Plan</th><th>Price ID</th><th>Role</th><th>Trial</th><th>Status</th><th></th></tr></thead><tbody><% plans.forEach(p=>{ const role=roles.find(r=>r.id===p.role_id); %><tr><td><strong><%= p.name %></strong><br><small>/<%= p.slug %></small></td><td><code><%= p.stripe_price_id %></code></td><td><%= role?.name||p.role_id %></td><td><%= p.trial_days %> days</td><td><span class="pill <%= p.active?'on':'off' %>"><%= p.active?'Active':'Disabled' %></span></td><td><form method="post" action="/billing/plans/<%= p.id %>/toggle"><button class="ghost"><%= p.active?'Disable':'Enable' %></button></form></td></tr><% }) %></tbody></table></div></section>
<section class="section"><div class="section-head"><h2>Grant complimentary access</h2></div><div class="panel"><form method="post" action="/billing/comp" class="form-grid"><label>Discord user ID<input name="discordUserId" required placeholder="123456789..."></label><label>Plan<select name="planId" required><% plans.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %></option><% }) %></select></label><label>Days<input name="days" type="number" min="1" value="30"></label><button class="primary" type="submit">Grant access</button></form></div></section>
<section class="section"><div class="section-head"><h2>Subscribers</h2></div><div class="table-wrap"><table><thead><tr><th>Discord user</th><th>Plan</th><th>Status</th><th>Period end</th><th>Source</th><th>Referral</th><th></th></tr></thead><tbody><% subs.forEach(s=>{ %><tr><td><code><%= s.discord_user_id %></code></td><td><%= s.plan_name||'—' %></td><td><span class="pill <%= ['active','trialing','comped','gifted','past_due'].includes(s.status)?'on':'off' %>"><%= s.status %></span></td><td><%= s.current_period_end?new Date(s.current_period_end).toLocaleDateString('en-GB'):'—' %><%= s.cancel_at_period_end?' • cancelling':'' %></td><td><%= s.source %></td><td><%= s.referral_code||'—' %></td><td><% if(s.plan_id){ %><form method="post" action="/billing/revoke"><input type="hidden" name="discordUserId" value="<%= s.discord_user_id %>"><input type="hidden" name="planId" value="<%= s.plan_id %>"><button class="ghost">Revoke manual access</button></form><% } %></td></tr><% }) %></tbody></table></div></section>
<section class="section"><div class="section-head"><h2>Referral codes</h2></div><div class="panel"><form method="post" action="/billing/referrals" class="form-grid"><label>Code<input name="code" placeholder="Leave blank to generate"></label><label>Owner Discord ID<input name="ownerDiscordUserId" placeholder="Optional"></label><label>Reward type<select name="rewardType"><option value="none">Track only</option><option value="percent">Percentage</option><option value="fixed">Fixed amount</option><option value="days">Free days</option></select></label><label>Reward value<input name="rewardValue" type="number" step="0.01" value="0"></label><button class="primary">Create referral</button></form></div><div class="table-wrap"><table><thead><tr><th>Code</th><th>Owner</th><th>Reward</th><th>Clicks</th><th>Conversions</th><th>Status</th></tr></thead><tbody><% refs.forEach(r=>{ %><tr><td><strong><%= r.code %></strong></td><td><code><%= r.owner_discord_user_id||'—' %></code></td><td><%= r.reward_type %> <%= r.reward_value %></td><td><%= r.clicks %></td><td><%= r.conversions %></td><td><form method="post" action="/billing/referrals/<%= r.id %>/toggle"><button class="ghost"><%= r.active?'Active':'Disabled' %></button></form></td></tr><% }) %></tbody></table></div></section>
<section class="section"><div class="section-head"><h2>Stripe webhook</h2></div><div class="panel"><p>Endpoint: <code><%= baseUrl %>/billing/webhook</code></p><p class="muted">Subscribe it to checkout/session, customer subscription, invoice payment failure and dispute events. Webhooks are signature-verified and idempotent.</p></div><div class="table-wrap"><table><thead><tr><th>Event</th><th>Received</th><th>Processed</th><th>Error</th></tr></thead><tbody><% events.forEach(e=>{ %><tr><td><%= e.event_type %></td><td><%= new Date(e.created_at).toLocaleString('en-GB') %></td><td><%= e.processed_at?'Yes':'No' %></td><td><%= e.error||'—' %></td></tr><% }) %></tbody></table></div></section>
</main></body></html>
