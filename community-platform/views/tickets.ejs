<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tickets • FC27 Control</title><link rel="stylesheet" href="/style.css"></head><body>
<aside class="sidebar"><a class="brand" href="/dashboard"><span>FC27</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/trading">Trade calls</a><a class="active" href="/tickets">Tickets</a><a href="/social">Social feeds</a><a href="/billing">Premium & billing</a><a href="/moderation">Moderation</a><a href="/audit">Audit log</a></nav></aside>
<main class="content"><header><div><div class="eyebrow">SUPPORT</div><h1>Tickets</h1><p class="muted">Open support, scam report, appeal and partnership tickets.</p></div><a class="button" href="/modules/tickets">Configure tickets</a></header>
<div class="hint-box" style="margin-bottom:16px">To change the ticket category, staff roles, log channel or ticket reasons, use <strong>Configure tickets</strong>. Everything is selectable from your Discord server.</div>
<div class="table-wrap"><table><thead><tr><th>Ticket</th><th>Member ID</th><th>Reason</th><th>Status</th><th>Opened</th><th></th></tr></thead><tbody>
<% tickets.forEach(t=>{ %><tr><td>#<%= t.id %></td><td><code><%= t.user_id %></code></td><td><strong><%= t.ticket_type %></strong></td><td><span class="pill <%= t.status==='OPEN'?'on':'off' %>"><%= t.status==='OPEN'?'Open':'Closed' %></span></td><td><%= new Date(t.created_at).toLocaleString('en-GB') %></td><td><% if(t.status==='OPEN'){ %><form method="post" action="/tickets/<%= t.id %>/close" onsubmit="return confirm('Close this ticket and delete its private Discord channel?')"><button class="danger">Close ticket</button></form><% } %></td></tr><% }) %>
<% if(!tickets.length){ %><tr><td colspan="6" class="empty">No tickets yet.</td></tr><% } %>
</tbody></table></div></main></body></html>
