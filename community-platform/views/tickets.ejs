<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tickets • FC27 Control</title><link rel="stylesheet" href="/style.css"></head><body><aside class="sidebar"><a class="brand" href="/dashboard"><span>FC27</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/setup">Setup wizard</a><a href="/members">Members</a><a href="/trading">Trade calls</a><a class="active" href="/tickets">Tickets</a><a href="/moderation">Moderation</a></nav></aside><main class="content"><header><div><div class="eyebrow">SUPPORT OPERATIONS</div><h1>Tickets</h1><p class="muted">Open → claimed → resolved, with staff notes, close reasons and saved transcripts.</p></div><a class="button" href="/modules/tickets">Configure tickets</a></header><div class="hint-box" style="margin-bottom:16px">Inside a ticket, staff can use <strong>/ticketstaff claim</strong>, <strong>/ticketstaff note</strong> and <strong>/ticketstaff close</strong>. Closing from Discord saves the last 100 messages as a transcript before deleting the channel.</div><div class="table-wrap"><table><thead><tr><th>Ticket</th><th>Member</th><th>Reason</th><th>Owner</th><th>Status</th><th>Opened</th><th>Resolution</th><th></th></tr></thead><tbody><% tickets.forEach(t=>{ %><tr><td>#<%= t.id %></td><td><a href="/members/<%= t.user_id %>"><code><%= t.user_id %></code></a></td><td><strong><%= t.ticket_type %></strong></td><td><%= t.claimed_by?`<@${t.claimed_by}>`:'Unclaimed' %></td><td><span class="pill <%= t.status==='OPEN'?'on':'off' %>"><%= t.status %></span></td><td><%= new Date(t.created_at).toLocaleString('en-GB') %></td><td><%= t.close_reason||'—' %><% if(t.transcript){ %><details><summary>Transcript</summary><pre class="transcript"><%= t.transcript %></pre></details><% } %></td><td><% if(t.status==='OPEN'){ %><form method="post" action="/tickets/<%= t.id %>/close" onsubmit="return confirm('Close this ticket and delete its private Discord channel?')"><button class="danger">Force close</button></form><% } %></td></tr><% }) %><% if(!tickets.length){ %><tr><td colspan="8" class="empty">No tickets yet.</td></tr><% } %></tbody></table></div></main></body></html>