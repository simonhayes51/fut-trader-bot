<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tickets • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"></head><body><aside class="sidebar"><a class="brand" href="/dashboard"><span>EAFC.Live</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/setup">Setup wizard</a><a href="/members">Members</a><a href="/trading">Trade calls</a><a class="active" href="/tickets">Tickets</a><a href="/moderation">Moderation</a></nav></aside><main class="content saas-page"><% const open=tickets.filter(t=>t.status==='OPEN').length; const claimed=tickets.filter(t=>t.status==='OPEN'&&t.claimed_by).length; %><section class="page-hero compact"><div><div class="eyebrow">COMMUNITY / SUPPORT</div><h1>Support operations</h1><p>Track member requests from open to resolved, with ownership, notes and transcripts.</p></div><div class="hero-actions"><a class="button" href="/modules/tickets">Configure tickets</a></div></section><section class="stats compact-stats"><div class="stat"><span>Total tickets</span><strong><%= tickets.length %></strong></div><div class="stat"><span>Open</span><strong><%= open %></strong></div><div class="stat"><span>Claimed</span><strong><%= claimed %></strong></div><div class="stat"><span>Unclaimed</span><strong><%= Math.max(0,open-claimed) %></strong></div></section><section class="panel slim-callout"><span class="ops-dot good"></span><div><strong>Discord and dashboard stay in sync</strong><small>Staff can claim, note and close tickets from Discord. Closing there preserves the last 100 messages as a transcript.</small></div></section><section class="section"><div class="section-head"><div><h2>Ticket ledger</h2><p>Newest requests first.</p></div><span class="table-count"><%= tickets.length %> records</span></div><div class="table-wrap saas-table"><table><thead><tr><th>Ticket</th><th>Member</th><th>Reason</th><th>Owner</th><th>Status</th><th>Opened</th><th>Resolution</th><th></th></tr></thead><tbody><% tickets.forEach(t=>{ %><tr><td>#<%= t.id %></td><td><a href="/members/<%= t.user_id %>"><code><%= t.user_id %></code></a></td><td><strong><%= t.ticket_type %></strong></td><td><%= t.claimed_by?`<@${t.claimed_by}>`:'Unclaimed' %></td><td><span class="pill <%= t.status==='OPEN'?'on':'off' %>"><%= t.status %></span></td><td><%= new Date(t.created_at).toLocaleString('en-GB') %></td><td><%= t.close_reason||'—' %><% if(t.transcript){ %><details><summary>Transcript</summary><pre class="transcript"><%= t.transcript %></pre></details><% } %></td><td><% if(t.status==='OPEN'){ %><form method="post" action="/tickets/<%= t.id %>/close" onsubmit="return confirm('Close this ticket and delete its private Discord channel?')"><button class="danger">Force close</button></form><% } %></td></tr><% }) %><% if(!tickets.length){ %><tr><td colspan="8" class="empty">No tickets yet.</td></tr><% } %></tbody></table></div></section></main></body></html>