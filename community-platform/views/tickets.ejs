<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tickets • FC27 Control</title><link rel="stylesheet" href="/style.css"></head><body>
<aside class="sidebar"><a class="brand" href="/dashboard"><span>FC27</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/trading">Trade calls</a><a class="active" href="/tickets">Tickets</a><a href="/social">Social feeds</a><a href="/moderation">Moderation</a><a href="/audit">Audit log</a></nav></aside>
<main class="content"><header><div><div class="eyebrow">SUPPORT OPERATIONS</div><h1>Tickets</h1><p class="muted">Support, scam reports, appeals, trading help and partnership enquiries.</p></div></header>
<div class="table-wrap"><table><thead><tr><th>ID</th><th>User</th><th>Type</th><th>Channel</th><th>Status</th><th>Opened</th><th></th></tr></thead><tbody>
<% tickets.forEach(t=>{ %><tr><td>#<%= t.id %></td><td><code><%= t.user_id %></code></td><td><strong><%= t.ticket_type %></strong></td><td><code><%= t.channel_id||'—' %></code></td><td><span class="pill <%= t.status==='OPEN'?'on':'off' %>"><%= t.status %></span></td><td><%= new Date(t.created_at).toLocaleString('en-GB') %></td><td><% if(t.status==='OPEN'){ %><form method="post" action="/tickets/<%= t.id %>/close" onsubmit="return confirm('Close and delete the Discord ticket channel?')"><button class="danger">Close</button></form><% } %></td></tr><% }) %>
</tbody></table></div></main></body></html>
