<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Audit log • FC27 Control</title><link rel="stylesheet" href="/style.css"></head><body>
<aside class="sidebar"><a class="brand" href="/dashboard"><span>FC27</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/trading">Trade calls</a><a href="/tickets">Tickets</a><a href="/social">Social feeds</a><a href="/moderation">Moderation</a><a class="active" href="/audit">Audit log</a></nav></aside>
<main class="content"><header><div><div class="eyebrow">CHANGE HISTORY</div><h1>Audit log</h1><p class="muted">Every dashboard and bot administration action is retained here.</p></div></header>
<div class="table-wrap"><table><thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Details</th></tr></thead><tbody>
<% rows.forEach(r=>{ %><tr><td><%= new Date(r.created_at).toLocaleString('en-GB') %></td><td><code><%= r.actor_id||'system' %></code></td><td><strong><%= r.action %></strong></td><td><code class="json"><%= JSON.stringify(r.details) %></code></td></tr><% }) %>
</tbody></table></div></main></body></html>
