<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Audit log • EAFC.Live Control</title><link rel="stylesheet" href="/style.css"></head><body>
<aside class="sidebar"><a class="brand" href="/dashboard"><span>EAFC.Live</span> Control</a><nav><a href="/dashboard">Overview</a><a href="/trading">Trade calls</a><a href="/tickets">Tickets</a><a href="/social">Social feeds</a><a href="/moderation">Moderation</a><a class="active" href="/audit">Audit log</a></nav></aside>
<main class="content saas-page"><section class="page-hero compact"><div><div class="eyebrow">SYSTEM / AUDIT</div><h1>Audit log</h1><p>Operational history for admin changes and automated actions.</p></div><div class="hero-actions"><span class="pill"><%= rows.length %> recent events</span></div></section>
<section class="panel"><div class="section-head"><div><h2>Recent activity</h2><p>Newest events first.</p></div></div><div class="audit-list"><% rows.forEach(r=>{ const action=String(r.action||'activity').replaceAll('.',' ').replaceAll('_',' '); %><div class="audit-row"><div class="audit-time"><strong><%= new Date(r.created_at).toLocaleDateString('en-GB',{day:'2-digit',month:'short'}) %></strong><small><%= new Date(r.created_at).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'}) %></small></div><div class="audit-main"><strong><%= action.charAt(0).toUpperCase()+action.slice(1) %></strong><small><%= r.actor_id ? `By ${String(r.actor_id).slice(0,6)}…${String(r.actor_id).slice(-4)}` : 'System' %></small></div><details class="audit-details"><summary>Details</summary><code class="json"><%= JSON.stringify(r.details,null,2) %></code></details></div><% }) %><% if(!rows.length){ %><div class="panel empty">No activity yet.</div><% } %></div></section></main></body></html>
