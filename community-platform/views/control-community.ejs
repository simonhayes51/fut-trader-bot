<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Community • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control"><section class="topbar"><div><div class="crumb">Discord Control / Community</div><h1>Community tools</h1><p>Make the server easier to join, navigate and use without turning the bot into a trading app.</p></div><div class="top-actions"><a class="btn-secondary" href="/discord">Native Discord tools</a></div></section><% if(saved){ %><div class="notice">Saved.</div><% } %><section class="feature-grid"><% [['welcome','Welcome & onboarding'],['role_menus','Roles & interests'],['suggestions','Suggestions'],['tickets','Tickets'],['starboard','Starboard']].forEach(x=>{ const st=settings.get(x[0]); %><a class="feature-card" href="/modules/<%= x[0] %>"><h3><%= x[1] %></h3><p>Configure this feature with Discord-native channels and roles.</p><div class="meta"><span class="pill <%= st?.enabled===false?'bad':'good' %>"><%= st?.enabled===false?'Off':'Active' %></span><span>Configure →</span></div></a><% }) %></section><section class="grid two" style="margin-top:11px"><div class="panel"><div class="panel-head"><div><h2>Custom responses</h2><p>Simple trigger → response automations.</p></div></div><form method="post" action="/control/community/responses" class="form-grid"><label>Trigger<input name="trigger" required placeholder="when does web app open"></label><label>Match<select name="matchMode"><option value="contains">Contains phrase</option><option value="exact">Exact message</option><option value="starts_with">Starts with</option></select></label><label class="wide">Response<textarea name="response" required rows="3" placeholder="The FC web app opens…"></textarea></label><label>Cooldown (seconds)<input name="cooldownSeconds" type="number" value="30" min="5"></label><label>Channels<select name="channels" multiple size="5"><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>"># <%= c.name %></option><% }) %></select></label><div class="wide"><button class="btn">Add response</button></div></form><div class="list" style="margin-top:10px"><% responses.forEach(r=>{ %><div class="row"><span class="row-main"><strong>“<%= r.trigger %>”</strong><small><%= r.match_mode.replaceAll('_',' ') %> • <%= r.cooldown_seconds %>s cooldown</small></span><span class="top-actions"><form method="post" action="/control/community/responses/<%= r.id %>/toggle"><button class="btn-secondary small"><%= r.enabled?'Pause':'Enable' %></button></form><form method="post" action="/control/community/responses/<%= r.id %>/delete"><button class="btn-danger small">Delete</button></form></span></div><% }) %></div></div><div class="panel"><div class="panel-head"><div><h2>Sticky messages</h2><p>Keep a reminder at the bottom of important channels.</p></div></div><form method="post" action="/control/community/stickies" class="form-grid"><label>Channel<select name="channelId" required><option value="">Choose channel</option><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>"># <%= c.name %></option><% }) %></select></label><label>Minimum refresh<input name="intervalSeconds" type="number" min="60" value="300"></label><label class="wide">Message<textarea name="content" rows="4" required placeholder="Please keep support questions in tickets…"></textarea></label><div class="wide"><button class="btn">Save sticky</button></div></form><div class="list" style="margin-top:10px"><% stickies.forEach(s=>{ const ch=channels.find(c=>c.id===s.channel_id); %><div class="row"><span class="row-main"><strong># <%= ch?.name||s.channel_id %></strong><small><%= s.content.slice(0,90) %><%= s.content.length>90?'…':'' %></small></span><span class="top-actions"><form method="post" action="/control/community/stickies/<%= s.id %>/toggle"><button class="btn-secondary small"><%= s.enabled?'Pause':'Enable' %></button></form><form method="post" action="/control/community/stickies/<%= s.id %>/delete"><button class="btn-danger small">Delete</button></form></span></div><% }) %></div></div></section></main></body></html>