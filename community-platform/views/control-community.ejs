<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Community tools • EAFC.Live</title><link rel="stylesheet" href="/control.css">
</head>
<body>
<aside class="sidebar"></aside>
<main class="control community-page">
  <header class="topbar community-heading">
    <div><div class="crumb">SERVER SETUP <span>›</span> COMMUNITY</div><h1>Make your server easier to use</h1><p>Pick what you want to set up. Each tool has one clear job and its own settings.</p></div>
    <a class="btn-secondary" href="/discord">See Discord setup</a>
  </header>
  <% if(saved){ %><div class="notice" role="status">Your changes have been saved.</div><% } %>

  <section class="community-guide" aria-label="How setup works">
    <div class="guide-title"><span class="guide-mark">i</span><div><strong>New to this page?</strong><p>Choose a job below, set it up, then save. The bot will handle it in Discord.</p></div></div>
    <div class="guide-steps"><span><b>1</b> Pick a tool</span><i>→</i><span><b>2</b> Choose a channel or roles</span><i>→</i><span><b>3</b> Save or publish</span></div>
  </section>

  <section class="community-tools" aria-labelledby="community-tools-title">
    <div class="community-section-heading"><div><span class="section-kicker">CHOOSE A TASK</span><h2 id="community-tools-title">What do you want members to do?</h2></div><span class="community-count">5 tools</span></div>
    <div class="community-tool-groups">
      <div class="community-tool-group">
        <h3><span class="task-number">01</span> Help new members</h3>
        <a class="community-task" href="/modules/welcome"><span class="task-icon">↗</span><span class="task-copy"><strong>Welcome & onboarding</strong><small>Post a welcome message and give new members a starter role.</small></span><span class="task-status <%= settings.get('welcome')?.status==='On'?'is-on':settings.get('welcome')?.status==='Off'?'is-off':'is-setup' %>"><i></i><%= settings.get('welcome')?.status||'Needs setup' %></span><b class="task-arrow">Open →</b></a>
        <a class="community-task" href="/modules/role_menus"><span class="task-icon">☷</span><span class="task-copy"><strong>Let members pick roles</strong><small>Build a menu so members can choose interests, games, or platforms.</small></span><span class="task-status <%= settings.get('role_menus')?.status==='On'?'is-on':settings.get('role_menus')?.status==='Off'?'is-off':'is-setup' %>"><i></i><%= settings.get('role_menus')?.status||'Needs setup' %></span><b class="task-arrow">Open →</b></a>
      </div>
      <div class="community-tool-group">
        <h3><span class="task-number">02</span> Collect ideas & help requests</h3>
        <a class="community-task" href="/modules/suggestions"><span class="task-icon">✎</span><span class="task-copy"><strong>Suggestions</strong><small>Give members one place to share ideas and vote on them.</small></span><span class="task-status <%= settings.get('suggestions')?.status==='On'?'is-on':settings.get('suggestions')?.status==='Off'?'is-off':'is-setup' %>"><i></i><%= settings.get('suggestions')?.status||'Needs setup' %></span><b class="task-arrow">Open →</b></a>
        <a class="community-task" href="/modules/tickets"><span class="task-icon">▤</span><span class="task-copy"><strong>Support tickets</strong><small>Let members privately contact staff for help, reports, or applications.</small></span><span class="task-status <%= settings.get('tickets')?.status==='On'?'is-on':settings.get('tickets')?.status==='Off'?'is-off':'is-setup' %>"><i></i><%= settings.get('tickets')?.status||'Needs setup' %></span><b class="task-arrow">Open →</b></a>
      </div>
      <div class="community-tool-group community-tool-group-wide">
        <h3><span class="task-number">03</span> Highlight great posts</h3>
        <a class="community-task" href="/modules/starboard"><span class="task-icon">☆</span><span class="task-copy"><strong>Starboard</strong><small>Show popular messages in a dedicated channel after they get enough reactions.</small></span><span class="task-status <%= settings.get('starboard')?.status==='On'?'is-on':settings.get('starboard')?.status==='Off'?'is-off':'is-setup' %>"><i></i><%= settings.get('starboard')?.status||'Needs setup' %></span><b class="task-arrow">Open →</b></a>
      </div>
    </div>
  </section>

  <section class="community-helpers" aria-labelledby="chat-helper-title">
    <div class="community-section-heading"><div><span class="section-kicker">OPTIONAL CHAT HELPERS</span><h2 id="chat-helper-title">Automate repeat messages</h2><p>Use these only if you want the bot to reply or repost a reminder in chat.</p></div></div>
    <div class="helper-grid">
      <article class="helper-card">
        <div class="helper-card-heading"><span class="helper-icon">↩</span><div><h3>Automatic replies</h3><p>Reply when someone types a phrase, like “how do I join?”</p></div></div>
        <div class="helper-list">
          <% if(responses.length){ responses.forEach(r=>{ %>
            <div class="helper-row"><span class="helper-row-copy"><strong>“<%= r.trigger %>”</strong><small><%= r.match_mode.replaceAll('_',' ') %> · <%= r.cooldown_seconds %> second cooldown</small></span><span class="helper-row-actions"><form method="post" action="/control/community/responses/<%= r.id %>/toggle"><button class="btn-secondary small"><%= r.enabled?'Pause':'Turn on' %></button></form><form method="post" action="/control/community/responses/<%= r.id %>/delete"><button class="btn-secondary small" aria-label="Delete reply for <%= r.trigger %>">Delete</button></form></span></div>
          <% }) }else{ %><p class="helper-empty">No automatic replies yet.</p><% } %>
        </div>
        <details class="helper-create"><summary><span class="plus">+</span> Add an automatic reply</summary>
          <form method="post" action="/control/community/responses" class="form-grid helper-form">
            <label>When someone types<input name="trigger" required placeholder="how do I join"></label>
            <label>Match it<select name="matchMode"><option value="contains">If their message contains this</option><option value="exact">Only if it matches exactly</option><option value="starts_with">If their message starts with this</option></select></label>
            <label class="wide">The bot should reply<textarea name="response" required rows="3" placeholder="Open #welcome and follow the steps there."></textarea></label>
            <label>Wait before replying again<input name="cooldownSeconds" type="number" value="30" min="5"><small>Seconds between replies to the same person.</small></label>
            <label>Where should it work?<select name="channels" multiple size="4"><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>"># <%= c.name %></option><% }) %></select><small>Leave blank to allow every text channel.</small></label>
            <div class="wide"><button class="btn">Save automatic reply</button></div>
          </form>
        </details>
      </article>

      <article class="helper-card">
        <div class="helper-card-heading"><span class="helper-icon">↻</span><div><h3>Channel reminders</h3><p>Keep a reminder visible near the bottom of a channel.</p></div></div>
        <div class="helper-list">
          <% if(stickies.length){ stickies.forEach(s=>{ const ch=channels.find(c=>c.id===s.channel_id); %>
            <div class="helper-row"><span class="helper-row-copy"><strong># <%= ch?.name||s.channel_id %></strong><small><%= s.content.slice(0,90) %><%= s.content.length>90?'…':'' %></small></span><span class="helper-row-actions"><form method="post" action="/control/community/stickies/<%= s.id %>/toggle"><button class="btn-secondary small"><%= s.enabled?'Pause':'Turn on' %></button></form><form method="post" action="/control/community/stickies/<%= s.id %>/delete"><button class="btn-secondary small" aria-label="Delete reminder in <%= ch?.name||'channel' %>">Delete</button></form></span></div>
          <% }) }else{ %><p class="helper-empty">No channel reminders yet.</p><% } %>
        </div>
        <details class="helper-create"><summary><span class="plus">+</span> Add a channel reminder</summary>
          <form method="post" action="/control/community/stickies" class="form-grid helper-form">
            <label>Which channel?<select name="channelId" required><option value="">Choose a text channel</option><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>"># <%= c.name %></option><% }) %></select></label>
            <label>Refresh no more than every<input name="intervalSeconds" type="number" min="60" value="300"><small>Seconds. This avoids reposting too often.</small></label>
            <label class="wide">Reminder text<textarea name="content" rows="4" required placeholder="Need help? Open a ticket using the button in #support."></textarea></label>
            <div class="wide"><button class="btn">Save channel reminder</button></div>
          </form>
        </details>
      </article>
    </div>
  </section>
</main>
</body>
</html>
