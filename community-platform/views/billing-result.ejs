<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %> · FC27 Premium</title>
  <link rel="stylesheet" href="/style.css" />
  <style>
    body{min-height:100vh;display:grid;place-items:center;margin:0;background:#090b12;color:#f7f8fb;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    .result-card{width:min(560px,calc(100vw - 40px));background:linear-gradient(180deg,#171b28,#10131d);border:1px solid #2b3143;border-radius:24px;padding:38px;box-shadow:0 24px 80px rgba(0,0,0,.45);text-align:center}
    .result-icon{width:72px;height:72px;margin:0 auto 20px;display:grid;place-items:center;border-radius:22px;background:<%= tone === 'success' ? 'rgba(66,211,146,.14)' : tone === 'warning' ? 'rgba(255,184,76,.14)' : 'rgba(93,119,255,.14)' %>;font-size:34px}
    .result-card h1{font-size:30px;margin:0 0 12px}.result-card p{color:#aeb6ca;font-size:16px;line-height:1.6;margin:0 auto 24px;max-width:460px}
    .result-pill{display:inline-flex;gap:8px;align-items:center;padding:9px 14px;border-radius:999px;background:#202637;color:#dfe5f5;font-size:13px;margin-bottom:24px}
    .result-actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}.result-actions a{display:inline-block;padding:12px 18px;border-radius:12px;text-decoration:none;font-weight:700}.primary{background:#5865f2;color:white}.secondary{background:#23293a;color:#e9edf8;border:1px solid #343b52}
    .brand{font-weight:800;letter-spacing:.08em;color:#7d8cff;font-size:12px;margin-bottom:14px}
  </style>
</head>
<body>
  <main class="result-card">
    <div class="brand">EAFC LIVE · FC27 PREMIUM</div>
    <div class="result-icon"><%= icon %></div>
    <div class="result-pill"><%= badge %></div>
    <h1><%= title %></h1>
    <p><%= message %></p>
    <div class="result-actions">
      <a class="primary" href="https://discord.com/app">Return to Discord</a>
      <% if (showDashboard) { %><a class="secondary" href="/billing">Billing dashboard</a><% } %>
    </div>
  </main>
</body>
</html>
