<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Rewards • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control"><section class="topbar"><div><div class="crumb">Discord Control / Rewards</div><h1>Rewards & drops</h1><p>Cosmetic roles, profile customisation, limited stock, seasonal items, flash drops and daily check-in panels.</p></div></section><% if(saved){ %><div class="notice">Saved or published.</div><% } %>
<section class="grid two"><div class="panel"><div class="panel-head"><div><h2>Store item</h2><p>Create or update a limited/seasonal reward.</p></div></div><form method="post" action="/control/rewards/store" class="form-grid"><label>Item key<input name="itemKey" placeholder="blue-name-role"></label><label>Name<input name="name" required></label><label class="wide">Description<input name="description"></label><label>Emoji<input name="emoji" value="🎁"></label><label>Cost (Live Coins)<input name="costCoins" type="number" min="0" required></label><label>Type<select name="fulfillmentType"><option value="role">Discord role</option><option value="custom">Profile cosmetic</option><option value="badge">Badge</option><option value="discord_premium">Premium</option></select></label><label>Role<select name="roleId"><option value="">None</option><% roles.forEach(r=>{ %><option value="<%= r.id %>">@<%= r.name %></option><% }) %></select></label><label>Duration days<input name="durationDays" type="number" min="1"></label><label>Stock<input name="stock" type="number" min="0" placeholder="Unlimited"></label><label>Per-user limit<input name="perUserLimit" type="number" min="1"></label><label>Available from<input name="availableFrom" type="datetime-local"></label><label>Available until<input name="availableUntil" type="datetime-local"></label><label><span>Current-season only</span><input name="seasonal" type="checkbox"></label><input type="hidden" name="seasonId" value="<%= season?.id||'' %>"><label>Cosmetic type<select name="cosmeticKey"><option value="title">Profile title</option><option value="accent">Profile accent</option></select></label><label>Cosmetic value<input name="cosmeticValue" placeholder="Founder / #27D7E8"></label><label class="wide">Badge key <small>Used when Type = Badge.</small><input name="badgeKey" placeholder="founder_2026"></label><div class="wide"><button class="btn">Save store item</button></div></form></div>
<div class="panel"><div class="panel-head"><div><h2>Live store</h2><p><%= items.filter(i=>i.active).length %> active rewards.</p></div></div><div class="list"><% items.forEach(i=>{ %><div class="row"><span class="row-main"><strong><%= i.emoji %> <%= i.name %></strong><small><%= Number(i.cost_coins).toLocaleString() %> coins • <%= i.stock===null?'unlimited':i.stock+' left' %><%= i.season_id?' • seasonal':'' %></small></span><form method="post" action="/control/rewards/store/<%= i.id %>/toggle"><button class="btn-secondary small"><%= i.active?'Live':'Hidden' %></button></form></div><% }) %></div></div></section>
<section class="grid two" style="margin-top:11px"><div class="panel"><div class="panel-head"><div><h2>Flash drop</h2><p>Limited-time claim button for XP/coins.</p></div></div><form method="post" action="/control/rewards/drop" class="form-grid"><label>Channel<select name="channelId" required><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>"># <%= c.name %></option><% }) %></select></label><label>Name<input name="name" value="Live Drop"></label><label>Live Coins<input name="coins" type="number" min="0" value="100"></label><label>XP<input name="xp" type="number" min="0" value="0"></label><label>Duration (minutes)<input name="durationMinutes" type="number" min="1" value="15"></label><label>Max claims<input name="maxClaims" type="number" min="1" placeholder="Unlimited"></label><div class="wide"><button class="btn">Publish drop</button></div></form><div class="list" style="margin-top:8px"><% drops.slice(0,12).forEach(d=>{ %><div class="row"><span class="row-main"><strong><%= d.name %></strong><small><%= d.claims %> claims • ends <%= new Date(d.ends_at).toLocaleString('en-GB') %></small></span><span class="pill <%= d.status==='LIVE'?'good':'' %>"><%= d.status %></span></div><% }) %></div></div>
<div class="panel"><div class="panel-head"><div><h2>Daily check-in panel</h2><p>Publish a permanent visual claim button into Discord.</p></div></div><form method="post" action="/control/rewards/daily-panel"><label>Channel<select name="channelId" required><% channels.filter(c=>c.type!==4).forEach(c=>{ %><option value="<%= c.id %>"># <%= c.name %></option><% }) %></select></label><button class="btn" style="margin-top:8px">Publish daily panel</button></form><div class="row"><span class="row-main"><strong>Current season</strong><small><%= season?.name||'No active season' %></small></span><span class="pill good">Seasonal catalogue supported</span></div></div></section>
</main></body></html>