<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Security • EAFC.Live</title><link rel="stylesheet" href="/control.css"></head><body><aside class="sidebar"></aside><main class="control">
<section class="topbar"><div><div class="crumb">Discord Control / Security</div><h1>Security & server health</h1><p>Anti-alt, anti-raid, anti-nuke, permission diagnostics and safe one-click repairs.</p></div><div class="top-actions"><form method="post" action="/control/security/rescan"><button class="btn">Run health scan</button></form></div></section><% if(saved){ %><div class="notice">Security settings saved.</div><% } %>
<section class="grid metrics"><div class="metric"><span>Health score</span><strong><%= score %>%</strong></div><div class="metric"><span>Active findings</span><strong><%= findings.length %></strong></div><div class="metric"><span>Security events</span><strong><%= events.length %></strong></div></section>
<section class="grid two"><div class="panel"><div class="panel-head"><div><h2>Protection policy</h2><p>Automatic guardrails for new members and destructive staff actions.</p></div></div><form method="post" action="/control/security" class="form-grid">
<label><span>Anti-alt</span><input type="checkbox" name="antiAlt" <%= feature.config.antiAlt!==false?'checked':'' %>></label><label>Minimum account age (hours)<input name="minAccountAgeHours" type="number" min="0" value="<%= feature.config.minAccountAgeHours??24 %>"></label>
<label><span>Anti-raid</span><input type="checkbox" name="antiRaid" <%= feature.config.antiRaid!==false?'checked':'' %>></label><label>Joins/minute threshold<input name="joinsPerMinute" type="number" min="2" value="<%= feature.config.joinsPerMinute??8 %>"></label>
<label><span>Quarantine during raid</span><input type="checkbox" name="quarantineOnRaid" <%= feature.config.quarantineOnRaid!==false?'checked':'' %>></label><label><span>Anti-nuke</span><input type="checkbox" name="antiNuke" <%= feature.config.antiNuke!==false?'checked':'' %>></label>
<label>Action window (seconds)<input name="actionWindowSeconds" type="number" min="10" value="<%= feature.config.actionWindowSeconds??60 %>"></label><label>Destructive action limit<input name="maxDestructiveActions" type="number" min="1" value="<%= feature.config.maxDestructiveActions??4 %>"></label>
<label class="wide">Trusted roles<select name="trustedRoleIds" multiple size="5"><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= (feature.config.trustedRoleIds||[]).includes(r.id)?'selected':'' %>>@<%= r.name %></option><% }) %></select></label><div class="wide"><button class="btn">Save protection</button></div></form></div>
<div class="panel"><div class="panel-head"><div><h2>Health findings</h2><p>Configuration and permission problems detected automatically.</p></div></div><div class="list"><% findings.forEach(f=>{ %><div class="row"><span class="row-main"><strong><%= f.title %></strong><small><%= f.detail %></small></span><span class="top-actions"><span class="pill <%= f.severity==='critical'?'bad':f.severity==='warning'?'warn':'good' %>"><%= f.severity %></span><% if(f.fix_type){ %><form method="post" action="/control/security/fix/<%= f.id %>"><button class="btn-secondary small">Fix</button></form><% } %></span></div><% }) %><% if(!findings.length){ %><div class="empty">No active findings. Nice.</div><% } %></div></div></section>
<section class="grid two" style="margin-top:11px"><div class="panel"><div class="panel-head"><div><h2>Permission inspector</h2><p>Choose a member and channel to see the effective permission path.</p></div></div><form method="get" action="/control/security" class="form-grid"><label>Member<select name="memberId" required><% members.forEach(m=>{ %><option value="<%= m.id %>" <%= String(requestedMember||'')===m.id?'selected':'' %>><%= m.name %></option><% }) %></select></label><label>Channel<select name="channelId" required><% channels.forEach(c=>{ %><option value="<%= c.id %>"># <%= c.name %></option><% }) %></select></label><div class="wide"><button class="btn-secondary">Inspect</button></div></form><% if(inspector){ %><div style="margin-top:12px"><% if(inspector.error){ %><div class="pill bad"><%= inspector.error %></div><% }else{ %><div class="row"><span class="row-main"><strong><%= inspector.member.name %> in #<%= inspector.channel.name %></strong><small><%= inspector.effective.length %> effective permissions</small></span></div><details><summary>Effective permissions</summary><div class="details-body"><%= inspector.effective.join(', ') %></div></details><% inspector.roles.forEach(r=>{ if(r.allow.length||r.deny.length){ %><details><summary>@<%= r.name %></summary><div class="details-body">Allow: <%= r.allow.join(', ')||'—' %><br>Deny: <%= r.deny.join(', ')||'—' %></div></details><% } }) %><% } %></div><% } %></div>
<div class="panel"><div class="panel-head"><div><h2>Recent security activity</h2><p>Latest anti-alt, raid and destructive-action detections.</p></div></div><div class="list"><% events.slice(0,20).forEach(e=>{ %><div class="row"><span class="row-main"><strong><%= e.event_type.replaceAll('_',' ') %></strong><small><%= new Date(e.created_at).toLocaleString('en-GB') %> • <%= e.action_taken||'logged' %></small></span><span class="pill <%= e.severity==='critical'?'bad':'warn' %>"><%= e.severity %></span></div><% }) %></div></div></section>
</main></body></html>